<!DOCTYPE html>
<html id="html" lang="{{ locale() }}" data-bs-theme="{{ theme }}">
<head>
    {% include 'partials/head_assets.twig' %}
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <link rel="canonical" href="{{ applicationUrl }}{{ canonicalPath }}{{ canonicalExtra }}" />

    <title>{% apply trim %}{% block title %}Pathary{% endblock %}{% endapply %} | {{ applicationName }}</title>

    <meta property="og:title" content="{{ block('title')|trim }} | {{ applicationName }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ applicationUrl }}{{ canonicalPath }}{{ canonicalExtra }}" />
    <meta property="og:image" content="{% block ogImage %}{{ applicationUrl }}/images/pathary-logo-512x512.png{% endblock %}" />
    <meta property="og:description" content="{{ t('meta.description') }}" />

    <link rel="stylesheet" href="{{ applicationUrl }}/css/datepicker-1.2.0.min.css">
    <link rel="stylesheet" href="{{ applicationUrl }}/css/global.css?v={{ assetVersion }}">
{% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
<script>0</script>

<input value="{{ dateFormatJavascript }}" id="dateFormatJavascript" hidden>
<input value="{{ dateFormatPhp }}" id="dateFormatPhp" hidden>
<input type="hidden" id="currentUserName" value="{{ currentUserName }}">

<div class="flex-grow-1 pb-4">
{% block body %}{% endblock %}
</div>

{% if showFooter is not defined or showFooter %}
{% include 'partials/footer.twig' %}
{% endif %}

{# UI strings for app.js, read through appText(key). #}
<script type="application/json" id="appI18n">{{ {
    add_movie: t('app_js.add_movie'),
    close: t('common.close'),
    generic_error: t('app_js.generic_error'),
    locations_load_failed: t('app_js.locations_load_failed'),
    on_watchlist: t('app_js.on_watchlist'),
    play_add_failed: t('app_js.play_add_failed'),
    poster_for: t('app_js.poster_for'),
    search_timeout: t('app_js.search_timeout'),
    watched: t('app_js.watched'),
    watchlist_add_failed: t('app_js.watchlist_add_failed'),
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
<script>window.APPLICATION_URL = "{{ applicationUrl  }}";</script>
<script src="{{ applicationUrl }}/js/jquery-3.3.1.js"></script>
<script src="{{ applicationUrl }}/js/bootstrap.bundle.min.js"></script>
<script src="{{ applicationUrl }}/js/datepicker-full-1.2.0.min.js"></script>
<script src="{{ applicationUrl }}/js/app.js?v={{ assetVersion }}"></script>

{% block scripts %}{% endblock %}
</body>
</html>
