<!DOCTYPE html>
<html lang="{{ locale() }}">
<head>
    {% include 'partials/head_assets.twig' %}
    <title>{% block title %}{{ applicationName ?? 'Pathary' }}{% endblock %}</title>
    {# SEO: pages override description, og_type and og_image; canonical drops the slug suffix. #}
    <meta name="description" content="{% block description %}{{ t('meta.description') }}{% endblock %}">
    <link rel="canonical" href="{{ applicationUrl }}{{ canonicalPath }}">
    <meta property="og:site_name" content="{{ applicationName ?? 'Pathary' }}">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:url" content="{{ applicationUrl }}{{ canonicalPath }}">
    <meta property="og:image" content="{% block og_image %}{{ applicationUrl }}/images/pathary-logo-512x512.png{% endblock %}">
    <meta name="twitter:card" content="summary">
    <link rel="stylesheet" href="{{ applicationUrl }}/css/global.css?v={{ assetVersion }}">

    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    {% if loggedIn %}
        {% include 'partials/navbar_app.twig' %}
    {% else %}
        {% include 'partials/navbar_public.twig' %}
    {% endif %}

    <main class="flex-grow-1 pb-4">
        {% block body %}{% endblock %}
    </main>

    {% block footer %}{% endblock %}

    {% if showFooter is not defined or showFooter %}
    {% include 'partials/footer.twig' %}
    {% endif %}

    <!-- Bootstrap JS (Local) -->
    <script src="{{ applicationUrl }}/js/bootstrap.bundle.min.js"></script>

    <!-- Theme Toggle JS -->
    <script src="{{ applicationUrl }}/assets/js/theme.js?v={{ assetVersion }}"></script>

    {% block scripts %}{% endblock %}
</body>
</html>
