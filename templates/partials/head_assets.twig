{# Shared <head> for every layout: theme bootstrap, fonts, icons, PWA metadata, design tokens. #}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101216">
<link rel="icon" href="{{ applicationUrl }}/images/favicon.ico" type="image/x-icon">
<link rel="apple-touch-icon" href="{{ applicationUrl }}/images/pathary-logo-180x180.png">
<link rel="manifest" href="{{ applicationUrl }}/manifest.json">

<!-- Apply the saved theme before first paint; dark is the default. -->
<script>
    document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'dark');
</script>

<link rel="preload" href="{{ applicationUrl }}/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ applicationUrl }}/css/bootstrap.min.css">
<link rel="stylesheet" href="{{ applicationUrl }}/css/bootstrap-icons-1.11.3.min.css">
<link rel="stylesheet" href="{{ applicationUrl }}/assets/css/theme.css?v={{ assetVersion }}">
