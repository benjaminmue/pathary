{% extends loggedIn ? 'layouts/app_base.twig' : 'layouts/public_base.twig' %}

{% block title %}{{ t('faq.title') }}{% endblock %}

{% block stylesheets %}
<style>
    /* --pds-* tokens live in public/assets/css/theme.css. */


    .faq-wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 40px 24px 72px;
        box-sizing: border-box;
    }

    .faq-head {
        margin-bottom: 28px;
    }

    .faq-head h1 {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .faq-head p {
        color: var(--pds-muted);
        font-size: 15px;
        margin: 8px 0 0;
    }

    .faq-card {
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r);
        overflow: hidden;
        scroll-margin-top: 90px;
    }

    .faq-card + .faq-card {
        margin-top: var(--pds-s-md);
    }

    .faq-card__head {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 24px;
        border-bottom: 1px solid var(--pds-hair);
    }

    .faq-card__head .faq-emoji {
        font-size: 22px;
        line-height: 1;
        flex-shrink: 0;
    }

    .faq-card__head h2 {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .faq-card__body {
        padding: 22px 24px 8px;
    }

    .faq-card__body > p {
        color: var(--pds-muted);
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 8px;
    }

    /* Popcorn scale */
    .scale {
        margin-top: 6px;
    }

    .scale-row {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding: 16px 0;
        border-bottom: 1px solid var(--pds-hair);
    }

    .scale-row:last-child {
        border-bottom: 0;
    }

    .scale-pops {
        flex-shrink: 0;
        width: 132px;
        font-size: 15px;
        line-height: 1.25;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .scale-pops .off {
        filter: grayscale(1);
        opacity: .28;
    }

    .scale-name {
        font-weight: 700;
        font-size: 15px;
    }

    .scale-name .scale-num {
        font-family: var(--pds-font-mono);
        color: var(--pds-gold-text);
        margin-right: 8px;
    }

    .scale-desc {
        color: var(--pds-muted);
        font-size: 14px;
        line-height: 1.5;
        margin-top: 3px;
    }

    @media (max-width: 520px) {
        .scale-row { flex-direction: column; gap: 6px; }
        .scale-pops { width: auto; }
    }
</style>
{% endblock %}

{% block body %}
<div class="pds-root" style="background: var(--pds-bg); min-height: 100%;">
    <div class="faq-wrap">
        <div class="faq-head">
            <h1>{{ t('faq.title') }}</h1>
            <p>{{ t('faq.subtitle') }}</p>
        </div>

        <section class="faq-card" id="popcorn">
            <div class="faq-card__head">
                <span class="faq-emoji">🍿</span>
                <h2>{{ t('faq.popcorn_question') }}</h2>
            </div>
            <div class="faq-card__body">
                <p>{{ t('faq.popcorn_intro') }}</p>
                <div class="scale">
                    {% for i in 1..7 %}
                        <div class="scale-row">
                            <div class="scale-pops" aria-hidden="true">
                                {%- for j in 1..7 -%}
                                    <span class="{{ j > i ? 'off' : '' }}">🍿</span>
                                {%- endfor -%}
                            </div>
                            <div>
                                <div class="scale-name"><span class="scale-num">{{ i }}</span>{{ t('faq.popcorn_' ~ i ~ '_name') }}</div>
                                <div class="scale-desc">{{ t('faq.popcorn_' ~ i ~ '_desc') }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}
