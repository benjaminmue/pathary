{% extends 'layouts/public_base.twig' %}

{% block title %}{{ t('home.page_title') }}{% endblock %}

{% block body %}
<div class="showcase-home">

    {# 2. Hero #}
    <section class="sc-hero">
        <div class="sc-hero__kicker">{{ t('home.kicker') }}</div>
        <h1 class="sc-hero__title">{{ t('home.hero_title_1') }}<br>{{ t('home.hero_title_2') }}</h1>
        <p class="sc-hero__sub">{{ t('home.hero_sub') }}</p>
        <div class="sc-pop" role="img" aria-label="{{ t('home.popcorn_aria') }}">
            {% for i in 1..7 %}<span class="k{{ i > 5 ? ' off' }}" aria-hidden="true">🍿</span>{% endfor %}
        </div>
        {% if loggedIn %}
        <div class="sc-hero__actions">
            <a href="{{ applicationUrl }}/movies" class="sc-btn sc-btn--ghost">{{ t('home.browse_library') }}</a>
        </div>
        {% endif %}
    </section>

    {# 3. Poster-Carousel - 20 neueste, nur Poster, einmal dupliziert für nahtlose Schleife #}
    {% if movies|length > 0 %}
    <div class="sc-carousel">
        <div class="sc-carousel__track">
            {% for pass in 1..2 %}
                {% for item in movies %}
                    {% set movie = item.movie %}
                    <a href="{{ applicationUrl }}/movie/{{ movie.movie_id }}" class="sc-carousel__item"{{ pass == 2 ? ' aria-hidden="true" tabindex="-1"' }}>
                        {% if movie.poster_path %}
                            <img src="{{ movie.poster_path }}" alt="{{ pass == 1 ? movie.title : '' }}" loading="lazy">
                        {% endif %}
                    </a>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# 4. Statistik-Band #}
    {% if globalStats.total_movies > 0 %}
    <div class="sc-statsband">
        <div class="sc-statsband__inner">
            <div class="sc-stat">
                <div class="sc-stat__value">{{ globalStats.total_movies }}</div>
                <div class="sc-stat__label">{{ t('home.stat_movies') }}</div>
            </div>
            <div class="sc-stat">
                <div class="sc-stat__value">{{ globalStats.total_ratings }}</div>
                <div class="sc-stat__label">{{ t('home.stat_ratings') }}</div>
            </div>
            {% if globalStats.avg_rating %}
            <div class="sc-stat">
                <div class="sc-stat__value">{{ globalStats.avg_rating }} <span>🍿</span></div>
                <div class="sc-stat__label">{{ t('home.stat_average') }}</div>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    <div class="sc-main">

        {# 5. Was wir zuletzt geschaut haben - 12 neueste #}
        {% if movies|length > 0 %}
        <div class="sc-heading">
            <h2>{{ t('home.recent_heading') }}</h2>
            <p>{{ t('home.recent_sub') }}</p>
        </div>
        <div class="sc-wall">
            {% for item in movies|slice(0, 12) %}
                {% set movie = item.movie %}
                {% set stats = item.stats %}
                <a href="{{ applicationUrl }}/movie/{{ movie.movie_id }}" class="sc-film">
                    <div class="sc-film__poster">
                        {% if movie.poster_path %}
                            <img src="{{ movie.poster_path }}" alt="{{ movie.title }}" loading="lazy">
                        {% else %}
                            <div class="sc-film__placeholder">{{ movie.title }}</div>
                        {% endif %}
                    </div>
                    <div class="sc-film__cap">
                        <div class="sc-film__title" title="{{ movie.title }}">{{ movie.title }}</div>
                        <div class="sc-film__meta">
                            <span class="sc-film__year">{{ movie.release_date ? movie.release_date|slice(0, 4) }}</span>
                            {% if stats.rating_count > 0 %}
                                <span class="sc-film__rating">🍿 {{ stats.avg_popcorn|number_format(1) }}</span>
                            {% endif %}
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
        {% endif %}

        {# 6. Direkt aus dem Gruppenchat #}
        {% if globalStats.random_comments|length > 0 %}
        <div class="sc-section">
            <div class="sc-heading">
                <h2>{{ t('home.comments_heading') }}</h2>
                <p>{{ t('home.comments_sub') }}</p>
            </div>
            <div class="sc-comments">
                {% for comment in globalStats.random_comments %}
                    <div class="sc-cmt">
                        <div class="sc-cmt__top">
                            <span class="sc-cmt__user">{{ comment.user_name }}</span>
                            <span class="sc-cmt__score">🍿 {{ comment.rating_popcorn }} <small>/ 7</small></span>
                        </div>
                        <div class="sc-cmt__quote">“{{ comment.comment }}”</div>
                        <a href="{{ applicationUrl }}/movie/{{ comment.movie_id }}" class="sc-cmt__film">- {{ comment.movie_title }}</a>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# 7. Ruhmeshalle - und Schandhalle #}
        {% if globalStats.highest_rated|length > 0 or globalStats.lowest_rated|length > 0 %}
        <div class="sc-section">
            <div class="sc-heading">
                <h2>{{ t('home.hall_heading') }}</h2>
            </div>
            <div class="sc-panels">
                <div class="sc-panel">
                    <div class="sc-panel__title">👍 {{ t('home.hall_best') }}</div>
                    {% for movie in globalStats.highest_rated %}
                        <a href="{{ applicationUrl }}/movie/{{ movie.movie_id }}" class="sc-rank">
                            <span class="sc-rank__thumb">
                                {% if movie.poster_path %}<img src="{{ movie.poster_path }}" alt="{{ movie.title }}" loading="lazy">{% endif %}
                            </span>
                            <span class="sc-rank__body">
                                <span class="sc-rank__title" title="{{ movie.title }}">{{ movie.title }}</span>
                                <span class="sc-rank__sub">{{ movie.rating_count }} {{ movie.rating_count != 1 ? t('home.ratings_plural') : t('home.rating_singular') }}</span>
                            </span>
                            <span class="sc-rank__score">🍿 {{ movie.avg_popcorn|number_format(1) }} <small>/ 7</small></span>
                        </a>
                    {% endfor %}
                </div>
                <div class="sc-panel">
                    <div class="sc-panel__title">👎 {{ t('home.hall_worst') }}</div>
                    {% for movie in globalStats.lowest_rated %}
                        <a href="{{ applicationUrl }}/movie/{{ movie.movie_id }}" class="sc-rank">
                            <span class="sc-rank__thumb">
                                {% if movie.poster_path %}<img src="{{ movie.poster_path }}" alt="{{ movie.title }}" loading="lazy">{% endif %}
                            </span>
                            <span class="sc-rank__body">
                                <span class="sc-rank__title" title="{{ movie.title }}">{{ movie.title }}</span>
                                <span class="sc-rank__sub">{{ movie.rating_count }} {{ movie.rating_count != 1 ? t('home.ratings_plural') : t('home.rating_singular') }}</span>
                            </span>
                            <span class="sc-rank__score">🍿 {{ movie.avg_popcorn|number_format(1) }} <small>/ 7</small></span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}

    </div>

    {# 8. Footer-CTA #}
    <div class="sc-cta">
        <div class="sc-cta__title">{{ t('home.cta_title') }} 🍿</div>
        {% if loggedIn %}
        <div>
            <a href="{{ applicationUrl }}/movies" class="sc-btn sc-btn--primary">{{ t('home.browse_library') }}</a>
        </div>
        {% endif %}
        <div class="sc-cta__links">
            <a href="https://github.com/benjaminmue/pathary" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://benjaminmue.github.io/pathary/" target="_blank" rel="noopener noreferrer">Wiki</a>
            <a href="https://github.com/benjaminmue/pathary/issues/new" target="_blank" rel="noopener noreferrer">{{ t('home.report_bug') }}</a>
        </div>
    </div>

</div>
{% endblock %}
