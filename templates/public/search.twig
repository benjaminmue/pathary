{% extends 'layouts/app_base.twig' %}

{% block title %}{{ t('search.title') }}{% if searchTerm %} - {{ searchTerm }}{% endif %}{% endblock %}

{% block stylesheets %}
<style>
    /* ===== Search design system tokens (--pds-*), scoped to .pds-root =====
       Default block = dark (app default). Light overrides below via [data-bs-theme].
       Values shared verbatim with profile/all_movies/movie_detail/faq. */
    .pds-root {
        --pds-gold: #FBBC09;
        --pds-bg: #15171B;
        --pds-surface: #1C1F24;
        --pds-surface-2: #22262C;
        --pds-border: #2A2E35;
        --pds-hair: rgba(255, 255, 255, .06);
        --pds-text: #F2F3F5;
        --pds-muted: #A9B0BA;
        --pds-dim: #7A828C;
        --pds-r: 14px;
        --pds-r-sm: 8px;
        --pds-s-sm: 8px;
        --pds-s-md: 16px;
        --pds-s-lg: 24px;
        --pds-font: "Geist", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --pds-font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    [data-bs-theme="light"] .pds-root {
        --pds-bg: #FFFFFF;
        --pds-surface: #FBFBFC;
        --pds-surface-2: #F5F6F8;
        --pds-border: #E3E6EA;
        --pds-hair: #EEF0F3;
        --pds-text: #15171B;
        --pds-muted: #5B636E;
        --pds-dim: #8A9099;
    }

    .pds-root {
        color: var(--pds-text);
        font-family: var(--pds-font);
    }

    .search-main {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 40px 24px 64px;
        box-sizing: border-box;
    }

    /* Hero */
    .search-hero {
        max-width: 640px;
        margin: 0 auto 8px;
        display: flex;
        flex-direction: column;
        gap: var(--pds-s-sm);
        text-align: center;
    }

    .search-hero h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .search-hero__sub {
        font-size: 14px;
        color: var(--pds-muted);
    }

    .search-form {
        display: flex;
        gap: var(--pds-s-sm);
        margin-top: var(--pds-s-sm);
    }

    .search-field {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-field input {
        width: 100%;
        box-sizing: border-box;
        font-family: var(--pds-font);
        font-size: 16px;
        color: var(--pds-text);
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        padding: 13px 40px 13px 16px;
        outline: none;
        transition: border-color 0.15s ease;
    }

    .search-field input:focus {
        border-color: var(--pds-gold);
    }

    .search-field__clear {
        position: absolute;
        right: 10px;
        font-size: 14px;
        color: var(--pds-dim);
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .search-field__clear:hover {
        color: var(--pds-text);
    }

    .search-submit {
        flex-shrink: 0;
        font-family: var(--pds-font);
        font-size: 15px;
        font-weight: 600;
        color: #12140F;
        background: var(--pds-gold);
        border: 1px solid var(--pds-gold);
        border-radius: var(--pds-r-sm);
        padding: 0 22px;
        cursor: pointer;
        transition: filter 0.15s ease;
    }

    .search-submit:hover {
        filter: brightness(1.06);
    }

    /* Result summary */
    .search-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--pds-s-sm);
        margin: 24px 0 40px;
        font-size: 13px;
        color: var(--pds-muted);
    }

    .search-summary .mono {
        font-family: var(--pds-font-mono);
    }

    .search-summary .num {
        font-family: var(--pds-font-mono);
        color: var(--pds-text);
    }

    /* Sections */
    .search-section {
        margin-bottom: 48px;
    }

    .search-section:last-child {
        margin-bottom: 0;
    }

    .search-section__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--pds-s-sm);
        border-bottom: 1px solid var(--pds-border);
        padding-bottom: 12px;
        margin-bottom: 20px;
    }

    .search-section__title {
        display: flex;
        align-items: baseline;
        gap: var(--pds-s-sm);
    }

    .search-section__title h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 600;
    }

    .search-section__count {
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-dim);
    }

    .search-section__hint {
        font-size: 13px;
        color: var(--pds-dim);
    }

    .search-empty {
        font-size: 14px;
        color: var(--pds-muted);
        padding: 4px 0;
    }

    /* Grid + cards */
    .search-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: var(--pds-s-md);
    }

    @media (max-width: 1100px) { .search-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @media (max-width: 820px)  { .search-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 520px)  { .search-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

    .search-card {
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-width: 0;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }

    a.search-card:hover {
        transform: translateY(-3px);
        border-color: var(--pds-gold);
    }

    .search-card__poster {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
        background: var(--pds-surface-2);
        border-bottom: 1px solid var(--pds-hair);
    }

    .search-card__placeholder {
        aspect-ratio: 2/3;
        background: var(--pds-surface-2);
        border-bottom: 1px solid var(--pds-hair);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px;
        box-sizing: border-box;
        text-align: center;
    }

    .search-card__initial {
        font-family: var(--pds-font-mono);
        font-size: 34px;
        font-weight: 700;
        color: var(--pds-gold);
        opacity: 0.85;
    }

    .search-card__ph-title {
        font-size: 12px;
        color: var(--pds-muted);
        line-height: 1.4;
        text-wrap: pretty;
    }

    .search-card__ph-note {
        font-family: var(--pds-font-mono);
        font-size: 11px;
        color: var(--pds-dim);
    }

    .search-card__body {
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }

    .search-card__title {
        font-size: 13px;
        font-weight: 600;
        line-height: 1.35;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .search-card__meta {
        display: flex;
        align-items: center;
        gap: var(--pds-s-sm);
        margin-top: 4px;
    }

    .search-card__year {
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-dim);
    }

    .search-card__pill {
        font-family: var(--pds-font-mono);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: var(--pds-muted);
        border: 1px solid var(--pds-border);
        border-radius: 999px;
        padding: 2px 7px;
    }

    .search-card__import {
        display: block;
        text-align: center;
        text-decoration: none;
        font-family: var(--pds-font);
        font-size: 12px;
        font-weight: 600;
        color: var(--pds-gold);
        background: none;
        border: 1px solid var(--pds-gold);
        border-radius: var(--pds-r-sm);
        padding: 7px 0;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
    }

    .search-card__import:hover {
        background: var(--pds-gold);
        color: #12140F;
    }

    /* Empty (no search term yet) */
    .search-idle {
        max-width: 520px;
        margin: 56px auto 0;
        text-align: center;
        color: var(--pds-muted);
    }

    .search-idle h3 {
        font-size: 18px;
        font-weight: 600;
        color: var(--pds-text);
        margin: 0 0 8px;
    }

    .search-idle p {
        font-size: 14px;
        margin: 0;
    }
</style>
{% endblock %}

{% block body %}
<div class="pds-root" style="background: var(--pds-bg); min-height: 100%;">
    <main class="search-main">

        <div class="search-hero">
            <h1>{{ t('search.heading') }}</h1>
            <div class="search-hero__sub">{{ t('search.subtitle') }}</div>
            <form class="search-form" action="{{ applicationUrl }}/search" method="get">
                <div class="search-field">
                    <input type="search"
                           name="q"
                           value="{{ searchTerm }}"
                           placeholder="{{ t('search.placeholder') }}"
                           autofocus>
                    {% if searchTerm %}
                        <a href="{{ applicationUrl }}/search" class="search-field__clear" title="{{ t('search.clear') }}" aria-label="{{ t('search.clear') }}">✕</a>
                    {% endif %}
                </div>
                <button type="submit" class="search-submit">{{ t('search.submit') }}</button>
            </form>
        </div>

        {% if searchTerm %}
            <div class="search-summary">
                <span class="mono">«{{ searchTerm }}»</span>
                <span>·</span>
                <span><span class="num">{{ localResults|length }}</span> {{ t('search.summary_library') }}</span>
                <span>·</span>
                <span><span class="num">{{ tmdbResults|length }}</span> {{ t('search.results_from_tmdb') }}</span>
            </div>

            <!-- Library -->
            <section class="search-section">
                <div class="search-section__head">
                    <div class="search-section__title">
                        <h2>{{ t('search.library_heading') }}</h2>
                        <span class="search-section__count">{{ localResults|length }} {{ t('search.hits') }}</span>
                    </div>
                </div>
                {% if localResults|length > 0 %}
                    <div class="search-grid">
                        {% for movie in localResults %}
                            <a href="{{ applicationUrl }}/movie/{{ movie.id }}" class="search-card">
                                {% if movie.poster_path %}
                                    <img src="{{ movie.poster_path }}" alt="{{ movie.title }}" class="search-card__poster" loading="lazy">
                                {% else %}
                                    <div class="search-card__placeholder">
                                        <div class="search-card__initial">{{ movie.title|first|upper }}</div>
                                        <div class="search-card__ph-title">{{ movie.title }}</div>
                                    </div>
                                {% endif %}
                                <div class="search-card__body">
                                    <div style="flex: 1">
                                        <div class="search-card__title" title="{{ movie.title }}">{{ movie.title }}</div>
                                        <div class="search-card__meta">
                                            {% if movie.release_date %}
                                                <span class="search-card__year">{{ movie.release_date|date('Y') }}</span>
                                            {% endif %}
                                            <span class="search-card__pill">{{ t('search.in_library_pill') }}</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="search-empty">{{ t('search.library_empty') }}</div>
                {% endif %}
            </section>

            <!-- TMDB -->
            <section class="search-section">
                <div class="search-section__head">
                    <div class="search-section__title">
                        <h2>{{ t('search.tmdb_heading') }}</h2>
                        <span class="search-section__count">{{ tmdbResults|length }} {{ t('search.results_count') }}</span>
                    </div>
                    {% if tmdbResults|length > 0 %}
                        <span class="search-section__hint">{{ t('search.tmdb_hint') }}</span>
                    {% endif %}
                </div>
                {% if tmdbResults|length > 0 %}
                    <div class="search-grid">
                        {% for movie in tmdbResults %}
                            <div class="search-card">
                                {% if movie.poster_path %}
                                    <img src="https://image.tmdb.org/t/p/w300{{ movie.poster_path }}" alt="{{ movie.title }}" class="search-card__poster" loading="lazy">
                                {% else %}
                                    <div class="search-card__placeholder">
                                        <div class="search-card__initial">{{ movie.title|first|upper }}</div>
                                        <div class="search-card__ph-title">{{ movie.title }}</div>
                                        <div class="search-card__ph-note">{{ t('search.poster_via_tmdb') }}</div>
                                    </div>
                                {% endif %}
                                <div class="search-card__body">
                                    <div style="flex: 1">
                                        <div class="search-card__title" title="{{ movie.title }}">{{ movie.title }}</div>
                                        <div class="search-card__meta">
                                            {% if movie.release_date %}
                                                <span class="search-card__year">{{ movie.release_date|date('Y') }}</span>
                                            {% endif %}
                                            <span class="search-card__pill">TMDB</span>
                                        </div>
                                    </div>
                                    <a href="{{ applicationUrl }}/tmdb/movie/{{ movie.id }}" class="search-card__import">+ {{ t('search.import') }}</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="search-empty">{{ t('search.tmdb_empty') }}</div>
                {% endif %}
            </section>
        {% else %}
            <div class="search-idle">
                <h3>{{ t('search.search_for_movies') }}</h3>
                <p>{{ t('search.empty_hint') }}</p>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
