{% extends 'layouts/app_base.twig' %}

{% block title %}{{ t('movies.title') }}{% endblock %}

{% block stylesheets %}
<style>
    /* ===== Design system tokens (--pds-*), scoped to .pds-root =====
       Default block = dark (app default). Light overrides below via [data-bs-theme].
       Same token values/structure as the profile redesign. */
    .pds-root {
        --pds-gold: #FBBC09;
        --pds-bg: #15171B;
        --pds-surface: #1C1F24;
        --pds-surface-2: #22262C;
        --pds-border: #2A2E35;
        --pds-hair: rgba(255, 255, 255, .06);
        --pds-text: #F2F3F5;
        --pds-muted: #A9B0BA;
        --pds-dim: #7A828C;
        --pds-nav: #101216;
        --pds-danger: #E5654B;
        --pds-success: #4FB477;
        --pds-r: 14px;
        --pds-r-sm: 8px;
        --pds-s-sm: 8px;
        --pds-s-md: 16px;
        --pds-s-lg: 24px;
        --pds-s-xl: 32px;
        --pds-font: "Geist", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        --pds-font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    [data-bs-theme="light"] .pds-root {
        --pds-bg: #FFFFFF;
        --pds-surface: #FBFBFC;
        --pds-surface-2: #F5F6F8;
        --pds-border: #E3E6EA;
        --pds-hair: #EEF0F3;
        --pds-text: #15171B;
        --pds-muted: #5B636E;
        --pds-dim: #8A9099;
        --pds-nav: #101216;
        --pds-danger: #C0392B;
        --pds-success: #198754;
    }

    .pds-root {
        color: var(--pds-text);
        font-family: var(--pds-font);
    }

    .am-main {
        width: 100%;
        max-width: 1560px;
        margin: 0 auto;
        padding: 40px 32px 64px;
        box-sizing: border-box;
    }

    /* Page header */
    .am-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--pds-s-lg);
        flex-wrap: wrap;
        margin-bottom: 28px;
    }

    .am-title {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--pds-text);
    }

    .am-subtitle {
        font-size: 14px;
        color: var(--pds-muted);
        margin: 4px 0 0;
    }

    .am-subtitle .mono {
        font-family: var(--pds-font-mono);
        color: var(--pds-text);
    }

    .am-controls {
        display: flex;
        gap: var(--pds-s-sm);
        align-items: center;
        flex-wrap: wrap;
    }

    .am-sort-label {
        font-size: 13px;
        color: var(--pds-muted);
        margin: 0;
    }

    .sort-select {
        font-size: 14px;
        color: var(--pds-text);
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        padding: 9px 12px;
        outline: none;
        cursor: pointer;
        min-width: 200px;
    }

    .sort-select:focus {
        border-color: var(--pds-gold);
    }

    .btn-filter-toggle {
        display: none;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        font-weight: 600;
        color: var(--pds-text);
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        padding: 8px 12px;
        cursor: pointer;
    }

    /* Two-column layout */
    .am-layout {
        display: grid;
        grid-template-columns: 264px 1fr;
        gap: var(--pds-s-xl);
        align-items: start;
    }

    .filters-sidebar {
        position: sticky;
        top: 24px;
        height: fit-content;
    }

    .filters-card {
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r);
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .filters-title {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        color: var(--pds-text);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-clear-filters {
        font-size: 12px;
        font-weight: 500;
        color: var(--pds-muted);
        background: transparent;
        border: 0;
        padding: 0;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.15s ease;
    }

    .btn-clear-filters:hover {
        color: var(--pds-gold);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin: 0;
    }

    .filter-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--pds-s-sm);
    }

    .filter-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--pds-text);
        margin: 0;
    }

    .filter-scale {
        font-family: var(--pds-font-mono);
        font-size: 11px;
        color: var(--pds-dim);
        white-space: nowrap;
    }

    .filter-select,
    .filter-input {
        width: 100%;
        box-sizing: border-box;
        font-size: 13px;
        color: var(--pds-text);
        background: var(--pds-bg);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        padding: 8px 10px;
    }

    .filter-input {
        font-family: var(--pds-font-mono);
    }

    .filter-select:focus,
    .filter-input:focus {
        outline: none;
        border-color: var(--pds-gold);
    }

    .filter-range {
        display: flex;
        gap: var(--pds-s-sm);
        align-items: center;
    }

    .filter-range input {
        flex: 1;
        min-width: 0;
    }

    .filter-range-separator {
        color: var(--pds-dim);
    }

    /* Dual range slider */
    .dual-range-slider {
        position: relative;
        width: 100%;
        padding: 0.75rem 0;
    }

    .dual-range-slider-track {
        position: absolute;
        width: 100%;
        height: 4px;
        background: var(--pds-border);
        border-radius: 2px;
        top: 50%;
        transform: translateY(-50%);
    }

    .dual-range-slider-range {
        position: absolute;
        height: 4px;
        background: var(--pds-gold);
        border-radius: 2px;
        top: 50%;
        transform: translateY(-50%);
    }

    .dual-range-slider input[type="range"] {
        position: absolute;
        width: 100%;
        height: 4px;
        background: transparent;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
    }

    .dual-range-slider input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 18px;
        height: 18px;
        background: var(--pds-gold);
        border: 3px solid var(--pds-surface);
        border-radius: 50%;
        cursor: pointer;
        pointer-events: auto;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    }

    .dual-range-slider input[type="range"]::-moz-range-thumb {
        width: 18px;
        height: 18px;
        background: var(--pds-gold);
        border: 3px solid var(--pds-surface);
        border-radius: 50%;
        cursor: pointer;
        pointer-events: auto;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    }

    .dual-range-slider input[type="range"]::-webkit-slider-thumb:hover {
        background: #e0a808;
    }

    .dual-range-slider input[type="range"]::-moz-range-thumb:hover {
        background: #e0a808;
    }

    .dual-range-values {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: var(--pds-muted);
    }

    .dual-range-value {
        font-family: var(--pds-font-mono);
        padding: 2px 8px;
        background: var(--pds-surface-2);
        border-radius: var(--pds-r-sm);
        font-weight: 500;
    }

    .filter-info {
        font-size: 11px;
        color: var(--pds-dim);
        margin: 2px 0 0;
    }

    .btn-apply-filters {
        width: 100%;
        height: 36px;
        font-size: 14px;
        font-weight: 600;
        color: #12140F;
        background: var(--pds-gold);
        border: 1px solid var(--pds-gold);
        border-radius: var(--pds-r-sm);
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .btn-apply-filters:hover {
        background: #e0a808;
    }

    /* Active filter badges */
    .active-filters {
        display: flex;
        flex-wrap: wrap;
        gap: var(--pds-s-sm);
        margin-bottom: var(--pds-s-md);
    }

    .active-filter-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--pds-surface-2);
        border: 1px solid var(--pds-border);
        color: var(--pds-muted);
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12px;
    }

    /* Results column */
    .am-results {
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: var(--pds-s-md);
    }

    .movie-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease;
    }

    .movie-card:hover {
        transform: translateY(-4px);
    }

    .movie-poster,
    .movie-poster-placeholder {
        width: 100%;
        aspect-ratio: 2/3;
        border-radius: var(--pds-r-sm);
        border: 1px solid var(--pds-border);
        object-fit: cover;
        display: block;
    }

    .movie-card:hover .movie-poster,
    .movie-card:hover .movie-poster-placeholder {
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
    }

    .movie-poster-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--pds-surface-2) 0%, var(--pds-surface) 100%);
        color: var(--pds-dim);
        font-size: 12px;
        text-align: center;
        padding: 1rem;
        box-sizing: border-box;
    }

    .movie-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .movie-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--pds-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .movie-meta-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--pds-s-sm);
    }

    .movie-year {
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-muted);
    }

    .movie-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-gold);
    }

    .movie-rating .popcorn-emoji {
        font-size: 13px;
        line-height: 1;
    }

    .no-movies {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem 2rem;
        color: var(--pds-muted);
    }

    .no-movies h3 {
        color: var(--pds-text);
    }

    /* Pagination */
    .am-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--pds-s-sm);
        flex-wrap: wrap;
        padding-top: 4px;
    }

    .am-page-btn {
        font-size: 13px;
        font-weight: 600;
        height: 36px;
        padding: 0 14px;
        border-radius: var(--pds-r-sm);
        border: 1px solid var(--pds-border);
        background: var(--pds-surface);
        color: var(--pds-text);
        cursor: pointer;
    }

    .am-page-btn:disabled {
        opacity: 0.5;
        cursor: default;
        color: var(--pds-dim);
    }

    .am-page-btn:not(:disabled):hover {
        border-color: var(--pds-dim);
    }

    .am-page-num {
        min-width: 36px;
        height: 36px;
        padding: 0 6px;
        border-radius: var(--pds-r-sm);
        border: 1px solid var(--pds-border);
        background: var(--pds-surface);
        color: var(--pds-muted);
        font-family: var(--pds-font-mono);
        font-size: 13px;
        cursor: pointer;
    }

    .am-page-num:hover {
        border-color: var(--pds-dim);
        color: var(--pds-text);
    }

    .am-page-num.active {
        background: var(--pds-gold);
        color: #12140F;
        border-color: var(--pds-gold);
        font-weight: 700;
    }

    .am-ellipsis {
        font-family: var(--pds-font-mono);
        color: var(--pds-dim);
        padding: 0 4px;
    }

    .am-page-status {
        text-align: center;
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-dim);
        margin-top: -16px;
    }

    /* Responsive */
    @media (max-width: 1199px) {
        .movie-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @media (max-width: 991px) {
        .am-main {
            padding: 24px 16px 48px;
        }

        .am-layout {
            grid-template-columns: 1fr;
        }

        .filters-sidebar {
            display: none;
        }

        .btn-filter-toggle {
            display: inline-flex;
        }

        .movie-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @media (max-width: 575px) {
        .am-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .am-controls {
            width: 100%;
        }

        .sort-select {
            flex: 1;
            min-width: 0;
        }

        .movie-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* Offcanvas filters styling */
    .offcanvas-filters {
        background: var(--pds-surface);
        color: var(--pds-text);
    }

    .offcanvas-filters .offcanvas-header {
        border-bottom: 1px solid var(--pds-border);
    }

    .offcanvas-filters .offcanvas-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .offcanvas-filters .filter-actions {
        display: flex;
        flex-direction: column;
        gap: var(--pds-s-sm);
    }

    .offcanvas-filters .btn-clear-filters {
        text-align: center;
        padding: 8px;
    }
</style>
{% endblock %}

{% block body %}
<div class="pds-root">
    <main class="am-main">
        <header class="am-header">
            <div>
                <h1 class="am-title">{{ t('movies.title') }}</h1>
                <p class="am-subtitle" id="resultRange">
                    {{ t('movies.range_of', {shown: (totalMovies > 0 ? '1-' ~ min(30, totalMovies) : '0'), total: totalMovies}) }}
                </p>
            </div>

            <div class="am-controls">
                <button class="btn-filter-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#filtersOffcanvas">
                    <i class="bi bi-funnel"></i> {{ t('movies.filters') }}
                </button>

                <label class="am-sort-label" for="sortSelect">{{ t('movies.sort_label') }}</label>
                <select class="sort-select" id="sortSelect" onchange="updateSort(this.value)">
                    <option value="added-desc" {{ currentSort == 'added' and currentOrder == 'desc' ? 'selected' : '' }}>{{ t('movies.sort_recently_added') }}</option>
                    <option value="added-asc" {{ currentSort == 'added' and currentOrder == 'asc' ? 'selected' : '' }}>{{ t('movies.sort_oldest_added') }}</option>
                    <option value="title-asc" {{ currentSort == 'title' and currentOrder == 'asc' ? 'selected' : '' }}>{{ t('movies.sort_title_az') }}</option>
                    <option value="title-desc" {{ currentSort == 'title' and currentOrder == 'desc' ? 'selected' : '' }}>{{ t('movies.sort_title_za') }}</option>
                    <option value="release_date-desc" {{ currentSort == 'release_date' and currentOrder == 'desc' ? 'selected' : '' }}>{{ t('movies.sort_newest_release') }}</option>
                    <option value="release_date-asc" {{ currentSort == 'release_date' and currentOrder == 'asc' ? 'selected' : '' }}>{{ t('movies.sort_oldest_release') }}</option>
                    <option value="global_rating-desc" {{ currentSort == 'global_rating' and currentOrder == 'desc' ? 'selected' : '' }}>{{ t('movies.sort_highest_rated') }}</option>
                    <option value="global_rating-asc" {{ currentSort == 'global_rating' and currentOrder == 'asc' ? 'selected' : '' }}>{{ t('movies.sort_lowest_rated') }}</option>
                    <option value="own_rating-desc" {{ currentSort == 'own_rating' and currentOrder == 'desc' ? 'selected' : '' }}>{{ t('movies.sort_my_rating_high') }}</option>
                    <option value="own_rating-asc" {{ currentSort == 'own_rating' and currentOrder == 'asc' ? 'selected' : '' }}>{{ t('movies.sort_my_rating_low') }}</option>
                </select>
            </div>
        </header>

        {% if currentGenre or currentRatingMin or currentRatingMax or currentYearMin or currentYearMax or currentTmdbMin or currentTmdbMax or currentImdbMin or currentImdbMax or currentRtMin or currentRtMax %}
            <div class="active-filters">
                {% if currentGenre %}
                    <span class="active-filter-badge">
                        <i class="bi bi-tag"></i> {{ currentGenre }}
                    </span>
                {% endif %}
                {% if currentRatingMin or currentRatingMax %}
                    <span class="active-filter-badge">
                        🍿 {{ t('movies.badge_rating') }} {{ currentRatingMin ?? 1 }} - {{ currentRatingMax ?? 7 }}
                    </span>
                {% endif %}
                {% if currentYearMin or currentYearMax %}
                    <span class="active-filter-badge">
                        <i class="bi bi-calendar"></i> {{ t('movies.badge_year') }} {{ currentYearMin ?? yearRange.min }} - {{ currentYearMax ?? yearRange.max }}
                    </span>
                {% endif %}
                {% if currentTmdbMin or currentTmdbMax %}
                    <span class="active-filter-badge">
                        TMDB: {{ currentTmdbMin ?? 0 }} - {{ currentTmdbMax ?? 10 }}
                    </span>
                {% endif %}
                {% if currentImdbMin or currentImdbMax %}
                    <span class="active-filter-badge">
                        IMDB: {{ currentImdbMin ?? 0 }} - {{ currentImdbMax ?? 10 }}
                    </span>
                {% endif %}
                {% if currentRtMin or currentRtMax %}
                    <span class="active-filter-badge">
                        RT: {{ currentRtMin ?? 0 }}% - {{ currentRtMax ?? 100 }}%
                    </span>
                {% endif %}
            </div>
        {% endif %}

        <div class="am-layout">
            <!-- Desktop Filters Sidebar -->
            <aside class="filters-sidebar">
                <div class="filters-card">
                    <h2 class="filters-title">
                        {{ t('movies.filters') }}
                        {% if currentGenre or currentRatingMin or currentRatingMax or currentYearMin or currentYearMax or currentTmdbMin or currentTmdbMax or currentImdbMin or currentImdbMax or currentRtMin or currentRtMax %}
                            <a href="{{ applicationUrl }}/movies?sort={{ currentSort }}&order={{ currentOrder }}" class="btn-clear-filters">{{ t('movies.clear') }}</a>
                        {% endif %}
                    </h2>

                    <form id="filtersForm" action="{{ applicationUrl }}/movies" method="get">
                        <input type="hidden" name="sort" value="{{ currentSort }}">
                        <input type="hidden" name="order" value="{{ currentOrder }}">

                        <div class="filter-group">
                            <label class="filter-label">{{ t('movies.genre') }}</label>
                            <select name="genre" class="filter-select">
                                <option value="">{{ t('movies.all_genres') }}</option>
                                {% for g in genres %}
                                    <option value="{{ g }}" {{ currentGenre == g ? 'selected' : '' }}>{{ g }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">{{ t('movies.release_year') }}</label>
                            <div class="filter-range">
                                <input type="number" name="year_min" class="filter-input" placeholder="{{ yearRange.min ?? t('movies.min') }}" min="{{ yearRange.min }}" max="{{ yearRange.max }}" value="{{ currentYearMin }}">
                                <span class="filter-range-separator">-</span>
                                <input type="number" name="year_max" class="filter-input" placeholder="{{ yearRange.max ?? t('movies.max') }}" min="{{ yearRange.min }}" max="{{ yearRange.max }}" value="{{ currentYearMax }}">
                            </div>
                        </div>

                        <div class="filter-group">
                            <div class="filter-head">
                                <label class="filter-label">{{ t('movies.global_rating') }}</label>
                                <span class="filter-scale">1-7</span>
                            </div>
                            <div class="dual-range-slider">
                                <div class="dual-range-slider-track"></div>
                                <div class="dual-range-slider-range" id="rating-range"></div>
                                <input type="range" min="1" max="7" step="1" value="{{ currentRatingMin ?? 1 }}" id="rating-min" data-input="rating_min">
                                <input type="range" min="1" max="7" step="1" value="{{ currentRatingMax ?? 7 }}" id="rating-max" data-input="rating_max">
                            </div>
                            <div class="dual-range-values">
                                <span class="dual-range-value">🍿 <span id="rating-min-value">{{ currentRatingMin ?? 1 }}</span></span>
                                <span class="dual-range-value">🍿 <span id="rating-max-value">{{ currentRatingMax ?? 7 }}</span></span>
                            </div>
                            <input type="hidden" name="rating_min" id="rating_min" value="{{ currentRatingMin }}">
                            <input type="hidden" name="rating_max" id="rating_max" value="{{ currentRatingMax }}">
                        </div>

                        <div class="filter-group">
                            <div class="filter-head">
                                <label class="filter-label">{{ t('movies.tmdb_rating') }}</label>
                                <span class="filter-scale">0-10</span>
                            </div>
                            <div class="dual-range-slider">
                                <div class="dual-range-slider-track"></div>
                                <div class="dual-range-slider-range" id="tmdb-range"></div>
                                <input type="range" min="0" max="10" step="0.5" value="{{ currentTmdbMin ?? 0 }}" id="tmdb-min" data-input="tmdb_min">
                                <input type="range" min="0" max="10" step="0.5" value="{{ currentTmdbMax ?? 10 }}" id="tmdb-max" data-input="tmdb_max">
                            </div>
                            <div class="dual-range-values">
                                <span class="dual-range-value"><span id="tmdb-min-value">{{ currentTmdbMin ?? 0 }}</span></span>
                                <span class="dual-range-value"><span id="tmdb-max-value">{{ currentTmdbMax ?? 10 }}</span></span>
                            </div>
                            <input type="hidden" name="tmdb_min" id="tmdb_min" value="{{ currentTmdbMin }}">
                            <input type="hidden" name="tmdb_max" id="tmdb_max" value="{{ currentTmdbMax }}">
                        </div>

                        {% if omdbConfigured %}
                            <div class="filter-group">
