{% block scripts %}
<script>
function updateSort(value) {
    const [sort, order] = value.split('-');
    const url = new URL(window.location.href);
    url.searchParams.set('sort', sort);
    url.searchParams.set('order', order);
    window.location.href = url.toString();
}

// Dual Range Slider functionality
function initDualRangeSlider(minId, maxId, rangeId, minValueId, maxValueId, inputName) {
    const minSlider = document.getElementById(minId);
    const maxSlider = document.getElementById(maxId);
    const rangeBar = document.getElementById(rangeId);
    const minValueDisplay = document.getElementById(minValueId);
    const maxValueDisplay = document.getElementById(maxValueId);
    const minInput = document.getElementById(inputName + '_min') || document.getElementById(minSlider.dataset.input);
    const maxInput = document.getElementById(inputName + '_max') || document.getElementById(maxSlider.dataset.input);

    if (!minSlider || !maxSlider || !rangeBar) return;

    function updateRange() {
        const min = parseFloat(minSlider.value);
        const max = parseFloat(maxSlider.value);
        const minVal = parseFloat(minSlider.min);
        const maxVal = parseFloat(minSlider.max);

        // Prevent handles from crossing
        if (min > max) {
            if (event.target === minSlider) {
                minSlider.value = max;
            } else {
                maxSlider.value = min;
            }
        }

        const currentMin = parseFloat(minSlider.value);
        const currentMax = parseFloat(maxSlider.value);

        // Update range bar position and width
        const percentMin = ((currentMin - minVal) / (maxVal - minVal)) * 100;
        const percentMax = ((currentMax - minVal) / (maxVal - minVal)) * 100;
        rangeBar.style.left = percentMin + '%';
        rangeBar.style.width = (percentMax - percentMin) + '%';

        // Update displayed values
        if (minValueDisplay) minValueDisplay.textContent = currentMin;
        if (maxValueDisplay) maxValueDisplay.textContent = currentMax;

        // Update hidden inputs
        if (minInput) minInput.value = currentMin;
        if (maxInput) maxInput.value = currentMax;
    }

    minSlider.addEventListener('input', updateRange);
    maxSlider.addEventListener('input', updateRange);

    // Initialize on page load
    updateRange();
}

// Initialize all dual range sliders on page load
document.addEventListener('DOMContentLoaded', function() {
    // Desktop filters
    initDualRangeSlider('rating-min', 'rating-max', 'rating-range', 'rating-min-value', 'rating-max-value', 'rating');
    initDualRangeSlider('tmdb-min', 'tmdb-max', 'tmdb-range', 'tmdb-min-value', 'tmdb-max-value', 'tmdb');
    initDualRangeSlider('imdb-min', 'imdb-max', 'imdb-range', 'imdb-min-value', 'imdb-max-value', 'imdb');
    initDualRangeSlider('rt-min', 'rt-max', 'rt-range', 'rt-min-value', 'rt-max-value', 'rt');

    // Mobile filters
    initDualRangeSlider('rating-min-mobile', 'rating-max-mobile', 'rating-range-mobile', 'rating-min-value-mobile', 'rating-max-value-mobile', 'rating');
    initDualRangeSlider('tmdb-min-mobile', 'tmdb-max-mobile', 'tmdb-range-mobile', 'tmdb-min-value-mobile', 'tmdb-max-value-mobile', 'tmdb');
    initDualRangeSlider('imdb-min-mobile', 'imdb-max-mobile', 'imdb-range-mobile', 'imdb-min-value-mobile', 'imdb-max-value-mobile', 'imdb');
    initDualRangeSlider('rt-min-mobile', 'rt-max-mobile', 'rt-range-mobile', 'rt-min-value-mobile', 'rt-max-value-mobile', 'rt');
});
</script>

<script>
// Client-side pagination over the rendered movie grid (no server pagination available).
(function () {
    const PER_PAGE = 30;
    const grid = document.getElementById('movieGrid');
    if (!grid) return;

    const cards = Array.prototype.slice.call(grid.querySelectorAll('.movie-card'));
    const total = cards.length;
    const pageCount = Math.max(1, Math.ceil(total / PER_PAGE));

    const paginationEl = document.getElementById('pagination');
    const statusEl = document.getElementById('pageStatus');
    const rangeEl = document.getElementById('resultRange');

    // i18n templates (placeholders replaced client-side).
    const I18N = {
        rangeOf: {{ t('movies.range_of')|json_encode|raw }},
        status: {{ t('movies.pagination_status')|json_encode|raw }},
        prev: {{ t('movies.prev')|json_encode|raw }},
        next: {{ t('movies.next')|json_encode|raw }}
    };

    let current = 1;

    function updateHeaderRange() {
        if (!rangeEl) return;
        const from = total === 0 ? 0 : (current - 1) * PER_PAGE + 1;
        const to = Math.min(current * PER_PAGE, total);
        const shown = total === 0 ? '0' : '<span class="mono">' + from + '-' + to + '</span>';
        rangeEl.innerHTML = I18N.rangeOf
            .replace('{shown}', shown)
            .replace('{total}', '<span class="mono">' + total + '</span>');
    }

    function buildPageItems() {
        const items = [];
        let last = 0;
        for (let p = 1; p <= pageCount; p++) {
            if (p === 1 || p === pageCount || (p >= current - 1 && p <= current + 1)) {
                if (last && p - last > 1) items.push('ellipsis');
                items.push(p);
                last = p;
            }
        }
        return items;
    }

    function renderControls() {
        if (!paginationEl) return;
        paginationEl.innerHTML = '';

        const prevBtn = document.createElement('button');
        prevBtn.type = 'button';
        prevBtn.className = 'am-page-btn';
        prevBtn.innerHTML = '&larr; ' + I18N.prev;
        prevBtn.disabled = current === 1;
        prevBtn.addEventListener('click', function () { if (current > 1) showPage(current - 1); });
        paginationEl.appendChild(prevBtn);

        buildPageItems().forEach(function (item) {
            if (item === 'ellipsis') {
                const span = document.createElement('span');
                span.className = 'am-ellipsis';
                span.textContent = '…';
                paginationEl.appendChild(span);
                return;
            }
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'am-page-num' + (item === current ? ' active' : '');
            btn.textContent = item;
            if (item === current) btn.setAttribute('aria-current', 'page');
            btn.addEventListener('click', function () { showPage(item); });
            paginationEl.appendChild(btn);
        });

        const nextBtn = document.createElement('button');
        nextBtn.type = 'button';
        nextBtn.className = 'am-page-btn';
        nextBtn.innerHTML = I18N.next + ' &rarr;';
        nextBtn.disabled = current === pageCount;
        nextBtn.addEventListener('click', function () { if (current < pageCount) showPage(current + 1); });
        paginationEl.appendChild(nextBtn);
    }

    function renderStatus() {
        if (!statusEl) return;
        statusEl.textContent = I18N.status
            .replace('{page}', current)
            .replace('{total}', pageCount)
            .replace('{per}', PER_PAGE);
    }

    function showPage(page, scroll) {
        current = Math.min(Math.max(1, page), pageCount);
        cards.forEach(function (card, index) {
            const onPage = index >= (current - 1) * PER_PAGE && index < current * PER_PAGE;
            card.style.display = onPage ? '' : 'none';
        });
        updateHeaderRange();
        renderControls();
        renderStatus();
        if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    if (total <= PER_PAGE) {
        // Single page: hide pagination bar + status, but still fix the header range.
        if (paginationEl) paginationEl.style.display = 'none';
        if (statusEl) statusEl.style.display = 'none';
        updateHeaderRange();
        return;
    }

    showPage(1, false);
})();
</script>
