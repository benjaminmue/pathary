{% extends 'layouts/public_base.twig' %}

{% block title %}{{ movie.title }}{% endblock %}
{% block description %}{% set text = movie.overview ?: t('meta.description') %}{{ text|length > 200 ? text|slice(0, 197) ~ '...' : text }}{% endblock %}
{% block og_type %}video.movie{% endblock %}
{% block og_image %}{{ movie.posterPath ?: applicationUrl ~ '/images/pathary-logo-512x512.png' }}{% endblock %}

{% block stylesheets %}
<link href="{{ applicationUrl }}/css/lightbox.css?v={{ assetVersion }}" rel="stylesheet">
<style>
    /* --pds-* tokens live in public/assets/css/theme.css. */

    .pds-mono {
        font-family: var(--pds-font-mono);
    }

    /* ===== Hero ===== */
    /* A flat dark band in both themes (like the nav): the poster carries the colour.
       Tokens are pinned to their dark values so gold and dim text stay readable. */
    .pds-hero {
        --pds-gold-text: var(--gold);
        --pds-dim: #8A919B;
        position: relative;
        overflow: hidden;
        background: #1C1F24;
        border-bottom: 1px solid var(--pds-hair);
        margin-bottom: var(--pds-s-xl);
    }

    .pds-hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1180px;
        margin: 0 auto;
        padding: 40px 32px 36px;
    }

    .pds-back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #cfd4db;
        text-decoration: none;
        margin-bottom: var(--pds-s-lg);
    }

    .pds-back-link:hover {
        color: var(--pds-gold-text);
    }

    .pds-hero-body {
        display: flex;
        gap: 40px;
        align-items: flex-start;
    }

    .pds-hero-poster {
        width: 240px;
        aspect-ratio: 2/3;
        flex-shrink: 0;
        border-radius: var(--pds-r);
        border: 1px solid rgba(255, 255, 255, .12);
        box-shadow: 0 24px 60px rgba(0, 0, 0, .55);
        overflow: hidden;
    }

    .pds-hero-poster .poster-lightbox-trigger {
        width: 100%;
        height: 100%;
    }

    /* The poster clips overflow, so draw the focus ring inside it. */
    .pds-hero-poster .poster-lightbox-trigger:focus-visible {
        outline-offset: -3px !important;
    }

    .pds-hero-poster img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .pds-hero-poster-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1rem;
        background: #23272D;
        color: #cbd0d7;
        font-size: 14px;
    }

    .pds-hero-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--pds-s-md);
        color: #EAEDF1;
    }

    .pds-hero-title {
        font-size: 42px;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.05;
        color: #fff;
        margin: 0;
    }

    [data-bs-theme="light"] .pds-hero-info,
    [data-bs-theme="light"] .pds-hero-title {
        color: #fff;
    }

    .pds-hero-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--pds-s-md);
        font-family: var(--pds-font-mono);
        font-size: 13px;
        color: #c3c9d1;
    }

    .pds-hero-meta .sep {
        opacity: .5;
    }

    .pds-genres {
        display: flex;
        flex-wrap: wrap;
        gap: var(--pds-s-sm);
    }

    .pds-genre-pill {
        font-size: 12px;
        font-weight: 600;
        background: rgba(255, 255, 255, .08);
        border: 1px solid rgba(255, 255, 255, .14);
        border-radius: 999px;
        padding: 5px 14px;
        color: #EAEDF1;
    }

    .pds-tagline {
        font-size: 15px;
        font-style: italic;
        color: var(--pds-gold-text);
        margin: 0;
    }

    .pds-overview {
        font-size: 15px;
        line-height: 1.6;
        max-width: 640px;
        text-wrap: pretty;
        color: #d6dae0;
        margin: 0;
    }

    .pds-hero-rating {
        display: flex;
        align-items: center;
        gap: var(--pds-s-md);
    }

    .pds-hero-rating-stats {
        font-family: var(--pds-font-mono);
        font-size: 13px;
        color: #c3c9d1;
    }

    .pds-rating-help {
        display: inline-flex;
        align-items: center;
        color: var(--pds-dim);
        font-size: 15px;
        line-height: 1;
        text-decoration: none;
        transition: color .15s ease;
    }

    .pds-rating-help:hover {
        color: var(--pds-gold-text);
    }

    .pds-ext-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--pds-s-sm);
    }

    .pds-ext-badge {
        display: flex;
        align-items: baseline;
        gap: 8px;
        background: rgba(0, 0, 0, .35);
        border: 1px solid rgba(255, 255, 255, .12);
        border-radius: var(--pds-r-sm);
        padding: 8px 14px;
    }

    .pds-ext-label {
        font-family: var(--pds-font-mono);
        font-size: 11px;
        letter-spacing: .1em;
        color: #aab0b9;
        text-transform: uppercase;
    }

    .pds-ext-value {
        font-family: var(--pds-font-mono);
        font-size: 16px;
        font-weight: 700;
        color: var(--pds-gold-text);
    }

    .pds-ext-unit {
        font-family: var(--pds-font-mono);
        font-size: 11px;
        color: #8b919a;
    }

    /* ===== Main ===== */
    .pds-main {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 32px 72px;
        display: flex;
        flex-direction: column;
        gap: 56px;
    }

    .pds-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--pds-s-md);
        margin-bottom: var(--pds-s-lg);
    }

    .pds-section-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--pds-text);
        margin: 0;
    }

    .pds-section-count {
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-dim);
    }

    /* ===== TMDB facts ===== */
    .pds-facts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: var(--pds-s-md);
    }

    .pds-fact {
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        padding: 14px 16px;
    }

    .pds-fact-label {
        font-family: var(--pds-font-mono);
        font-size: 10px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--pds-dim);
    }

    .pds-fact-value {
        font-size: 14px;
        font-weight: 600;
        margin-top: 6px;
        line-height: 1.35;
        color: var(--pds-text);
    }

    .pds-fact-value--empty {
        color: var(--pds-dim);
        font-weight: 500;
        font-style: italic;
    }

    /* ===== Cast carousel ===== */
    .pds-cast-scroll {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scrollbar-width: none;
        padding-bottom: 4px;
        scroll-behavior: smooth;
    }

    .pds-cast-scroll::-webkit-scrollbar {
        display: none;
    }

    .pds-cast-card {
        width: 132px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pds-cast-photo {
        width: 132px;
        height: 165px;
        border-radius: var(--pds-r-sm);
        background: var(--pds-surface-2);
        border: 1px solid var(--pds-hair);
        overflow: hidden;
    }

    .pds-cast-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .pds-cast-photo-empty {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .pds-cast-initials {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: 1px solid var(--pds-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--pds-font-mono);
        font-size: 18px;
        font-weight: 700;
        color: var(--pds-gold-text);
    }

    .pds-cast-nophoto-hint {
        font-family: var(--pds-font-mono);
        font-size: 10px;
        color: var(--pds-dim);
    }

    .pds-cast-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--pds-text);
    }

    .pds-cast-role {
        font-size: 12px;
        color: var(--pds-muted);
        margin-top: 2px;
    }

    .pds-scroll-btns {
        display: flex;
        gap: 8px;
    }

    .pds-scroll-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid var(--pds-border);
        background: transparent;
        color: var(--pds-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: color .15s, border-color .15s;
    }

    .pds-scroll-btn:hover {
        color: var(--pds-gold-text);
        border-color: var(--pds-gold);
    }

    /* ===== Cards (rating form + reviews) ===== */
    .pds-card {
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r);
        overflow: hidden;
    }

    .pds-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--pds-s-md);
        padding: 20px 24px;
        border-bottom: 1px solid var(--pds-hair);
    }

    .pds-card-title {
        font-size: 17px;
        font-weight: 600;
        margin: 0;
    }

    .pds-card-sub {
        font-size: 13px;
        color: var(--pds-muted);
    }

    .pds-card-body {
        padding: 24px;
    }

    .pds-card-foot {
        padding: 16px 24px;
        border-top: 1px solid var(--pds-hair);
        background: var(--pds-surface-2);
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: var(--pds-s-md);
    }

    /* Rating form layout inside card */
    .rating-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: var(--pds-s-lg);
        margin-bottom: var(--pds-s-lg);
    }

    .rating-form-col {
        display: flex;
        flex-direction: column;
    }

    fieldset.rating-form-col {
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
    }

    .rating-form-col label,
    .rating-form-label,
    .rating-form-group label {
        display: block;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--pds-dim);
        margin-bottom: var(--pds-s-sm);
    }

    .pds-root select,
    .pds-root textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        background: var(--pds-bg);
        color: var(--pds-text);
        font-family: inherit;
        font-size: 14px;
    }

    .pds-root select:focus,
    .pds-root textarea:focus {
        border-color: var(--pds-gold);
    }

    .pds-root select:disabled {
        opacity: .5;
        cursor: not-allowed;
    }

    .date-dropdowns {
        display: flex;
        gap: var(--pds-s-sm);
    }

    .date-dropdowns select {
        flex: 1;
    }

    .rating-form-group {
        margin-bottom: 0;
    }

    .rating-form-group textarea {
        min-height: 96px;
        resize: vertical;
    }

    .pds-btn {
        font-size: 13px;
        font-weight: 600;
        border-radius: var(--pds-r-sm);
        padding: 9px 18px;
        cursor: pointer;
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        line-height: 1.2;
        transition: background .15s, border-color .15s, color .15s;
    }

    .pds-btn-primary {
        background: var(--pds-gold);
        color: #12140F;
    }

    .pds-btn-primary:hover {
        background: #e0a808;
        color: #12140F;
    }

    .pds-btn-danger {
        background: transparent;
        border-color: var(--pds-danger);
        color: var(--pds-danger);
    }

    .pds-btn-danger:hover {
        background: rgba(192, 57, 43, .08);
    }

    .pds-btn-secondary {
        background: transparent;
        border-color: var(--pds-border);
        color: var(--pds-text);
    }

    .pds-btn-secondary:hover {
        border-color: var(--pds-gold);
    }

    .pds-field-hint,
    .pds-field-error {
        margin: var(--pds-s-sm) 0 0;
        font-size: 13px;
    }

    .pds-field-hint {
        color: var(--pds-muted);
    }

    .pds-field-hint a {
        color: var(--pds-gold-text);
    }

    .pds-field-error {
        color: var(--pds-danger);
    }

    /* ===== Reviews grid ===== */
    .pds-reviews-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--pds-s-lg);
    }

    .pds-review {
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r);
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .pds-review-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--pds-s-md);
    }

    .pds-review-user {
        font-weight: 600;
        font-size: 15px;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pds-review-popcorn {
        flex-shrink: 0;
    }

    .pds-review-comment {
        font-size: 14px;
        line-height: 1.55;
        color: var(--pds-muted);
    }

    .pds-review-comment.is-empty {
        font-style: italic;
        color: var(--pds-dim);
    }

    .pds-review-meta {
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-dim);
        margin-top: auto;
    }

    .pds-empty {
        text-align: center;
        padding: 40px;
        color: var(--pds-muted);
        background: var(--pds-surface);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r);
    }

    /* Popcorn kernels for review cards */
    .popcorn-rating--small .popcorn-off {
        filter: grayscale(1);
        opacity: .35;
    }

    /* ===== Responsive ===== */
    @media (max-width: 900px) {
        .pds-reviews-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 768px) {
        .pds-hero-body {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .pds-hero-poster {
            width: 180px;
        }

        .pds-hero-title {
            font-size: 30px;
        }

        .pds-hero-meta,
        .pds-genres,
        .pds-hero-rating,
        .pds-ext-row {
            justify-content: center;
        }

        .rating-form-row {
            grid-template-columns: 1fr;
        }

        .pds-reviews-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block scripts %}
<script src="{{ applicationUrl }}/assets/js/popcorn.js?v={{ assetVersion }}"></script>
<script src="{{ applicationUrl }}/js/lightbox.js?v={{ assetVersion }}"></script>
{% endblock %}

{% block body %}
<div class="pds-root">

    {# ===== HERO ===== #}
    <div class="pds-hero">
        <div class="pds-hero-inner">
            <a href="{{ applicationUrl }}/" class="pds-back-link">
                <i class="bi bi-arrow-left"></i> {{ t('movie.back_to_home') }}
            </a>

            <div class="pds-hero-body">
                <div class="pds-hero-poster">
                    {% if movie.posterPath %}
                        <button type="button" class="poster-lightbox-trigger" data-poster-lightbox
                                data-poster-src="{{ movie.posterPath }}" data-poster-alt="{{ movie.title }}"
                                aria-label="{{ t('movie.enlarge_poster') }}">
                            <img id="moviePoster"
                                 src="{{ movie.posterPath }}"
                                 alt="{{ movie.title }}">
                        </button>
                    {% else %}
                        <div class="pds-hero-poster-placeholder">{{ movie.title }}</div>
                    {% endif %}
                </div>

                <div class="pds-hero-info">
                    <h1 class="pds-hero-title">{{ movie.title }}</h1>

                    <div class="pds-hero-meta">
                        {% set metaParts = [] %}
                        {% if movie.releaseDate %}{% set metaParts = metaParts|merge([movie.releaseDate|date('Y')]) %}{% endif %}
                        {% if movie.runtime %}{% set metaParts = metaParts|merge([movie.runtime]) %}{% endif %}
                        {% if movie.originalLanguage %}{% set metaParts = metaParts|merge([movie.originalLanguage]) %}{% endif %}
                        {% if directors and directors|length > 0 %}
                            {% set directorNames = [] %}
                            {% for d in directors %}{% if d.name %}{% set directorNames = directorNames|merge([d.name]) %}{% endif %}{% endfor %}
                            {% if directorNames|length > 0 %}
                                {% set metaParts = metaParts|merge([t('movie.director') ~ ': ' ~ directorNames|join(', ')]) %}
                            {% endif %}
                        {% endif %}
                        {% for part in metaParts %}
                            {% if not loop.first %}<span class="sep">·</span>{% endif %}
                            <span>{{ part }}</span>
                        {% endfor %}
                    </div>

                    {% if genres and genres|length > 0 %}
                        <div class="pds-genres">
                            {% for genre in genres %}
                                <span class="pds-genre-pill">{{ genre.name }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if movie.tagline %}
                        <p class="pds-tagline">"{{ movie.tagline }}"</p>
                    {% endif %}

                    {% if movie.overview %}
                        <p class="pds-overview">{{ movie.overview }}</p>
                    {% endif %}

                    <div class="pds-hero-rating">
                        {% include 'components/popcorn_rating.twig' with {
                            valueInt: displayPopcorn,
                            mode: 'display',
                            readonly: true
                        } %}
                        <span class="pds-hero-rating-stats">
                            {% if stats.rating_count > 0 %}
                                {{ stats.avg_popcorn|number_format(1) }} / 7 · {{ stats.rating_count }} {{ t('movie.ratings_count') }}
                            {% else %}
                                {{ t('movie.no_ratings_yet') }}
                            {% endif %}
                        </span>
                        <a href="{{ applicationUrl }}/faq#popcorn" class="pds-rating-help" title="{{ t('faq.popcorn_question') }}" aria-label="{{ t('faq.popcorn_question') }}">
                            <i class="bi bi-question-circle"></i>
                        </a>
                    </div>

                    {% set hasTmdb = movie.tmdbRatingAverage and movie.tmdbRatingAverage > 0 %}
                    {% set hasImdb = isOmdbEnabled and movie.imdbRatingAverage and movie.imdbRatingAverage > 0 %}
                    {% set hasRt = isOmdbEnabled and movie.rtRatingAverage and movie.rtRatingAverage > 0 %}
                    {% if hasTmdb or hasImdb or hasRt %}
                        <div class="pds-ext-row">
                            {% if hasTmdb %}
                                <div class="pds-ext-badge">
                                    <span class="pds-ext-label">TMDB</span>
                                    <span class="pds-ext-value">{{ movie.tmdbRatingAverage|number_format(1) }}</span>
                                    <span class="pds-ext-unit">/10</span>
                                </div>
                            {% endif %}
                            {% if hasImdb %}
                                <div class="pds-ext-badge">
                                    <span class="pds-ext-label">IMDB</span>
                                    <span class="pds-ext-value">{{ movie.imdbRatingAverage|number_format(1) }}</span>
                                    <span class="pds-ext-unit">/10</span>
                                </div>
                            {% endif %}
                            {% if hasRt %}
                                <div class="pds-ext-badge">
                                    <span class="pds-ext-label">Rotten Tomatoes</span>
                                    <span class="pds-ext-value">{{ movie.rtRatingAverage }}</span>
                                    <span class="pds-ext-unit">%</span>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="pds-main">

        {# ===== TMDB FACTS ===== #}
        {% set factStatus = tmdbFacts.status is defined ? tmdbFacts.status : null %}
        {% set factOriginalTitle = tmdbFacts.original_title is defined ? tmdbFacts.original_title : null %}
        {% set factBudget = tmdbFacts.budget is defined ? tmdbFacts.budget : null %}
        {% set factRevenue = tmdbFacts.revenue is defined ? tmdbFacts.revenue : null %}
        {% set companyNames = [] %}
        {% for c in productionCompanies %}{% if c.name %}{% set companyNames = companyNames|merge([c.name]) %}{% endif %}{% endfor %}
        {% set showOriginalTitle = factOriginalTitle and factOriginalTitle != movie.title %}
        {% set statusMap = {
            'Released': t('movie.status_released'),
            'Rumored': t('movie.status_rumored'),
            'Planned': t('movie.status_planned'),
            'In Production': t('movie.status_in_production'),
            'Post Production': t('movie.status_post_production'),
            'Canceled': t('movie.status_canceled')
        } %}
        <section>
            <div class="pds-facts-grid">
                <div class="pds-fact">
                    <div class="pds-fact-label">{{ t('movie.status') }}</div>
                    {% if factStatus %}
                        <div class="pds-fact-value">{{ statusMap[factStatus] ?? factStatus }}</div>
                    {% else %}
                        <div class="pds-fact-value pds-fact-value--empty">{{ t('movie.not_available') }}</div>
                    {% endif %}
                </div>
                {% if showOriginalTitle %}
                    <div class="pds-fact">
                        <div class="pds-fact-label">{{ t('movie.original_title') }}</div>
                        <div class="pds-fact-value">{{ factOriginalTitle }}</div>
                    </div>
                {% endif %}
                <div class="pds-fact">
                    <div class="pds-fact-label">{{ t('movie.budget') }}</div>
                    {% if factBudget and factBudget > 0 %}
                        <div class="pds-fact-value">${{ (factBudget / 1000000)|number_format(1, '.', ',') }} {{ t('movie.million_abbr') }}</div>
                    {% else %}
                        <div class="pds-fact-value pds-fact-value--empty">{{ t('movie.not_available') }}</div>
                    {% endif %}
                </div>
                <div class="pds-fact">
                    <div class="pds-fact-label">{{ t('movie.revenue') }}</div>
                    {% if factRevenue and factRevenue > 0 %}
                        <div class="pds-fact-value">${{ (factRevenue / 1000000)|number_format(1, '.', ',') }} {{ t('movie.million_abbr') }}</div>
                    {% else %}
                        <div class="pds-fact-value pds-fact-value--empty">{{ t('movie.not_available') }}</div>
                    {% endif %}
                </div>
                <div class="pds-fact">
                    <div class="pds-fact-label">{{ t('movie.production') }}</div>
                    {% if companyNames|length > 0 %}
                        <div class="pds-fact-value">{{ companyNames|join(', ') }}</div>
                    {% else %}
                        <div class="pds-fact-value pds-fact-value--empty">{{ t('movie.not_available') }}</div>
                    {% endif %}
                </div>
                <div class="pds-fact">
                    <div class="pds-fact-label">{{ t('movie.country') }}</div>
                    {% if productionCountries and productionCountries|length > 0 %}
                        <div class="pds-fact-value">{{ productionCountries|join(', ') }}</div>
                    {% else %}
                        <div class="pds-fact-value pds-fact-value--empty">{{ t('movie.not_available') }}</div>
                    {% endif %}
                </div>
            </div>
        </section>

        {# ===== CAST ===== #}
        {% if cast and cast|length > 0 %}
            <section>
                <div class="pds-section-head">
                    <div style="display: flex; align-items: baseline; gap: var(--pds-s-md);">
                        <h2 class="pds-section-title">{{ t('movie.cast') }}</h2>
                    </div>
                    <div class="pds-scroll-btns">
                        <button type="button" class="pds-scroll-btn" data-cast-scroll="-1" aria-label="{{ t('movie.cast_scroll_prev') }}" aria-controls="castScroll">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="pds-scroll-btn" data-cast-scroll="1" aria-label="{{ t('movie.cast_scroll_next') }}" aria-controls="castScroll">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="pds-cast-scroll" id="castScroll" role="region" aria-label="{{ t('movie.cast') }}" tabindex="0">
                    {% for member in cast %}
                        <div class="pds-cast-card">
                            <div class="pds-cast-photo">
                                {% if member.posterPath and '/images/placeholder/' not in member.posterPath %}
                                    <img src="{{ member.posterPath }}" alt="{{ member.name }}" loading="lazy">
                                {% else %}
                                    <div class="pds-cast-photo-empty">
                                        <div class="pds-cast-initials">
                                            {% set nameParts = member.name|trim|split(' ')|filter(p => p is not empty) %}
                                            {%- if nameParts|length > 0 -%}
                                                {{ nameParts|first|slice(0, 1)|upper }}{% if nameParts|length > 1 %}{{ nameParts|last|slice(0, 1)|upper }}{% endif %}
                                            {%- else -%}?{%- endif -%}
                                        </div>
                                        <div class="pds-cast-nophoto-hint">{{ t('movie.photo_via_tmdb') }}</div>
                                    </div>
                                {% endif %}
                            </div>
                            <div>
                                <div class="pds-cast-name">{{ member.name }}</div>
                                {% if member.characterName %}
                                    <div class="pds-cast-role">{{ member.characterName }}</div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {# ===== DEINE BEWERTUNG ===== #}
        {% if loggedIn %}
            <section class="pds-card">
                <div class="pds-card-head">
                    <h2 class="pds-card-title">{{ t('movie.your_rating') }}</h2>
                    <span class="pds-card-sub">
                        {{ userRating ? t('movie.update_rating') : t('movie.submit_rating') }}
                    </span>
                </div>
                <div class="pds-card-body">
                    <form action="{{ applicationUrl }}/movie/{{ movie.id }}/rate" method="post" id="ratingForm">
                        <div class="rating-form-row">
                            <div class="rating-form-col">
                                <span class="rating-form-label" id="ratingLabel">{{ t('movie.rating') }}</span>
                                {% include 'components/popcorn_rating.twig' with {
                                    valueInt: userRating.rating_popcorn ?? 0,
                                    mode: 'input',
                                    name: 'rating_popcorn',
                                    readonly: false,
                                    labelId: 'ratingLabel'
                                } %}
                            </div>

                            <fieldset class="rating-form-col">
                                <legend class="rating-form-label">{{ t('movie.watched_date') }}</legend>
                                <div class="date-dropdowns">
                                    <select name="watched_day" id="watched_day" class="day-select" aria-label="{{ t('movie.day') }}">
                                        <option value="">{{ t('movie.day') }}</option>
                                        {% for d in 1..31 %}
                                            <option value="{{ d }}" {{ (userRating.watched_day ?? '') == d ? 'selected' : '' }}>{{ d }}</option>
                                        {% endfor %}
                                    </select>
                                    <select name="watched_month" id="watched_month" class="month-select" aria-label="{{ t('movie.month') }}">
                                        <option value="">{{ t('movie.month') }}</option>
                                        {% set months = [t('movie.month_jan'), t('movie.month_feb'), t('movie.month_mar'), t('movie.month_apr'), t('movie.month_may'), t('movie.month_jun'), t('movie.month_jul'), t('movie.month_aug'), t('movie.month_sep'), t('movie.month_oct'), t('movie.month_nov'), t('movie.month_dec')] %}
                                        {% for m in 1..12 %}
                                            <option value="{{ m }}" {{ (userRating.watched_month ?? '') == m ? 'selected' : '' }}>{{ months[m - 1] }}</option>
                                        {% endfor %}
                                    </select>
                                    <select name="watched_year" id="watched_year" class="year-select" aria-label="{{ t('movie.year') }}">
                                        <option value="">{{ t('movie.year') }}</option>
                                        {% set currentYear = "now"|date("Y") + 1 %}
                                        {% for y in currentYear..1950 %}
                                            <option value="{{ y }}" {{ (userRating.watched_year ?? '') == y ? 'selected' : '' }}>{{ y }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </fieldset>

                            <div class="rating-form-col">
                                <label for="location_id">{{ t('movie.location') }}</label>
                                <select name="location_id" id="location_id" aria-describedby="location-status">
                                    <option value="">{{ t('movie.select_location') }}</option>
                                    <!-- Populated dynamically from database -->
                                </select>
                                <div id="location-status" aria-live="polite">
                                    <p id="no-locations-message" class="pds-field-hint" hidden>
                                        {% if currentUserIsAdmin %}
                                            {{ t('movie.no_locations_pre') }}<a href="{{ applicationUrl }}/admin/movies">{{ t('movie.admin_movies_link') }}</a>{{ t('movie.no_locations_post') }}
                                        {% else %}
                                            {{ t('movie.no_locations_user') }}
                                        {% endif %}
                                    </p>
                                    <p id="locations-error-message" class="pds-field-error" hidden>{{ t('movie.locations_load_failed') }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="rating-form-group">
                            <label for="comment">{{ t('movie.comment_optional') }}</label>
                            <textarea id="comment" name="comment" placeholder="{{ t('movie.comment_placeholder') }}">{{ userRating.comment ?? '' }}</textarea>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
                    </form>
                </div>
                <div class="pds-card-foot">
                    {% if userRating and (userRating.rating_popcorn or userRating.comment or userRating.watched_year or userRating.location_id) %}
                        <form action="{{ applicationUrl }}/movie/{{ movie.id }}/rate/delete" method="post" id="deleteRatingForm" class="d-inline">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
                            <button type="button" class="pds-btn pds-btn-danger" data-bs-toggle="modal" data-bs-target="#deleteRatingModal">
                                <i class="bi bi-trash" aria-hidden="true"></i> {{ t('movie.delete_rating') }}
                            </button>
                        </form>
                    {% endif %}
                    <button type="submit" form="ratingForm" class="pds-btn pds-btn-primary">
                        {{ userRating ? t('movie.update_rating') : t('movie.submit_rating') }}
                    </button>
                </div>
            </section>

            {% if userRating %}
                <div class="modal fade" id="deleteRatingModal" tabindex="-1" aria-labelledby="deleteRatingModalTitle" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="deleteRatingModalTitle">{{ t('movie.delete_rating') }}</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('common.close') }}"></button>
                            </div>
                            <div class="modal-body">{{ t('movie.delete_rating_confirm') }}</div>
                            <div class="modal-footer">
                                <button type="button" class="pds-btn pds-btn-secondary" data-bs-dismiss="modal">{{ t('common.cancel') }}</button>
                                <button type="submit" form="deleteRatingForm" class="pds-btn pds-btn-danger">{{ t('movie.delete_rating') }}</button>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <script>
            document.addEventListener('DOMContentLoaded', function() {
                const yearSelect = document.getElementById('watched_year');
                const monthSelect = document.getElementById('watched_month');
                const daySelect = document.getElementById('watched_day');
                const locationSelect = document.getElementById('location_id');

                function updateDateDropdowns() {
                    const year = yearSelect.value;
                    const month = monthSelect.value;

                    // Month requires year
                    if (!year) {
                        monthSelect.disabled = true;
                        monthSelect.value = '';
                        daySelect.disabled = true;
                        daySelect.value = '';
                    } else {
                        monthSelect.disabled = false;

                        // Day requires month
                        if (!month) {
                            daySelect.disabled = true;
                            daySelect.value = '';
                        } else {
                            daySelect.disabled = false;
                            updateDayOptions(parseInt(year), parseInt(month));
                        }
                    }
                }

                function updateDayOptions(year, month) {
                    const currentDay = daySelect.value;
                    const daysInMonth = new Date(year, month, 0).getDate();

                    // Clear options except first
                    while (daySelect.options.length > 1) {
                        daySelect.remove(1);
                    }

                    // Add day options
                    for (let d = 1; d <= daysInMonth; d++) {
                        const option = document.createElement('option');
                        option.value = d;
                        option.text = d;
                        if (d == currentDay) option.selected = true;
                        daySelect.add(option);
                    }

                    // Reset if current day exceeds max
                    if (currentDay && parseInt(currentDay) > daysInMonth) {
                        daySelect.value = '';
                    }
                }

                // Load locations from database
                async function loadLocations() {
                    const noLocationsMessage = document.getElementById('no-locations-message');
                    const errorMessage = document.getElementById('locations-error-message');

                    function showLoadError() {
                        errorMessage.hidden = false;
                        locationSelect.setAttribute('aria-invalid', 'true');
                    }

                    try {
                        const response = await fetch('{{ applicationUrl }}/old/settings/locations');
                        if (!response.ok) {
                            showLoadError();
                            return;
                        }

                        const locations = await response.json();
                        const currentLocationId = {{ userRating.location_id ?? 'null' }};

                        // Clear existing options except the first (placeholder)
                        while (locationSelect.options.length > 1) {
                            locationSelect.remove(1);
                        }

                        // Show message if no locations available
                        if (locations.length === 0) {
                            noLocationsMessage.hidden = false;
                            locationSelect.disabled = true;
                        } else {
                            noLocationsMessage.hidden = true;
                            locationSelect.disabled = false;

                            // Populate with locations from database
                            locations.forEach(location => {
                                const option = document.createElement('option');
                                option.value = location.id;
                                option.text = location.name;
                                if (currentLocationId && currentLocationId === location.id) {
                                    option.selected = true;
                                }
                                locationSelect.add(option);
                            });
                        }
                    } catch (error) {
                        showLoadError();
                    }
                }

                yearSelect.addEventListener('change', updateDateDropdowns);
                monthSelect.addEventListener('change', updateDateDropdowns);

                // Initialize state
                updateDateDropdowns();
                loadLocations();
            });
            </script>
        {% endif %}

        {# ===== EINZELBEWERTUNGEN ===== #}
        <section id="ratings">
            <div class="pds-section-head">
                <div style="display: flex; align-items: baseline; gap: var(--pds-s-md);">
                    <h2 class="pds-section-title">{{ t('movie.individual_ratings') }}</h2>
                    {% if individualRatings|length > 0 %}
                        <span class="pds-section-count">{{ individualRatings|length }}</span>
                    {% endif %}
                </div>
            </div>

            {% if individualRatings|length > 0 %}
                <div class="pds-reviews-grid">
                    {% for rating in individualRatings %}
                        <div class="pds-review">
                            <div class="pds-review-head">
                                <span class="pds-review-user">{{ rating.user_name }}</span>
                                <div class="pds-review-popcorn">
                                    {% if rating.rating_popcorn %}
                                        <div class="popcorn-rating popcorn-rating--small" aria-label="{{ t('movie.rating') }}: {{ rating.rating_popcorn }} {{ t('movie.out_of') }} 7">
                                            {% for i in 1..7 %}
                                                <span class="popcorn-rating__item {{ i <= rating.rating_popcorn ? 'popcorn-on' : 'popcorn-off' }}" aria-hidden="true">🍿</span>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <span class="pds-card-sub">{{ t('movie.unrated') }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            {% if rating.comment %}
                                <p class="pds-review-comment">"{{ rating.comment }}"</p>
                            {% else %}
                                <p class="pds-review-comment is-empty">{{ t('movie.rated_without_comment') }}</p>
                            {% endif %}

                            {% set metaBits = [] %}
                            {% if rating.watched_year %}
                                {% if rating.watched_day and rating.watched_month %}
                                    {% set metaBits = metaBits|merge(['%02d.%02d.%s'|format(rating.watched_day, rating.watched_month, rating.watched_year)]) %}
                                {% elseif rating.watched_month %}
                                    {% set metaBits = metaBits|merge(['%02d.%s'|format(rating.watched_month, rating.watched_year)]) %}
                                {% else %}
                                    {% set metaBits = metaBits|merge([rating.watched_year]) %}
                                {% endif %}
                            {% endif %}
                            {% if rating.location_name %}
                                {% set metaBits = metaBits|merge([rating.location_name]) %}
                            {% endif %}
                            {% if metaBits|length > 0 %}
                                <div class="pds-review-meta">{{ metaBits|join(' · ') }}</div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="pds-empty no-ratings-message">
                    <p>{{ t('movie.no_individual_ratings') }}</p>
                    {% if not loggedIn %}
                        <a href="{{ applicationUrl }}/login" class="pds-btn pds-btn-primary" style="margin-top: 0.5rem;">
                            {{ t('movie.login_to_rate') }}
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </section>
    </div>

    {# Poster Lightbox #}
    <div id="posterLightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="{{ t('movie.poster_dialog') }}" hidden>
        <button type="button" class="lightbox-close" aria-label="{{ t('movie.close') }}">&times;</button>
        <img id="posterLightboxImage" src="" alt="{{ t('movie.poster_alt') }}" class="lightbox-image">
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const castScroll = document.getElementById('castScroll');
        if (castScroll) {
            document.querySelectorAll('[data-cast-scroll]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const dir = parseInt(btn.getAttribute('data-cast-scroll'), 10);
                    castScroll.scrollBy({ left: dir * 320, behavior: 'smooth' });
                });
            });
        }
    });
    </script>
</div>
{% endblock %}
