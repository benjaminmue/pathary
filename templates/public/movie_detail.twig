{% extends 'layouts/public_base.twig' %}

{% block title %}{{ movie.title }}{% endblock %}

{% block stylesheets %}
<style>
    .movie-hero {
        padding: 2rem 0;
    }

    .movie-header {
        display: flex;
        gap: 2rem;
        align-items: flex-start;
    }

    .movie-poster {
        flex-shrink: 0;
        width: 200px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .movie-poster img {
        width: 100%;
        height: auto;
        display: block;
    }

    .movie-poster-placeholder {
        width: 100%;
        aspect-ratio: 2/3;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--pathe-dark) 0%, #3a3a3a 100%);
        color: #888;
        font-size: 0.875rem;
        text-align: center;
        padding: 1rem;
    }

    .movie-info {
        flex: 1;
        min-width: 0;
    }

    .movie-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--bs-body-color);
    }

    .movie-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        margin-bottom: 1rem;
        color: var(--bs-secondary-color);
        font-size: 0.9rem;
    }

    .movie-genres {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .genre-badge {
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.8rem;
    }

    .movie-synopsis {
        margin-bottom: 2rem;
    }

    .movie-synopsis h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .movie-synopsis p {
        color: var(--bs-secondary-color);
        line-height: 1.7;
    }

    /* External Ratings Section */
    .external-ratings-section {
        background: var(--bs-tertiary-bg);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .external-ratings-section h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .external-ratings-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    /* Single column layout when OMDb is not configured */
    .external-ratings-grid-single {
        grid-template-columns: 1fr;
        max-width: 400px;
        margin: 0 auto;
    }

    .external-rating-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 1rem;
        background: var(--bs-body-bg);
        border-radius: 8px;
        border: 1px solid var(--bs-border-color);
    }

    .external-rating-logo {
        height: 2.5rem;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
    }

    .external-rating-logo img.rating-logo {
        max-height: 2rem;
        max-width: 100%;
        width: auto;
        height: auto;
    }

    .external-rating-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--bs-secondary-color);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .external-rating-score {
        font-size: 2rem;
        font-weight: 700;
        color: var(--pathe-yellow);
        line-height: 1;
    }

    .external-rating-max {
        font-size: 1rem;
        color: var(--bs-secondary-color);
        margin-bottom: 0.25rem;
    }

    .external-rating-votes {
        font-size: 0.75rem;
        color: var(--bs-tertiary-color);
    }

    .external-rating-na {
        font-size: 1.5rem;
        color: var(--bs-secondary-color);
        font-weight: 500;
        margin-top: 0.5rem;
    }

    .external-rating-note {
        font-size: 0.7rem;
        color: var(--bs-tertiary-color);
        margin-top: 0.25rem;
        font-style: italic;
    }

    @media (max-width: 768px) {
        .external-ratings-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    /* Global Rating Section */
    .global-rating-section {
        background: var(--bs-tertiary-bg);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .global-rating-section h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .global-rating-display {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .global-rating-stats {
        color: var(--bs-secondary-color);
        font-size: 0.9rem;
    }

    /* Individual Ratings Section */
    .individual-ratings-section {
        margin-bottom: 2rem;
    }

    .individual-ratings-section h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .rating-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }

    .rating-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 8px;
        padding: 1rem;
    }

    .rating-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.75rem;
    }

    .rating-user-name {
        font-weight: 600;
        font-size: 1rem;
    }

    .rating-user-popcorn {
        display: flex;
        align-items: center;
    }

    .rating-unrated {
        color: var(--bs-secondary-color);
        font-size: 0.85rem;
        font-style: italic;
    }

    .rating-comment {
        color: var(--bs-secondary-color);
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 0.5rem;
    }

    .rating-date {
        font-size: 0.75rem;
        color: var(--bs-tertiary-color);
    }

    .rating-meta {
        display: flex;
        gap: 1rem;
        margin-bottom: 0.5rem;
        font-size: 0.8rem;
        color: var(--bs-secondary-color);
    }

    .rating-meta i {
        margin-right: 0.25rem;
        opacity: 0.7;
    }

    .rating-watched-date,
    .rating-location {
        display: flex;
        align-items: center;
    }

    .no-ratings-message {
        text-align: center;
        padding: 2rem;
        color: var(--bs-secondary-color);
    }

    /* Rating Form */
    .rating-form-section {
        background: var(--bs-tertiary-bg);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .rating-form-section h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .rating-form-row {
        display: flex;
        gap: 0;
        margin-bottom: 1rem;
    }

    .rating-form-col {
        flex: 1;
        padding: 0 1rem;
        display: flex;
        flex-direction: column;
    }

    .rating-form-col:first-child {
        padding-left: 0;
    }

    .rating-form-col:last-child {
        padding-right: 0;
    }

    .rating-form-divider {
        width: 2px;
        background: linear-gradient(180deg, transparent, var(--accent-purple), transparent);
        box-shadow: 0 0 8px rgba(111, 45, 189, 0.3);
        flex-shrink: 0;
    }

    .rating-form-col label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .rating-form-col select {
        width: 100%;
        padding: 0.5rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 6px;
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        font-size: 0.85rem;
        cursor: pointer;
    }

    .rating-form-col select:focus {
        outline: none;
        border-color: var(--accent-purple);
        box-shadow: 0 0 0 3px rgba(111, 45, 189, 0.1);
    }

    .rating-form-col select:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .date-dropdowns {
        display: flex;
        gap: 0.5rem;
    }

    .date-dropdowns select {
        flex: 1;
    }

    .date-dropdowns select.day-select {
        flex: 0.8;
    }

    .date-dropdowns select.month-select {
        flex: 1.2;
    }

    .date-dropdowns select.year-select {
        flex: 1;
    }

    .rating-form-group {
        margin-bottom: 1rem;
    }

    .rating-form-group label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .rating-form-group textarea {
        width: 100%;
        min-height: 100px;
        padding: 0.75rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 8px;
        background: var(--bs-body-bg);
        color: var(--bs-body-color);
        font-family: inherit;
        font-size: 0.9rem;
        resize: vertical;
    }

    .rating-form-group textarea:focus {
        outline: none;
        border-color: var(--accent-purple);
        box-shadow: 0 0 0 3px rgba(111, 45, 189, 0.1);
    }

    .rating-form-actions {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .btn-submit-rating {
        background: var(--pathe-yellow);
        border-color: var(--pathe-yellow);
        color: var(--pathe-dark);
        font-weight: 600;
        padding: 0.5rem 1.5rem;
    }

    .btn-submit-rating:hover {
        background: #e0a808;
        border-color: #e0a808;
        color: var(--pathe-dark);
    }

    @media (max-width: 768px) {
        .rating-form-row {
            flex-direction: column;
            gap: 1rem;
        }

        .rating-form-col {
            padding: 0;
        }

        .rating-form-divider {
            display: none;
        }
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--bs-secondary-color);
        text-decoration: none;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .back-link:hover {
        color: var(--accent-purple);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .movie-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .movie-poster {
            width: 160px;
        }

        .movie-title {
            font-size: 1.5rem;
        }

        .movie-meta {
            justify-content: center;
        }

        .movie-genres {
            justify-content: center;
        }

        .global-rating-display {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .rating-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block scripts %}
<script src="{{ applicationUrl }}/assets/js/popcorn.js"></script>
{% endblock %}

{% block body %}
<div class="container">
    <a href="{{ applicationUrl }}/" class="back-link">
        <i class="bi bi-arrow-left"></i> Back to Home
    </a>

    <div class="movie-hero">
        <div class="movie-header">
            <div class="movie-poster">
                {% if movie.posterPath %}
                    <img src="{{ movie.posterPath }}" alt="{{ movie.title }}">
                {% else %}
                    <div class="movie-poster-placeholder">
                        {{ movie.title }}
                    </div>
                {% endif %}
            </div>

            <div class="movie-info">
                <h1 class="movie-title">{{ movie.title }}</h1>

                <div class="movie-meta">
                    {% if movie.releaseDate %}
                        <span>{{ movie.releaseDate|date('Y') }}</span>
                    {% endif %}
                    {% if movie.runtime %}
                        <span>{{ movie.runtime }}</span>
                    {% endif %}
                    {% if movie.originalLanguage %}
                        <span>{{ movie.originalLanguage }}</span>
                    {% endif %}
                </div>

                {% if genres and genres|length > 0 %}
                    <div class="movie-genres">
                        {% for genre in genres %}
                            <span class="genre-badge">{{ genre.name }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if movie.tagline %}
                    <p class="text-muted fst-italic mb-3">"{{ movie.tagline }}"</p>
                {% endif %}
            </div>
        </div>
    </div>

    {% if movie.overview %}
        <section class="movie-synopsis">
            <h2>Synopsis</h2>
            <p>{{ movie.overview }}</p>
        </section>
    {% endif %}

    {# External Ratings Section #}
    <section class="external-ratings-section">
        <h2>External Ratings</h2>
        <div class="external-ratings-grid{% if not isOmdbEnabled %} external-ratings-grid-single{% endif %}">
            {# TMDB Rating #}
            <div class="external-rating-item">
                <div class="external-rating-logo">
                    <img src="{{ applicationUrl }}/images/tmdb-logo.svg" alt="TMDB" class="rating-logo">
                </div>
                <div class="external-rating-label">TMDB</div>
                {% if movie.tmdbRatingAverage and movie.tmdbRatingAverage > 0 %}
                    <div>
                        <span class="external-rating-score" style="display: inline;">{{ movie.tmdbRatingAverage|number_format(1) }}</span><span class="external-rating-max" style="display: inline;">/10</span>
                    </div>
                {% else %}
                    <div class="external-rating-na">N/A</div>
                {% endif %}
            </div>

            {% if isOmdbEnabled %}
            {# IMDb Rating #}
            <div class="external-rating-item">
                <div class="external-rating-logo">
                    <img src="{{ applicationUrl }}/images/imdb-logo.svg" alt="IMDb" class="rating-logo">
                </div>
                <div class="external-rating-label">IMDb</div>
                {% if movie.imdbRatingAverage and movie.imdbRatingAverage > 0 %}
                    <div>
                        <span class="external-rating-score" style="display: inline;">{{ movie.imdbRatingAverage|number_format(1) }}</span><span class="external-rating-max" style="display: inline;">/10</span>
                    </div>
                {% else %}
                    <div class="external-rating-na">N/A</div>
                {% endif %}
            </div>

            {# Rotten Tomatoes Rating #}
            <div class="external-rating-item">
                <div class="external-rating-logo">
                    <img src="{{ applicationUrl }}/images/rt-logo.svg" alt="Rotten Tomatoes" class="rating-logo">
                </div>
                <div class="external-rating-label">Rotten Tomatoes</div>
                {% if movie.rtRatingAverage and movie.rtRatingAverage > 0 %}
                    <div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        {% if movie.rtRatingAverage >= 60 %}
                            <img src="{{ applicationUrl }}/images/rt-fresh-icon.svg" alt="Fresh" style="width: 1.5rem; height: 1.5rem;">
                        {% else %}
                            <img src="{{ applicationUrl }}/images/rt-rotten-icon.svg" alt="Rotten" style="width: 1.5rem; height: 1.5rem;">
                        {% endif %}
                        <div>
                            <span class="external-rating-score" style="display: inline;">{{ movie.rtRatingAverage }}</span><span class="external-rating-max" style="display: inline;">%</span>
                        </div>
                    </div>
                {% else %}
                    <div class="external-rating-na">N/A</div>
                {% endif %}
            </div>
            {% endif %}{# End isOmdbEnabled #}
        </div>
    </section>

    <section class="global-rating-section">
        <h2>Community Rating</h2>
        <div class="global-rating-display">
            {% include 'components/popcorn_rating.twig' with {
                valueInt: displayPopcorn,
                mode: 'display',
                readonly: true
            } %}
            <div class="global-rating-stats">
                {% if stats.rating_count > 0 %}
                    avg: {{ stats.avg_popcorn|number_format(1) }} / 7
                    ({{ stats.rating_count }} rating{{ stats.rating_count != 1 ? 's' : '' }})
                {% else %}
                    No ratings yet
                {% endif %}
            </div>
        </div>
    </section>

    {% if loggedIn %}
        <section class="rating-form-section">
            <h2>Your Rating</h2>
            <form action="{{ applicationUrl }}/movie/{{ movie.id }}/rate" method="post" id="ratingForm">
                <div class="rating-form-row">
                    <div class="rating-form-col">
                        <label>Rating</label>
                        {% include 'components/popcorn_rating.twig' with {
                            valueInt: userRating.rating_popcorn ?? 0,
                            mode: 'input',
                            name: 'rating_popcorn',
                            readonly: false
                        } %}
                    </div>

                    <div class="rating-form-divider"></div>

                    <div class="rating-form-col">
                        <label>Watched Date</label>
                        <div class="date-dropdowns">
                            <select name="watched_day" id="watched_day" class="day-select">
                                <option value="">Day</option>
                                {% for d in 1..31 %}
                                    <option value="{{ d }}" {{ (userRating.watched_day ?? '') == d ? 'selected' : '' }}>{{ d }}</option>
                                {% endfor %}
                            </select>
                            <select name="watched_month" id="watched_month" class="month-select">
                                <option value="">Month</option>
                                {% set months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'] %}
                                {% for m in 1..12 %}
                                    <option value="{{ m }}" {{ (userRating.watched_month ?? '') == m ? 'selected' : '' }}>{{ months[m - 1] }}</option>
                                {% endfor %}
                            </select>
                            <select name="watched_year" id="watched_year" class="year-select">
                                <option value="">Year</option>
                                {% set currentYear = "now"|date("Y") + 1 %}
                                {% for y in currentYear..1950 %}
                                    <option value="{{ y }}" {{ (userRating.watched_year ?? '') == y ? 'selected' : '' }}>{{ y }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="rating-form-divider"></div>

                    <div class="rating-form-col">
                        <label>Location</label>
                        <select name="location_id" id="location_id">
                            <option value="">Select location</option>
                            <!-- Populated dynamically from database -->
                        </select>
                        <div id="no-locations-message" class="alert alert-info" style="display: none; margin-top: 0.5rem; font-size: 0.875rem;">
                            No locations have been set up. Ask an admin to navigate to <a href="{{ applicationUrl }}/admin/movies" class="alert-link">Admin → Movies</a> to add custom locations.
                        </div>
                    </div>
                </div>

                <div class="rating-form-group">
                    <label for="comment">Comment (optional)</label>
                    <textarea id="comment" name="comment" placeholder="Share your thoughts about this movie...">{{ userRating.comment ?? '' }}</textarea>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">

                <div class="rating-form-actions">
                    <button type="submit" class="btn btn-submit-rating">
                        {{ userRating ? 'Update Rating' : 'Submit Rating' }}
                    </button>
                </div>
            </form>

            {% if userRating and (userRating.rating_popcorn or userRating.comment or userRating.watched_year or userRating.location_id) %}
                <hr class="my-3">
                <form action="{{ applicationUrl }}/movie/{{ movie.id }}/rate/delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete your rating? This action cannot be undone.');">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete Rating
                    </button>
                </form>
            {% endif %}
        </section>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            const yearSelect = document.getElementById('watched_year');
            const monthSelect = document.getElementById('watched_month');
            const daySelect = document.getElementById('watched_day');
            const locationSelect = document.getElementById('location_id');

            function updateDateDropdowns() {
                const year = yearSelect.value;
                const month = monthSelect.value;

                // Month requires year
                if (!year) {
                    monthSelect.disabled = true;
                    monthSelect.value = '';
                    daySelect.disabled = true;
                    daySelect.value = '';
                } else {
                    monthSelect.disabled = false;

                    // Day requires month
                    if (!month) {
                        daySelect.disabled = true;
                        daySelect.value = '';
                    } else {
                        daySelect.disabled = false;
                        updateDayOptions(parseInt(year), parseInt(month));
                    }
                }
            }

            function updateDayOptions(year, month) {
                const currentDay = daySelect.value;
                const daysInMonth = new Date(year, month, 0).getDate();

                // Clear options except first
                while (daySelect.options.length > 1) {
                    daySelect.remove(1);
                }

                // Add day options
                for (let d = 1; d <= daysInMonth; d++) {
                    const option = document.createElement('option');
                    option.value = d;
                    option.text = d;
                    if (d == currentDay) option.selected = true;
                    daySelect.add(option);
                }

                // Reset if current day exceeds max
                if (currentDay && parseInt(currentDay) > daysInMonth) {
                    daySelect.value = '';
                }
            }

            // Load locations from database
            async function loadLocations() {
                const noLocationsMessage = document.getElementById('no-locations-message');

                try {
                    const response = await fetch('{{ applicationUrl }}/old/settings/locations');
                    if (!response.ok) {
                        console.error('Failed to load locations');
                        return;
                    }

                    const locations = await response.json();
                    const currentLocationId = {{ userRating.location_id ?? 'null' }};

                    // Clear existing options except the first (placeholder)
                    while (locationSelect.options.length > 1) {
                        locationSelect.remove(1);
                    }

                    // Show message if no locations available
                    if (locations.length === 0) {
                        noLocationsMessage.style.display = 'block';
                        locationSelect.disabled = true;
                    } else {
                        noLocationsMessage.style.display = 'none';
                        locationSelect.disabled = false;

                        // Populate with locations from database
                        locations.forEach(location => {
                            const option = document.createElement('option');
                            option.value = location.id;
                            option.text = location.name;
                            if (currentLocationId && currentLocationId === location.id) {
                                option.selected = true;
                            }
                            locationSelect.add(option);
                        });
                    }
                } catch (error) {
                    console.error('Error loading locations:', error);
                }
            }

            yearSelect.addEventListener('change', updateDateDropdowns);
            monthSelect.addEventListener('change', updateDateDropdowns);

            // Initialize state
            updateDateDropdowns();
            loadLocations();
        });
        </script>
    {% endif %}

    <section id="ratings" class="individual-ratings-section">
        <h2>Individual Ratings</h2>

        {% if individualRatings|length > 0 %}
            <div class="rating-cards">
                {% for rating in individualRatings %}
                    <div class="rating-card">
                        <div class="rating-card-header">
                            <span class="rating-user-name">{{ rating.user_name }}</span>

                            <div class="rating-user-popcorn">
                                {% if rating.rating_popcorn %}
                                    <div class="popcorn-rating popcorn-rating--small" aria-label="Rating: {{ rating.rating_popcorn }} out of 7">
                                        {% for i in 1..7 %}
                                            <span class="popcorn-rating__item {{ i <= rating.rating_popcorn ? 'popcorn-on' : 'popcorn-off' }}" aria-hidden="true">🍿</span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="rating-unrated">Unrated</span>
                                {% endif %}
                            </div>
                        </div>

                        {% if rating.comment %}
                            <p class="rating-comment">"{{ rating.comment }}"</p>
                        {% endif %}

                        <div class="rating-meta">
                            {% if rating.watched_year %}
                                <span class="rating-watched-date">
                                    <i class="bi bi-calendar-event"></i>
                                    {% if rating.watched_day and rating.watched_month %}
                                        {{ '%02d'|format(rating.watched_day) }}.{{ '%02d'|format(rating.watched_month) }}.{{ rating.watched_year }}
                                    {% elseif rating.watched_month %}
                                        {{ '%02d'|format(rating.watched_month) }}.{{ rating.watched_year }}
                                    {% else %}
                                        {{ rating.watched_year }}
                                    {% endif %}
                                </span>
                            {% endif %}

                            {% if rating.location_name %}
                                <span class="rating-location">
                                    <i class="bi bi-geo-alt"></i>
                                    {{ rating.location_name }}
                                </span>
                            {% endif %}
                        </div>

                        {% if rating.updated_at %}
                            <div class="rating-date">
                                Last update: {{ rating.updated_at|date('Y-m-d') }}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="no-ratings-message">
                <p>No individual ratings yet. Be the first to rate this movie!</p>
                {% if not loggedIn %}
                    <a href="{{ applicationUrl }}/login" class="btn btn-warning mt-2" style="background-color: var(--pathe-yellow); border-color: var(--pathe-yellow); color: var(--pathe-dark);">
                        Login to Rate
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
