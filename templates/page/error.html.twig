{% extends 'layouts/error_base.twig' %}

{% block title %}
    {% if statusCode == 404 %}
        {{ t('error.heading_404') }}
    {% elseif statusCode == 401 %}
        {{ t('error.heading_401') }}
    {% elseif statusCode == 403 %}
        {{ t('error.heading_403') }}
    {% elseif statusCode == 500 %}
        {{ t('error.title_500') }}
    {% else %}
        {{ t('error.error_prefix') }} {{ statusCode }}
    {% endif %}
{% endblock %}

{% block body %}
    <div class="error-container">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 text-center">
                    {# Subtle logo watermark #}
                    <img src="{{ applicationUrl }}/images/pathary-logo.svg" alt="" class="error-logo">

                    {# Error code #}
                    <div class="error-code">{{ statusCode }}</div>

                    {# Dynamic title based on status code #}
                    <h1 class="error-title">
                        {% if statusCode == 404 %}
                            {{ t('error.heading_404') }}
                        {% elseif statusCode == 401 %}
                            {{ t('error.heading_401') }}
                        {% elseif statusCode == 403 %}
                            {{ t('error.heading_403') }}
                        {% elseif statusCode == 500 %}
                            {{ t('error.heading_500') }}
                        {% else %}
                            {{ t('error.heading_generic') }}
                        {% endif %}
                    </h1>

                    {# Dynamic message based on status code #}
                    <p class="error-message">
                        {% if statusCode == 404 %}
                            {{ t('error.message_404') }}
                        {% elseif statusCode == 401 %}
                            {{ t('error.message_401') }}
                        {% elseif statusCode == 403 %}
                            {{ t('error.message_403') }}
                        {% elseif statusCode == 500 %}
                            {{ t('error.message_500') }}
                        {% else %}
                            {{ t('error.message_generic') }}
                        {% endif %}
                    </p>

                    {# Dynamic actions based on status code #}
                    <div class="error-actions">
                        {% if statusCode == 404 %}
                            {% if referer and referer != currentUrl %}
                                <a href="{{ referer }}" class="btn btn-error-secondary">
                                    <i class="bi bi-arrow-left"></i>{{ t('error.go_back') }}
                                </a>
                            {% endif %}
                            {% if isAuthenticated %}
                                <a href="{{ applicationUrl }}/search" class="btn btn-error-primary">
                                    <i class="bi bi-search"></i>{{ t('error.search_movies') }}
                                </a>
                            {% else %}
                                <a href="{{ applicationUrl }}/" class="btn btn-error-primary">
                                    <i class="bi bi-house"></i>{{ t('error.go_home') }}
                                </a>
                            {% endif %}

                        {% elseif statusCode == 401 %}
                            <a href="{{ applicationUrl }}/login{% if currentUrl %}?redirect={{ currentUrl|url_encode }}{% endif %}" class="btn btn-error-primary">
                                <i class="bi bi-box-arrow-in-right"></i>{{ t('error.go_to_login') }}
                            </a>

                        {% elseif statusCode == 403 %}
                            {% if isAuthenticated %}
                                <a href="{{ applicationUrl }}/profile" class="btn btn-error-primary">
                                    <i class="bi bi-person"></i>{{ t('error.go_to_profile') }}
                                </a>
                            {% else %}
                                <a href="{{ applicationUrl }}/" class="btn btn-error-primary">
                                    <i class="bi bi-house"></i>{{ t('error.go_home') }}
                                </a>
                            {% endif %}

                        {% elseif statusCode == 500 %}
                            {% if referer and referer != currentUrl %}
                                <a href="{{ referer }}" class="btn btn-error-secondary">
                                    <i class="bi bi-arrow-clockwise"></i>{{ t('error.try_again') }}
                                </a>
                            {% endif %}
                            <a href="{{ applicationUrl }}/" class="btn btn-error-primary">
                                <i class="bi bi-house"></i>{{ t('error.go_home') }}
                            </a>

                        {% else %}
                            <a href="{{ applicationUrl }}/" class="btn btn-error-primary">
                                <i class="bi bi-house"></i>{{ t('error.go_home') }}
                            </a>
                        {% endif %}

                        {# Always show report issue link #}
                        {% set issueTitle = "Error " ~ statusCode ~ " encountered" %}
                        {% set issueBody %}
**Error Details:**
- **Error Code:** {{ statusCode }}
- **Page:** `{{ currentUrl }}`
{% if referer and referer != currentUrl %}
- **Previous Page:** `{{ referer }}`
{% endif %}
- **Timestamp:** {{ "now"|date("Y-m-d H:i:s") }}

**What I was trying to do:**
<!-- Please describe what you were trying to do when this error occurred -->

**Expected behavior:**
<!-- What did you expect to happen? -->

**Additional context:**
<!-- Add any other context about the problem here -->
                        {% endset %}
                        <a href="https://github.com/benjaminmue/pathary/issues/new?title={{ issueTitle|url_encode }}&body={{ issueBody|url_encode }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-bug"></i>{{ t('error.report_issue') }}
                        </a>
                    </div>

                    {# Error metadata #}
                    <div class="error-meta">
                        <span class="error-meta-item">
                            <strong>{{ t('error.meta_error_code') }}</strong> {{ statusCode }}
                        </span>
                        {% if currentUrl %}
                        <span class="error-meta-item">
                            <strong>{{ t('error.meta_path') }}</strong> {{ currentUrl }}
                        </span>
                        {% endif %}
                        <span class="error-meta-item">
                            <strong>{{ t('error.meta_time') }}</strong> <span id="error-timestamp"></span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Display current timestamp
        document.getElementById('error-timestamp').textContent = new Date().toLocaleTimeString();
    </script>
{% endblock %}
