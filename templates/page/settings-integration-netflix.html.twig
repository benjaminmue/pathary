{% extends 'base.html.twig' %}

{% block title %}
    {{ t('integrations.settings') }} - Netflix
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-integration-netflix.js"></script>
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
    <link href="{{ applicationUrl }}/css/netflix.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}
        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5>{{ t('integration_netflix.import_heading') }}</h5>
                <div class="alert alert-secondary" role="alert" style="padding-top: 0.5rem;padding-bottom: 0.5rem">
                    <b>{{ t('integration_netflix.download_heading') }}</b>
                    <br/>
                    {{ t('integration_netflix.step_goto_pre') }} <a href="https://www.netflix.com/settings/viewed">https://www.netflix.com/settings/viewed</a> {{ t('integration_netflix.step_goto_post') }}
                    <br/>
                    {{ t('integration_netflix.step_upload') }}
                    <br>
                    {{ t('integration_netflix.step_populate') }}
                    <br>
                    {{ t('integration_netflix.step_import') }}
                </div>

                <div class="mb-3">
                    <label class="form-label" for="netflixCsvInput">{{ t('integration_netflix.upload_label') }}</label>
                    <input id="netflixCsvInput" class="form-control" accept="text/csv" name="csvinput" type="file" required="required"/>
                </div>
                <div class="input-group" style="margin-bottom: 1rem">
                    <span class="input-group-text">{{ t('integration_netflix.csv_date_format') }}</span>
                    <input id="netflixCsvDateFormatInput" class="form-control" placeholder="{{ t('integration_netflix.date_format_placeholder') }}" name="csvDateFormat" type="text" required="required"/>
                    <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#csvDateFormatHelpModal">
                        <i class="bi bi-question-lg"></i>
                    </button>
                </div>

                <div class="d-none" role="alert" id="netflixCsvUploadAlert"></div>
                <button class="btn btn-primary" name="button" onclick="uploadNetflixHistory()" type="button" id="netflixCsvUploadButton" disabled>
                    {{ t('integration_netflix.upload_csv_btn') }}
                </button>

                <hr>

                <div class="input-group mb-3">
                    <label for="selectFilterInput" class="input-group-text">{{ t('integration_netflix.filter_label') }}</label>
                    <select id="selectFilterInput" onchange="updateTable()" class="form-select" disabled>
                        <option value="all">{{ t('integration_netflix.filter_all') }}</option>
                        <option value="notfound">{{ t('integration_netflix.filter_notfound') }}</option>
                    </select>
                    <label for="amountToShowInput" class="input-group-text">{{ t('integration_netflix.per_page') }}</label>
                    <select id="amountToShowInput" onchange="updateTable()" class="form-select" disabled>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="all">{{ t('integration_netflix.filter_all') }}</option>
                    </select>
                </div>
                <div class="input-group mb-3">
                    <label for="searchInput" class="input-group-text">{{ t('integration_netflix.search_table') }}</label>
                    <input type="text" class="form-control disabled" onkeyup="searchTable()" id="searchInput" disabled/>
                </div>

                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">{{ t('integration_netflix.col_date_watched') }}</th>
                        <th scope="col">{{ t('integration_netflix.col_netflix_name') }}</th>
                        <th scope="col">{{ t('integration_netflix.col_tmdb_item') }}</th>
                    </tr>
                    </thead>
                    <tbody id="netflixTableBody">
                    <tr>
                        <td colspan="4">{{ t('integration_netflix.waiting_csv') }}</td>
                    </tr>
                    </tbody>
                </table>

                <nav aria-label="{{ t('integration_netflix.page_navigation') }}">
                    <ul class="pagination align-self-center justify-content-center">
                        <li class="page-item disabled"><a class="page-link" style="cursor: pointer">{{ t('integration_netflix.previous') }}</a></li>
                        <li class="page-item disabled"><a class="page-link">#</a></li>
                        <li class="page-item disabled"><a class="page-link" style="cursor: pointer">{{ t('integration_netflix.next') }}</a></li>
                    </ul>
                </nav>

                <div class="d-none" role="alert" id="importAlert"></div>

                <button type="button"
                        class="btn btn-primary disabled mb-3"
                        id="importNetflixButton"
                        onclick="importNetflixHistory();"
                        disabled>
                    {{ t('integration_netflix.import_data_btn') }}
                </button>
            </div>
        </div>
    </main>

    <!-- Modal to search for other TMDB items -->
    <div class="modal fade modal-lg" id="tmdbSearchModal" tabindex="-1" role="dialog" aria-labelledby="tmdbSearchModalTitle" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tmdbSearchModalTitle">{{ t('integration_netflix.replace_movie_title') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <label for="searchtmdb" class="form-label">{{ t('integration_netflix.search_better_match') }}</label>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" name="searchtmdb" id="tmdbSearchModalInput">
                            <button class="btn btn-success" type="button" onclick="searchTMDB(event)"><i class="bi bi-search"></i></button>
                        </div>
                        <div class="d-none" role="alert" id="tmdbSearchModalAlert"></div>
                        <div id="tmdbSearchResultsDiv" class="row justify-content-center"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ t('integrations.close') }}</button>
                    <button type="button" class="btn btn-primary" onclick="saveTMDBItem()">{{ t('integrations.save') }}</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal to delete Netflix item -->
    <div class="modal fade" id="removeNetflixItemModal" tabindex="-1" role="dialog" aria-labelledby="removeNetflixItemModalTitle" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="removeNetflixItemModalTitle">{{ t('integration_netflix.remove_item_title') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <p>{{ t('integration_netflix.remove_item_body') }}</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ t('integrations.close') }}</button>
                    <button type="button" class="btn btn-danger" id="removeNetflixItemBtn" onclick="removeNetflixItem()">{{ t('integrations.remove') }}</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal to display help text for csv date format -->
    <div class="modal fade" id="csvDateFormatHelpModal" tabindex="-1" role="dialog" aria-labelledby="csvDateFormatHelpModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="csvDateFormatHelpModalTitle">{{ t('integration_netflix.help_date_format_title') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <p>
                            {{ t('integration_netflix.help_intro') }}
                        </p>
                        <table class="table">
                            <thead>
                            <tr>
                                <th scope="col">{{ t('integration_netflix.col_watch_date_csv') }}</th>
                                <th scope="col">{{ t('integration_netflix.csv_date_format') }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>24.01.23</td>
                                <td>d.m.y</td>
                            </tr>
                            <tr>
                                <td>2022/01/24</td>
                                <td>Y/m/d</td>
                            </tr>
                            <tr>
                                <td>24-01-2022</td>
                                <td>d-m-Y</td>
                            </tr>
                            </tbody>
                        </table>
                        <p> {{ t('integration_netflix.help_options_intro') }}</p>
                        <ul>
                            <li><b>d</b> => {{ t('integration_netflix.help_d') }}</li>
                            <li><b>m</b> => {{ t('integration_netflix.help_m') }}</li>
                            <li><b>y</b> => {{ t('integration_netflix.help_y') }}</li>
                            <li><b>Y</b> => {{ t('integration_netflix.help_Y') }}</li>
                        </ul>
                        <p> {{ t('integration_netflix.help_more_pre') }}
                            <a href="https://www.php.net/manual/en/datetime.format.php#refsect1-datetime.format-parameters" target="_blank">{{ t('integration_netflix.help_more_link') }}</a>.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
