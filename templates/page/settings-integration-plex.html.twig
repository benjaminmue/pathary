{% extends 'base.html.twig' %}

{% block title %}
    {{ t('integrations.settings') }} - Plex
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-integration-plex.js"></script>
    <script src="{{ applicationUrl }}/js/component/modal-job.js"></script>
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;margin-bottom: 1rem">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5>{{ t('integration_plex.webhook_url_heading') }}</h5>

                <p class="text-muted">{{ t('integration_plex.webhook_intro') }} <br>
                    {{ t('integration_plex.webhook_docs_pre') }} <a href="https://support.plex.tv/articles/115002267687-webhooks/" target="_blank">{{ t('integration_plex.documentation') }}</a>.</p>

                <div id="plexWebhookUrl"
                     class="overflow-auto text-nowrap webhookUrl"
                     data-active="{{ isActive }}"
                     style="font-size:1rem;margin-top: 1rem;margin-bottom: 1rem;">
                    {{ plexWebhookUrl }}
                </div>

                <div id="alertWebhookUrlDiv">
                    <div class="alert alert-warning {% if isActive != '' %}d-none{% endif %}"
                         role="alert"
                         style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                        {{ t('integrations.webhook_disabled') }} - {% if currentUserIsAdmin == true %}<a href="{{ applicationUrl }}/settings/server/general">{{ t('integrations.application_url') }}</a>{% else %}{{ t('integrations.application_url') }}{% endif %} {{ t('integrations.required') }}
                    </div>
                </div>

                <button id="deletePlexWebhookButton"
                        type="button"
                        class="btn btn-danger {% if plexWebhookUrl == '-' %}disabled{% endif %}"
                        onclick="deletePlexWebhook()">
                    {{ t('integrations.delete_url') }}
                </button>
                <button type="button" class="btn btn-primary {% if isActive == '' %}disabled{% endif %}" onclick="regeneratePlexWebhook()">{{ t('integrations.regenerate_url') }}</button>
            </div>

            <h5 style="margin-top: 1rem">{{ t('integrations.options') }}</h5>

            <div style="padding-bottom: 1rem;padding-top: 0.5rem">
                <input class="form-check-input"
                       type="checkbox"
                       value="1"
                       id="scrobbleWatchesCheckbox"
                       name="scrobbleWatches"
                       {% if plexWebhookUrl == '-' %}disabled{% endif %}
                        {% if scrobbleWatches == true %}checked{% endif %}
                       style="margin-right: 0.2rem">
                <label class="form-check-label" for="scrobbleWatchesCheckbox">{{ t('integrations.scrobble_completed_watches') }}</label>
            </div>
            <div>
                <input class="form-check-input"
                       type="checkbox"
                       value="1"
                       id="scrobbleRatingsCheckbox"
                       name="scrobbleRatings"
                       {% if plexWebhookUrl == '-' %}disabled{% endif %}
                        {% if scrobbleRatings == true %}checked{% endif %}
                       style="margin-left: 0.5rem;margin-right: 0.2rem;">
                <label class="form-check-label" for="scrobbleRatingsCheckbox" style="margin-bottom: 1rem">{{ t('integration_plex.scrobble_rating_updates') }}</label>

                <div id="alertWebhookOptionsDiv"></div>

                <button type="submit" class="btn btn-primary" {% if plexWebhookUrl == '-' %}disabled{% endif %} id="saveButton" onclick="updateScrobbleOptions()">{{ t('integrations.save') }}</button>
            </div>

            <hr>

            <h5>{{ t('integration_plex.authentication_heading') }}</h5>

            <p class="text-muted" style="padding-bottom: 0">
                {{ t('integration_plex.auth_intro') }}
            </p>

            <div id="alertPlexAuthenticationDiv">
                <div class="alert alert-warning {% if plexTokenExists == true or isActive != '' %}d-none{% endif %}"
                     role="alert"
                     style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                    {{ t('integrations.authentication_disabled') }} - {% if currentUserIsAdmin == true %}<a href="{{ applicationUrl }}/settings/server/general">{{ t('integrations.application_url') }}</a>{% else %}{{ t('integrations.application_url') }}{% endif %} {{ t('integrations.required') }}
                </div>
                <div class="alert alert-warning {% if hasServerPlexIdentifier == true %}d-none{% endif %}"
                     role="alert"
                     style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                    {{ t('integration_plex.auth_disabled_identifier') }}
                </div>
            </div>

            <div id="authenticateWithPlexDiv" class="{% if plexTokenExists == true %}d-none{% endif %}">
                <button type="button" class="btn btn-primary mb-3" onclick="authenticateWithPlex()" {% if (isActive == '') or (hasServerPlexIdentifier == false) %}disabled{% endif %}>{{ t('integrations.authenticate') }}</button>
            </div>
            <div id="removeAuthenticationWithPlexDiv" class="{% if plexTokenExists == false %}d-none{% endif %}">
                <button type="button" class="btn btn-danger mb-3" onclick="removePlexAuthentication()">{{ t('integrations.remove_authentication') }}</button>
                <p>{{ t('integrations.username') }}: {{ plexUsername }}</p>
            </div>

            {# The following element is hidden because it is not in use yet #}
            <div class="d-none">
                <div class="input-group mb-3">
                    <span class="input-group-text" id="plexServerUrlInputPrefix">{{ t('integration_plex.server_url_label') }}</span>
                    <input type="text"
                           name="plexServerUrlInput"
                           id="plexServerUrlInput"
                           class="form-control {% if plexTokenExists == false %} disabled {% endif %}"
                           value="{{ plexServerUrl }}"
                           aria-describedby="plexServerUrlInputPrefix" {% if plexTokenExists == false %} disabled {% endif %}
                    >
                    <button class="btn btn-outline-secondary" type="button" id="plexServerUrlInputPrefix" data-bs-toggle="modal" data-bs-target="#plexServerUrlHelpModal">
                        <i class="bi bi-question-lg"></i>
                    </button>
                </div>

                <div class="spinner-border d-none" role="status" id="alertPlexServerUrlLoadingSpinner" style="margin-bottom: 1rem">
                    <span class="visually-hidden">{{ t('integrations.loading') }}</span>
                </div>
                <div id="alertPlexServerUrlDiv"></div>

                <button type="submit"
                        class="btn btn-outline-primary mb-3 {% if plexTokenExists == false %} disabled {% endif %}"
                        id="verifyServerUrlButton"
                        {% if plexTokenExists == false %} disabled {% endif %}
                        onclick="verifyPlexServerUrl()"
                >{{ t('integrations.test_connection') }}
                </button>
                <button type="submit"
                        class="btn btn-primary mb-3 {% if plexTokenExists == false %} disabled {% endif %}"
                        id="saveServerUrlButton"
                        {% if plexTokenExists == false %} disabled {% endif %}
                        onclick="savePlexServerUrl()"
                >{{ t('integrations.save_url') }}
                </button>
            </div>

            <hr style="margin-top: 0">

            <h5>{{ t('integration_plex.watchlist_import_heading') }}</h5>

            <p class="text-muted">{{ t('integration_plex.watchlist_import_intro') }}</p>

            <div id="alertPlexWatchlistImportDiv">
                <div class="alert alert-warning {% if plexTokenExists == true %}d-none{% endif %}"
                     role="alert"
                     style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                    {{ t('integration_plex.import_disabled') }}
                </div>
            </div>

            <button type="button" class="btn btn-outline-primary" onclick="showJobModal('plex_import_watchlist')">
                {{ t('integrations.show_imports') }}
            </button>
            <button type="button" class="btn btn-warning" onclick="importPlexWatchlist()" id="plexWatchlistImportButton" {% if plexTokenExists == false %}disabled{% endif %}>
                {{ t('integration_plex.import_watchlist_btn') }}
            </button>
        </div>

        <div class="modal fade" id="plexServerUrlHelpModal" tabindex="-1" role="dialog" aria-labelledby="plexServerUrlHelpModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="plexServerUrlHelpModalTitle">{{ t('integration_plex.help_server_url_title') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="container-fluid">
                            <p>
                                {{ t('integration_plex.help_server_url_body') }}
                            </p>
                            <ul>
                                <li>http://localhost:32400</li>
                                <li>http://192.168.1.2:32400</li>
                                <li>https://plex.yourDomain.com</li>
                            </ul>
                            <p>
                                {{ t('integrations.url_note') }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{ include('component/modal-job.html.twig') }}
    </main>
{% endblock %}
