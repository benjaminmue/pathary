{% extends 'base.html.twig' %}

{% block title %}
    {{ t('integrations.settings') }} - Jellyfin
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-integration-jellyfin.js"></script>
    <script src="{{ applicationUrl }}/js/component/modal-job.js"></script>
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5>{{ t('integration_jellyfin.webhook_url_heading') }}</h5>

                <p class="text-muted" style="margin-bottom: 0.5rem">
                    {{ t('integration_jellyfin.webhook_intro') }}
                </p>

                <div class="alert alert-secondary" role="alert" style="padding-top: 0.5rem;padding-bottom: 0.5rem">
                    <b>{{ t('integrations.configuration') }}</b>
                    <br style="margin-bottom: 0.5rem">
                    {{ t('integration_jellyfin.requires_plugin_pre') }} <a href="https://github.com/jellyfin/jellyfin-plugin-webhook" target="_blank">{{ t('integration_jellyfin.webhook_plugin') }}</a> {{ t('integration_jellyfin.requires_plugin_post') }}
                    <br style="margin-bottom: 0.5rem">
                    {{ t('integration_jellyfin.add_destination_pre') }} <b>{{ t('integration_jellyfin.generic_destination') }}</b> {{ t('integration_jellyfin.add_destination_post') }}
                    <ul style="margin-bottom: 0">
                        <li>{{ t('integration_jellyfin.config_li_notification') }}</li>
                        <li>{{ t('integration_jellyfin.config_li_user') }}</li>
                        <li>{{ t('integration_jellyfin.config_li_item') }}</li>
                    </ul>
                </div>

                <div id="jellyfinWebhookUrl"
                     class="overflow-auto text-nowrap webhookUrl"
                     data-active="{{ isActive }}"
                     style="font-size:1rem;margin-top: 1rem;margin-bottom: 1rem;">
                    {{ jellyfinWebhookUrl }}
                </div>

                <div id="alertWebhookUrlDiv">
                    <div class="alert alert-warning {% if isActive != '' %}d-none{% endif %}"
                         role="alert"
                         style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                        {{ t('integrations.webhook_disabled') }} - {% if currentUserIsAdmin == true %}<a href="{{ applicationUrl }}/settings/server/general">{{ t('integrations.application_url') }}</a>{% else %}{{ t('integrations.application_url') }}{% endif %} {{ t('integrations.required') }}
                    </div>
                </div>

                <button id="deleteJellyfinWebhookButton"
                        type="button"
                        class="btn btn-danger {% if jellyfinWebhookUrl == '-' %}disabled{% endif %}"
                        onclick="deleteJellyfinWebhook()">
                    {{ t('integrations.delete_url') }}
                </button>
                <button type="button" class="btn btn-primary  {% if isActive == '' %}disabled{% endif %}" onclick="regenerateJellyfinWebhook()">{{ t('integrations.regenerate_url') }}</button>
            </div>

            <h5 style="margin-top: 1rem">{{ t('integrations.options') }}</h5>

            <div style="padding-bottom: 1rem;padding-top: 0.5rem">
                <input class="form-check-input"
                       type="checkbox"
                       value="1"
                       id="scrobbleWatchesCheckbox"
                       name="scrobbleWatches"
                       {% if jellyfinWebhookUrl == '-' %}disabled{% endif %}
                        {% if scrobbleWatches == true %}checked{% endif %}
                       style="margin-right: 0.2rem">
                <label class="form-check-label" for="scrobbleWatchesCheckbox">{{ t('integrations.scrobble_completed_watches') }}</label>
            </div>

            <div id="alertWebhookOptionsDiv"></div>

            <button type="submit" class="btn btn-primary" {% if jellyfinWebhookUrl == '-' %}disabled{% endif %} id="saveButton" onclick="updateScrobbleOptions()">{{ t('integrations.save') }}</button>

            <hr>

            <h5>{{ t('integration_jellyfin.authentication_heading') }}</h5>

            <p class="text-muted" style="padding-bottom: 0">
                {{ t('integration_jellyfin.auth_intro') }}
            </p>

            <div id="alertJellyfinAuthenticationDiv">
                <div class="alert alert-warning {% if jellyfinDeviceId == true %}d-none{% endif %}"
                     role="alert"
                     style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                    {{ t('integration_jellyfin.auth_disabled_device') }}
                </div>
            </div>

            <div id="authenticateWithJellyfinDiv" class="{% if jellyfinIsAuthenticated == true %}d-none{% endif %}">
                <button type="button"
                        class="btn btn-primary mb-3"
                        data-bs-toggle="modal"
                        data-bs-target="#jellyfinAuthenticationModal"
                        id="authenticateWithJellyfinButton"
                        {% if jellyfinServerUrl == null %}disabled{% endif %}>
                    {{ t('integrations.authenticate') }}
                </button>
            </div>
            <div id="removeAuthenticationWithJellyfinDiv" class="{% if jellyfinIsAuthenticated == false %}d-none{% endif %}">
                <button type="button" class="btn btn-danger mb-3" onclick="removeJellyfinAuthentication()">{{ t('integrations.remove_authentication') }}</button>
                <p>{{ t('integrations.username') }}: {{ jellyfinUsername }}</p>
            </div>

            <div class="input-group mb-3">
                <span class="input-group-text" id="jellyfinServerUrlInputPrefix">{{ t('integrations.server_url') }}</span>
                <input type="text"
                       name="jellyfinServerUrlInput"
                       id="jellyfinServerUrlInput"
                       class="form-control"
                       value="{{ jellyfinServerUrl }}"
                       aria-describedby="jellyfinServerUrlInputPrefix"
                        {% if jellyfinDeviceId == null %} disabled {% endif %}>
                <button class="btn btn-outline-secondary" type="button" id="jellyfinServerUrlInputPrefix" data-bs-toggle="modal" data-bs-target="#jellyfinServerUrlHelpModal">
                    <i class="bi bi-question-lg"></i>
                </button>
            </div>

            <div class="spinner-border d-none" role="status" id="alertJellyfinServerUrlLoadingSpinner" style="margin-bottom: 1rem">
                <span class="visually-hidden">{{ t('integrations.loading') }}</span>
            </div>
            <div id="alertJellyfinServerUrlDiv"></div>

            <button type="submit"
                    class="btn btn-outline-primary mb-3"
                    id="verifyServerUrlButton"
                    onclick="verifyJellyfinServerUrl()"
                    {% if jellyfinServerUrl == null or jellyfinDeviceId == null %} disabled {% endif %}
            >{{ t('integrations.test_connection') }}
            </button>
            <button type="submit"
                    class="btn btn-primary mb-3"
                    id="saveServerUrlButton"
                    onclick="saveJellyfinServerUrl()"
                    {% if jellyfinDeviceId == null %} disabled {% endif %}
            >{{ t('integrations.save_url') }}
            </button>

            <div class="modal fade" id="jellyfinAuthenticationModal" tabindex="-1" aria-labelledby="jellyfinAuthenticationModal" aria-hidden="true" data-bs-keyboard="false">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">{{ t('integration_jellyfin.authentication_heading') }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                        </div>
                        <div class="modal-body" id="jellyfinModalBody" style="padding-bottom: 0">
                            <div class="input-group mb-3">
                                <span class="input-group-text">{{ t('integrations.server_url') }}</span>
                                <input type="text" class="form-control disabled" id="jellyfinAuthenticationModalServerUrlInput" value="{{ jellyfinServerUrl }}" disabled/>
                            </div>
                            <div class="input-group mb-3">
                                <span class="input-group-text">{{ t('integrations.username') }}</span>
                                <input type="text" class="form-control disabled" id="jellyfinAuthenticationModalUsernameInput"/>
                            </div>
                            <div class="input-group mb-3">
                                <span class="input-group-text">{{ t('integrations.password') }}</span>
                                <input type="password" class="form-control disabled" id="jellyfinAuthenticationModalPasswordInput"/>
                            </div>
                            <div class="spinner-border d-none" role="status" id="jellyfinAuthenticationModalLoadingSpinner" style="margin-bottom: .8rem">
                                <span class="visually-hidden">{{ t('integrations.loading') }}</span>
                            </div>
                            <div id="alertJellyfinAuthenticationModalDiv"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" onclick="authenticateJellyfinAccount()"
                                    id="jellyfinAuthenticationModalAuthenticateButton" {% if jellyfinServerUrl == null %} disabled {% endif %}>{{ t('integrations.authenticate') }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="jellyfinServerUrlHelpModal" tabindex="-1" role="dialog" aria-labelledby="jellyfinServerUrlHelpModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered text-start">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="jellyfinServerUrlHelpModalTitle">{{ t('integration_jellyfin.help_server_url_title') }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                        </div>
                        <div class="modal-body">
                            <div class="container-fluid">
                                <p>
                                    {{ t('integration_jellyfin.help_server_url_body') }}
                                </p>
                                <ul>
                                    <li>http://localhost:8096</li>
                                    <li>http://192.168.1.2:8096</li>
                                    <li>https://jellyfin.yourDomain.com</li>
                                </ul>
                                <p>
                                    {{ t('integrations.url_note') }}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr>

            <h5>{{ t('integration_jellyfin.sync_heading') }}</h5>

            <div id="alertJellyfinSyncDiv">
                <div class="alert alert-warning {% if jellyfinIsAuthenticated == true %}d-none{% endif %}"
                     role="alert"
                     style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                    {{ t('integration_jellyfin.sync_disabled') }}
                </div>
            </div>

            <div id="alertJellyfinImportHistoryDiv"></div>

            <div style="margin-bottom: 1rem;margin-top: 1rem">
                <button type="button" class="btn btn-outline-primary" onclick="showJobModal('jellyfin_import_history')">
                    {{ t('integrations.show_imports') }}
                </button>
                <button type="button"
                        class="btn btn-warning"
                        data-bs-target="#importHistoryModal"
                        data-bs-toggle="modal"
                        id="jellyfinHistoryImportButton"
                        {% if jellyfinIsAuthenticated == false %}disabled{% endif %}>
                    {{ t('integration_jellyfin.import_history_btn') }}
                </button>
            </div>

            <div id="alertJellyfinExportHistoryDiv"></div>

            <div style="margin-bottom: 1rem;margin-top: 1rem">
                <button type="button" class="btn btn-outline-primary" onclick="showJobModal('jellyfin_export_history')">
                    {{ t('integrations.show_exports') }}
                </button>
                <button type="button"
                        class="btn btn-warning"
                        data-bs-target="#exportHistoryModal"
                        data-bs-toggle="modal"
                        id="jellyfinHistoryExportButton"
                        {% if jellyfinIsAuthenticated == false %}disabled{% endif %}>
                    {{ t('integration_jellyfin.export_history_btn') }}
                </button>
            </div>

            <div style="padding-bottom: 1rem;padding-top: 0.5rem">
                <input class="form-check-input"
                       type="checkbox"
                       value="1"
                       id="automaticWatchStateSyncCheckbox"
                       name="scrobbleWatches"
                       {% if jellyfinIsAuthenticated == false %}disabled{% endif %}
                        {% if jellyfinSyncEnabled == true %}checked{% endif %}
                       style="margin-right: 0.2rem">
                <label class="form-check-label" for="automaticWatchStateSyncCheckbox">{{ t('integration_jellyfin.auto_export') }}</label>
            </div>

            <div id="alertJellyfinSyncOptionsDiv"></div>

            <button type="submit" class="btn btn-primary" {% if jellyfinIsAuthenticated == false %}disabled{% endif %} id="syncSaveButton" onclick="updateSyncOptions()">{{ t('integrations.save') }}
            </button>
        </div>

        {{ include('component/modal-job.html.twig') }}

        <div class="modal fade" id="exportHistoryModal" tabindex="-1" role="dialog" aria-labelledby="exportHistoryModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ t('integration_jellyfin.confirm_export_title') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                    </div>
                    <div class="modal-body">
                        <strong>{{ t('integration_jellyfin.confirm_export_q') }}</strong>
                        <br>
                        <p style="padding-top: 1rem;margin-bottom: 0">{{ t('integration_jellyfin.confirm_export_body') }}</p>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-primary" onclick="exportJellyfin()">{{ t('integrations.submit') }}</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="importHistoryModal" tabindex="-1" role="dialog" aria-labelledby="importHistoryModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ t('integration_jellyfin.confirm_import_title') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                    </div>
                    <div class="modal-body">
                        <strong>{{ t('integration_jellyfin.confirm_import_q') }}</strong>
                        <br>
                        <p style="padding-top: 1rem;margin-bottom: 0">{{ t('integration_jellyfin.confirm_import_body') }}</p>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-primary" onclick="importJellyfin()">{{ t('integrations.submit') }}</a>
                    </div>
                </div>
            </div>
        </div>
        <br>
    </main>
{% endblock %}
