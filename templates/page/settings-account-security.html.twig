{% extends 'base.html.twig' %}

{% block title %}
    {{ t('settings_security.title_password') }}
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/qrcode.min.js"></script>
    <script src="{{ applicationUrl }}/js/settings-account-security.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5>{{ t('settings_security.password_change') }}</h5>
                <div class="mb-3">
                    <label for="currentPassword" class="form-label"><b>{{ t('settings_security.current_password') }}</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="currentPassword"
                           required
                           minlength="10"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="currentPassword" class="form-text">{{ t('settings_security.current_password_help') }}</div>
                </div>

                <div class="mb-3">
                    <label for="newPassword" class="form-label"><b>{{ t('settings_security.new_password') }}</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="newPassword"
                           required
                           minlength="10"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div class="form-text small">
                        <div class="text-muted mb-1">{{ t('settings_security.password_must_contain') }}</div>
                        <div class="text-muted">• {{ t('settings_security.pw_req_length') }}</div>
                        <div class="text-muted">• {{ t('settings_security.pw_req_uppercase') }}</div>
                        <div class="text-muted">• {{ t('settings_security.pw_req_lowercase') }}</div>
                        <div class="text-muted">• {{ t('settings_security.pw_req_number') }}</div>
                        <div class="text-muted">• {{ t('settings_security.pw_req_special') }}</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="newPasswordRepeat" class="form-label"><b>{{ t('settings_security.repeat_new_password') }}</b> <span class="text-danger">*</span></label>
                    <input type="password"
                           class="form-control"
                           id="newPasswordRepeat"
                           required minlength="10"
                           {% if coreAccountChangesDisabled == true %}disabled{% endif %}
                           style="text-align: center;">
                    <div id="newPasswordRepeat" class="form-text">{{ t('settings_security.repeat_help') }}</div>
                </div>

                <div id="alertChangePasswordDiv"></div>

                <button class="btn btn-primary"
                        type="button"
                        id="changePasswordUpdateButton"
                        {% if coreAccountChangesDisabled == true %}disabled{% endif %}>
                    {{ t('settings.submit') }}
                </button>
            </div>

            <hr>

            <h5 style="margin-bottom: .7rem">{{ t('settings_security.security_settings') }}</h5>
            <div class="alert alert-info" role="alert" style="margin-left: 5%;margin-right: 5%;margin-bottom: 0.7rem!important;margin-top: 1rem">
                <i class="bi bi-info-circle"></i> <strong>{{ t('settings_security.moved_title') }}</strong><br>
                {{ t('settings_security.moved_before') }} <a href="{{ applicationUrl }}/profile" class="alert-link">{{ t('settings_security.profile_settings_link') }}</a> {{ t('settings_security.moved_after') }}
                <div style="margin-top: 1rem">
                    <a href="{{ applicationUrl }}/profile" class="btn btn-sm btn-primary">
                        <i class="bi bi-shield-lock"></i> {{ t('settings_security.go_to_profile') }}
                    </a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
