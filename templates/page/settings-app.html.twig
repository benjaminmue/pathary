{% extends 'base.html.twig' %}

{% block title %}
    {{ t('settings_app.title') }}
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/marked-5.0.2.min.js"></script>
    <script src="{{ applicationUrl }}/js/settings-app.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem;">{{ t('settings_app.about') }}</h5>
                <p>
                    <span class="text-{{ theme == 'dark' ? 'light' : 'dark' }} theme-text-color">{{ t('settings_app.version') }}</span> <span class="fw-light">{{ currentApplicationVersion }}</span>


                    {% if currentApplicationVersion != 'nightly' %}
                        {% if latestRelease is empty %}
                            {% set badgeStyle = 'text-bg-secondary' %}
                            {% set badgeText = t('settings_app.latest_version_unknown') %}
                        {% else %}
                            {% set badgeStyle = (currentApplicationVersion != latestRelease.name) ? 'text-bg-warning' : 'text-bg-success' %}
                            {% set badgeText = (currentApplicationVersion != latestRelease.name) ? t('settings_app.update_available') : t('settings_app.up_to_date') %}
                        {% endif %}

                        <a
                                href="https://github.com/leepeuker/movary/releases"
                                class="badge rounded-pill {{ badgeStyle }}"
                                target="_blank"
                                style="text-decoration-line:none">
                            {{ badgeText }}
                        </a>
                    {% endif %}
                </p>
                <p>
                    <span class="text-{{ theme == 'dark' ? 'light' : 'dark' }} theme-text-color">{{ t('settings_app.timezone') }}</span>
                    <span class="fw-light">{{ applicationTimezone }}</span>
                </p>

                <hr>

                <h5 style="margin-bottom: 1rem;">{{ t('settings_app.getting_support') }}</h5>
                <p>
                    <span class="text-{{ theme == 'dark' ? 'light' : 'dark' }} theme-text-color">{{ t('settings_app.github') }}</span>
                    <a class="fw-light" href="https://github.com/leepeuker/movary/discussions/categories/support" target="_blank">leepeuker/movary</a>
                </p>
                <p>
                    <span class="text-{{ theme == 'dark' ? 'light' : 'dark' }} theme-text-color">{{ t('settings_app.discord') }}</span>
                    <a class="fw-light" href="https://discord.gg/KbcSqggrgW" target="_blank">Pathary</a>
                </p>

                <hr>

                <h5 style="margin-bottom: 1rem;">{{ t('settings_app.latest_releases') }}</h5>

                <div class="spinner-border" role="status" id="loadingSpinner" style="margin-top: .5rem">
                    <span class="visually-hidden">{{ t('settings.loading') }}</span>
                </div>

                <ul class="list-group" id="latestReleases"></ul>

                <div id="alertReleasesDiv"></div>
            </div>

            {{ include('component/modal-app-release.html.twig') }}
        </div>
    </main>
{% endblock %}
