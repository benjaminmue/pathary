{% extends 'base.html.twig' %}

{% block title %}
    {{ t('server.page_title') }}
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-server-users.js"></script>
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-bottom: 1rem;padding-top: 1rem">
                <h5 style="margin-bottom: 1rem;">{{ t('server.user_management') }}</h5>

                <p class="text-muted">{{ t('server.user_list_hint') }}</p>

                <div id="userManagementAlerts"></div>

                <div class="table-responsive">
                    <table class="table table-hover" id="usersTable">
                        <thead>
                        <tr>
                            <th scope="col">{{ t('server.col_id') }}</th>
                            <th scope="col">{{ t('server.col_name') }}</th>
                            <th scope="col">{{ t('server.col_email') }}</th>
                            <th scope="col">{{ t('server.col_admin') }}</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="spinner-border d-none" role="status" id="userTableLoadingSpinner">
                    <span class="visually-hidden">{{ t('server.loading') }}</span>
                </div>
            </div>
        </div>

        <button type="button" class="btn btn-primary float-end" style="width: 100%" onclick="showCreateUserModal()">{{ t('server.create_user') }}</button>

        {{ include('component/modal-user.html.twig') }}
    </main>
{% endblock %}
