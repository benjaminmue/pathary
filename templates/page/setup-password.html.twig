{% extends 'base.html.twig' %}

{% set showFooter = false %}

{% block title %}
    {{ t('setup_password.create_password') }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ applicationUrl }}/css/login.css">
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/login-bg.js"></script>
{% endblock %}

{% block body %}
    <div class="login-container">
        <!-- Centered Logo with Circle Background -->
        <div class="login-logo-wrapper">
            <div class="login-logo-circle">
                <div class="login-logo-container">
                    <img src="{{ applicationUrl }}/images/pathary-logo.svg"
                         alt="{{ applicationName ?? 'Pathary' }} logo"
                         class="login-logo">
                </div>
            </div>
        </div>

        <!-- Password Setup Card -->
        <div class="login-card">
            <h1 class="text-center mb-4">{{ t('setup_password.heading') }}</h1>

            <p class="text-center text-muted mb-4">
                {{ t('setup_password.welcome') }} <strong>{{ userName }}</strong>!<br>
                {{ t('setup_password.create_prompt') }}
            </p>

            <form method="POST" action="{{ applicationUrl }}/setup-password">
                <input type="hidden" name="token" value="{{ token }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">

                <div class="form-floating mb-3">
                    <input type="password"
                           class="form-control {% if errorPasswordTooShort or errorPasswordPolicyViolation %}is-invalid{% endif %}"
                           id="password"
                           name="password"
                           placeholder="{{ t('setup_password.password') }}"
                           minlength="10"
                           required>
                    <label for="password">{{ t('setup_password.password') }}</label>
                    {% if errorPasswordTooShort %}
                        <div class="invalid-feedback">
                            {{ t('setup_password.error_too_short') }}
                        </div>
                    {% endif %}
                    {% if errorPasswordPolicyViolation %}
                        <div class="invalid-feedback">
                            {{ errorPasswordPolicyViolation }}
                        </div>
                    {% endif %}
                </div>

                <div class="form-floating mb-3">
                    <input type="password"
                           class="form-control {% if errorPasswordNotEqual %}is-invalid{% endif %}"
                           id="repeatPassword"
                           name="repeatPassword"
                           placeholder="{{ t('setup_password.confirm_password') }}"
                           minlength="10"
                           required>
                    <label for="repeatPassword">{{ t('setup_password.confirm_password') }}</label>
                    {% if errorPasswordNotEqual %}
                        <div class="invalid-feedback">
                            {{ t('setup_password.error_not_equal') }}
                        </div>
                    {% endif %}
                </div>

                {% if missingFormData %}
                    <div class="alert alert-danger" role="alert">
                        {{ t('setup_password.error_missing') }}
                    </div>
                {% endif %}

                {% if rateLimitExceeded %}
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>{{ t('setup_password.rate_limit_title') }}</strong> {{ t('setup_password.rate_limit_desc') }}
                    </div>
                {% endif %}

                <div class="alert alert-info small mb-3">
                    <strong>{{ t('setup_password.requirements_title') }}</strong>
                    <ul class="mb-0 ps-3">
                        <li>{{ t('setup_password.req_length') }}</li>
                        <li>{{ t('setup_password.req_uppercase') }}</li>
                        <li>{{ t('setup_password.req_lowercase') }}</li>
                        <li>{{ t('setup_password.req_number') }}</li>
                        <li>{{ t('setup_password.req_special') }}</li>
                    </ul>
                </div>

                <button class="w-100 btn btn-lg btn-primary mb-3" type="submit">
                    {{ t('setup_password.create_password') }}
                </button>
            </form>

            <div class="text-center">
                <a href="{{ applicationUrl }}/login">{{ t('setup_password.back_to_login') }}</a>
            </div>
        </div>
    </div>
{% endblock %}
