{% extends 'base.html.twig' %}

{% block title %}
    {{ t('integrations.settings') }} - Radarr
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/settings-integration-radarr.js"></script>
{% endblock %}

{% block stylesheets %}
    <link href="{{ applicationUrl }}/css/settings.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <main role="main" class="container">
        {{ include('component/navbar.html.twig') }}

        <div style="text-align: center;">
            {{ include('component/settings-nav.html.twig') }}

            <div style="padding-top: 1rem">
                <h5>{{ t('integration_radarr.sync_heading') }}</h5>

                <p class="text-muted" style="margin-bottom: 0.5rem">
                    {{ t('integration_radarr.sync_intro_pre') }} <a href="https://wiki.servarr.com/radarr/supported#stevenluimport" target="_blank">{{ t('integration_radarr.lists_import_feature') }}</a>.
                </p>

                <div class="alert alert-secondary" role="alert" style="padding-top: 0.5rem;padding-bottom: 0.5rem">
                    <b>{{ t('integration_radarr.how_to_heading') }}</b>
                    <br style="margin-bottom: 0.5rem">
                    <ul style="margin-bottom: 0">
                        <li>{{ t('integration_radarr.li_settings') }}</li>
                        <li>{{ t('integration_radarr.li_add') }}</li>
                        <li>{{ t('integration_radarr.li_stevenlu') }}</li>
                        <li>{{ t('integration_radarr.li_copy') }}</li>
                    </ul>
                </div>

                <div id="radarrFeedUrl"
                     class="overflow-auto text-nowrap webhookUrl"
                     data-active="{{ isActive }}"
                     style="font-size:1rem;margin-top: 1rem;margin-bottom: 1rem;">
                    {{ radarrFeedUrl }}
                </div>


                <div id="alertFeedUrlDiv">
                    <div class="alert alert-warning {% if isActive != '' %}d-none{% endif %}"
                         role="alert"
                         style="margin-left: 5%;margin-right: 5%;margin-bottom: 1rem!important;">
                        {{ t('integration_radarr.feed_disabled') }} - {% if currentUserIsAdmin == true %}<a href="{{ applicationUrl }}/settings/server/general">{{ t('integrations.application_url') }}</a>{% else %}{{ t('integrations.application_url') }}{% endif %} {{ t('integrations.required') }}
                    </div>
                </div>

                <button id="deleteRadarrFeedButton" type="button" class="btn btn-danger {% if radarrFeedUrl == '-' %}disabled{% endif %}" data-bs-target="#confirmDeleteModal" data-bs-toggle="modal">
                    {{ t('integrations.delete_url') }}
                </button>
                <button type="button" class="btn btn-primary  {% if isActive == '' %}disabled{% endif %}" data-bs-target="#confirmRegenerationModal" data-bs-toggle="modal">{{ t('integrations.regenerate_url') }}</button>
            </div>
        </div>

        <div class="modal fade" id="confirmRegenerationModal" tabindex="-1" role="dialog" aria-labelledby="confirmRegenerationModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ t('integration_radarr.confirm_regen_title') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ t('integration_radarr.confirm_regen_body') }}
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-primary" onclick="regenerateRadarrFeedId()" data-bs-dismiss="modal" data-bs-target="#confirmRegenerationModal">{{ t('integrations.confirm') }}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ t('integration_radarr.confirm_delete_title') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('integrations.close') }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ t('integration_radarr.confirm_delete_body') }}
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-danger" onclick="deleteRadarrFeedId()" data-bs-dismiss="modal" data-bs-target="#confirmDeleteModal">{{ t('integrations.confirm') }}</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
