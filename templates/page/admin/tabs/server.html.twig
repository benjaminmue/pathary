                                    <label for="oauthSmtpPort" class="form-label">
                                        {{ t('admin_server.port') }} <span class="text-danger">*</span>
                                    </label>
                                    <input type="number" class="form-control" id="oauthSmtpPort"
                                           value="{{ smtpPort ?? 587 }}"
                                           placeholder="587">
                                    <div class="form-text">{{ t('admin_server.port_help') }}</div>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label for="oauthSmtpEncryption" class="form-label">
                                        {{ t('admin_server.encryption') }} <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" id="oauthSmtpEncryption">
                                        <option value="tls" {{ smtpEncryption == 'tls' or not smtpEncryption ? 'selected' : '' }}>TLS (STARTTLS)</option>
                                        <option value="ssl" {{ smtpEncryption == 'ssl' ? 'selected' : '' }}>SSL</option>
                                    </select>
                                    <div class="form-text">{{ t('admin_server.encryption_help') }}</div>
                                </div>
