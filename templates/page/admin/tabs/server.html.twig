        saved: {{ t('admin.server.saved')|json_encode|raw }},
        saveKeys: {{ t('admin.server.save_keys')|json_encode|raw }},
        noChangesHint: {{ t('admin.server.no_changes_hint')|json_encode|raw }},
    };

    // Date as DD.MM.YYYY (never US M/D/YYYY)
    function pdsFormatDate(raw) {
        if (!raw) return '';
        const d = new Date(String(raw).replace(' ', 'T'));
        if (isNaN(d.getTime())) return '';
        const pad = (n) => String(n).padStart(2, '0');
        return `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()}`;
    }

    // Date + time as DD.MM.YYYY, HH:MM (defaults to now when raw omitted)
    function pdsFormatDateTime(raw) {
        const d = raw ? new Date(String(raw).replace(' ', 'T')) : new Date();
        if (isNaN(d.getTime())) return '';
        const pad = (n) => String(n).padStart(2, '0');
        return `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()}, ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    // Clock time as HH:MM:SS
    function pdsFormatTime(raw) {
        if (!raw) return '-';
        const d = new Date(String(raw).replace(' ', 'T'));
        if (isNaN(d.getTime())) return '-';
        const pad = (n) => String(n).padStart(2, '0');
        return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    }

    // Shared renderer for the TMDB/OMDb key status line (pds pill + updated date)
    function renderApiKeyStatus(statusEl, removeBtn, opts) {
        if (!statusEl) return;
        if (opts.configured) {
            const updated = pdsFormatDate(opts.updatedAt);
            let html = `<span class="pds-pill pds-pill--gold">${serverI18n.statusConfigured}</span>`;
            if (updated) {
                html += `<span class="pds-key__meta">${serverI18n.updatedPrefix} ${updated}</span>`;
            }
            if (opts.isEnvironment) {
                html += `
                    <div class="alert alert-info py-1 px-2 mt-2 mb-0 small" style="flex-basis:100%;">
                        <i class="bi bi-info-circle me-1"></i>${serverI18n.envNote}
                    </div>`;
            }
            statusEl.innerHTML = html;
            if (removeBtn) {
                removeBtn.style.display = opts.isEnvironment ? 'none' : 'inline-flex';
            }
        } else {
            statusEl.innerHTML = `
                <span class="pds-pill pds-pill--muted">${serverI18n.statusNotConfigured}</span>
                <a href="${opts.getKeyUrl}" target="_blank" rel="noopener">${serverI18n.getApiKey}</a>`;
            if (removeBtn) {
                removeBtn.style.display = 'none';
            }
        }
    }

