                                        <option value="6" {{ savedMonths == 6 ? 'selected' : '' }}>{{ t('admin_server.months_6') }}</option>
                                        <option value="12" {{ savedMonths == 12 ? 'selected' : '' }}>{{ t('admin_server.months_12') }}</option>
                                        <option value="24" {{ savedMonths == 24 ? 'selected' : '' }}>{{ t('admin_server.months_24') }}</option>
                                    </select>
