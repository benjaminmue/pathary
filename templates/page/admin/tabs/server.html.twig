<div class="row pds-server">
    <!-- Settings Accordion (API, Application, Email) -->
    <div class="accordion" id="serverSettingsAccordion">
    <!-- API Settings Card -->
    <div class="col-md-12 mb-4">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#apiSettings" aria-expanded="true">
                    {{ t('admin_server.api_settings') }}
                </button>
            </h2>
            <div id="apiSettings" class="accordion-collapse collapse show" data-bs-parent="#serverSettingsAccordion">
                <div class="accordion-body">
                <form id="apiSettingsForm">
                    <!-- TMDB key (compact: head = name + pill + updated, row = input + actions) -->
                    <div class="pds-key">
                        <div class="pds-key__head">
                            <span class="pds-key__name">
                                {{ t('admin_server.tmdb_api_key') }}
                            </span>
                            <span class="pds-key__status" id="tmdbKeyStatus">
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                {{ t('admin_server.loading_status') }}
                            </span>
                        </div>
                        <div class="pds-key__row">
                            <input type="password" class="pds-input font-monospace pds-key__input" id="tmdbApiKey"
                                   placeholder="{{ t('admin_server.tmdb_key_placeholder') }}">
                            <button type="button" class="pds-btn pds-btn--ghost pds-key__eye" onclick="toggleApiKeyVisibility('tmdbApiKey')" aria-label="{{ t('admin_server.tmdb_api_key') }}">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button type="button" class="pds-btn pds-btn--ghost" onclick="testTmdbConnection()">
                                {{ t('admin.server.test_connection') }}
                            </button>
                            <button type="button" class="pds-btn pds-btn--ghost" id="removeTmdbKeyBtn" onclick="removeTmdbKey()" style="display: none;">
                                {{ t('admin.server.remove') }}
                            </button>
                        </div>
                    </div>

                    <!-- OMDb key -->
                    <div class="pds-key">
                        <div class="pds-key__head">
                            <span class="pds-key__name">
                                {{ t('admin_server.omdb_api_key') }}
                            </span>
                            <span class="pds-key__status" id="omdbKeyStatus">
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                {{ t('admin_server.loading_status') }}
                            </span>
                        </div>
                        <div class="pds-key__row">
                            <input type="password" class="pds-input font-monospace pds-key__input" id="omdbApiKey"
                                   placeholder="{{ t('admin_server.omdb_key_placeholder') }}">
                            <button type="button" class="pds-btn pds-btn--ghost pds-key__eye" onclick="toggleApiKeyVisibility('omdbApiKey')" aria-label="{{ t('admin_server.omdb_api_key') }}">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button type="button" class="pds-btn pds-btn--ghost" onclick="testOmdbConnection()">
                                {{ t('admin.server.test_connection') }}
                            </button>
                            <button type="button" class="pds-btn pds-btn--ghost" id="removeOmdbKeyBtn" onclick="removeOmdbKey()" style="display: none;">
                                {{ t('admin.server.remove') }}
                            </button>
                        </div>
                    </div>

                    <div class="pds-key__save">
                        <button type="button" class="pds-btn pds-btn--primary" id="saveApiSettingsBtn" onclick="saveApiSettings()">
                            {{ t('admin.server.save_keys') }}
                        </button>
                        <div id="saveHelperText" class="form-text" style="display: none;">
                            <i class="bi bi-info-circle"></i> <span id="saveHelperMessage"></span>
                        </div>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Application Settings Card -->
    <div class="col-md-12 mb-4">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#appSettings" aria-expanded="false">
                    {{ t('admin_server.application_settings') }}
                </button>
            </h2>
            <div id="appSettings" class="accordion-collapse collapse" data-bs-parent="#serverSettingsAccordion">
                <div class="accordion-body">
                <form id="appSettingsForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="appName" class="form-label">{{ t('admin_server.application_name') }}</label>
                            <input type="text" class="form-control" id="appName" value="Pathary">
                            <div class="form-text">{{ t('admin_server.application_name_help') }}</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="appUrl" class="form-label">{{ t('admin_server.application_url') }}</label>
                            <input type="url" class="form-control" id="appUrl" value="{{ applicationUrl }}" readonly>
                            <div class="form-text">{{ t('admin_server.application_url_help') }}</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="registrationEnabled">
                            <label class="form-check-label" for="registrationEnabled">
                                {{ t('admin_server.enable_registration') }}
                            </label>
                        </div>
                        <div class="form-text">{{ t('admin_server.enable_registration_help') }}</div>
                    </div>

                    <button type="button" class="btn btn-primary" onclick="saveAppSettings()">
                        <i class="bi bi-save me-1"></i>{{ t('admin_server.save_app_settings') }}
                    </button>
                </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Email Settings Card with Tabs -->
    <div class="col-md-12 mb-4">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#emailSettings" aria-expanded="false">
                    {{ t('admin_server.email_settings') }}
                </button>
            </h2>
            <div id="emailSettings" class="accordion-collapse collapse" data-bs-parent="#serverSettingsAccordion">
                <div class="accordion-body">
                <p class="text-muted small">
                    {{ t('admin_server.email_settings_intro') }}
                </p>

                <!-- Authentication Mode Tabs -->
                <ul class="nav nav-tabs mb-4" id="emailAuthTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {{ emailAuthMode == 'smtp_password' or emailAuthMode is not defined ? 'active' : '' }}"
                                id="smtp-password-tab" data-bs-toggle="tab" data-bs-target="#smtp-password-panel"
                                type="button" role="tab">
                            <i class="bi bi-key me-2"></i>{{ t('admin_server.tab_smtp_password') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {{ emailAuthMode == 'smtp_oauth' ? 'active' : '' }}"
                                id="oauth-tab" data-bs-toggle="tab" data-bs-target="#oauth-panel"
                                type="button" role="tab">
                            <i class="bi bi-shield-lock me-2"></i>OAuth 2.0
                            {% if oauthConfig and oauthConfig.connected %}
                                <span class="badge bg-success ms-1">{{ t('admin_server.status_connected') }}</span>
                            {% endif %}
                        </button>
                    </li>
                </ul>

                <!-- Current Mode Indicator -->
                <div class="alert {{ emailAuthMode == 'smtp_oauth' ? 'alert-success' : 'alert-warning' }} mb-3" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi {{ emailAuthMode == 'smtp_oauth' ? 'bi-shield-lock-fill' : 'bi-key-fill' }} fs-4 me-3"></i>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">
                                <strong>{{ t('admin_server.current_auth_mode') }}</strong>
                                {{ emailAuthMode == 'smtp_oauth' ? t('admin_server.mode_oauth_full') : t('admin_server.mode_password_full') }}
                            </h6>
                            <small>
                                {% if emailAuthMode == 'smtp_oauth' %}
                                    ✓ {{ t('admin_server.oauth_using_secure') }} {{ oauthConfig ? oauthConfig.fromAddress : t('admin_server.not_configured') }}
                                {% else %}
                                    {{ t('admin_server.password_based_auth') }}
                                {% endif %}
                            </small>
                        </div>
                        {% if emailAuthMode == 'smtp_oauth' and not oauthConfig %}
                            <span class="badge bg-danger">{{ t('admin_server.status_not_configured') }}</span>
                        {% elseif emailAuthMode == 'smtp_oauth' and oauthConfig and not oauthConfig.connected %}
                            <span class="badge bg-warning">{{ t('admin_server.status_not_connected') }}</span>
                        {% elseif emailAuthMode == 'smtp_oauth' and oauthConfig and oauthConfig.connected %}
                            <span class="badge bg-success">{{ t('admin_server.status_connected') }}</span>
                        {% endif %}
                    </div>
                </div>

                <div class="tab-content" id="emailAuthTabContent">
                    <!-- SMTP Password Tab -->
                    <div class="tab-pane fade {{ emailAuthMode == 'smtp_password' or emailAuthMode is not defined ? 'show active' : '' }}"
                         id="smtp-password-panel" role="tabpanel">

                        <form id="emailSettingsForm">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="smtpHost" class="form-label">{{ t('admin_server.smtp_host') }}</label>
                                    <input type="text" class="form-control" id="smtpHost" placeholder="smtp.gmail.com"
                                           value="{{ smtpHost ?? '' }}">
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label for="smtpPort" class="form-label">{{ t('admin_server.port') }}</label>
                                    <input type="number" class="form-control" id="smtpPort"
                                           value="{{ smtpPort ?? 587 }}" placeholder="587">
                                </div>

                                <div class="col-md-3 mb-3">
                                    <label for="smtpEncryption" class="form-label">{{ t('admin_server.encryption') }}</label>
                                    <select class="form-select" id="smtpEncryption">
                                        <option value="tls" {{ smtpEncryption == 'tls' ? 'selected' : '' }}>TLS (STARTTLS)</option>
                                        <option value="ssl" {{ smtpEncryption == 'ssl' ? 'selected' : '' }}>SSL</option>
                                        <option value="" {{ smtpEncryption == '' ? 'selected' : '' }}>{{ t('admin_server.enc_none') }}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="smtpUsername" class="form-label">{{ t('admin_server.username_email') }}</label>
                                    <input type="text" class="form-control" id="smtpUsername" placeholder="your-email@gmail.com"
                                           value="{{ smtpUsername ?? '' }}">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="smtpPassword" class="form-label">
                                        {{ t('admin_server.password_app_password') }}
                                        {% if smtpPasswordConfigured %}
                                            <span class="badge bg-success ms-2">
                                                {{ t('admin_server.status_configured') }}
                                            </span>
                                        {% endif %}
                                    </label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="smtpPassword"
                                               placeholder="{% if smtpPasswordConfigured %}{{ t('admin_server.saved_leave_blank') }}{% else %}{{ t('admin_server.enter_password') }}{% endif %}">
                                        <button class="btn btn-outline-secondary" type="button" onclick="toggleApiKeyVisibility('smtpPassword')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <div class="form-text">
                                        {% if smtpPasswordConfigured %}
                                            {{ t('admin_server.password_saved_help') }}
                                        {% else %}
                                            {{ t('admin_server.password_enter_help') }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="smtpFromAddress" class="form-label">{{ t('admin_server.from_address') }}</label>
                                <input type="email" class="form-control" id="smtpFromAddress" placeholder="noreply@pathary.local"
                                       value="{{ smtpFromAddress ?? '' }}">
                                <div class="form-text">{{ t('admin_server.from_address_help') }}</div>
                            </div>

                            <div class="mb-3">
                                <label for="smtpFromDisplayName" class="form-label">
                                    {{ t('admin_server.from_display_name') }} <small class="text-muted">{{ t('admin_server.optional_paren') }}</small>
                                </label>
                                <input type="text" class="form-control" id="smtpFromDisplayName" placeholder="Email from Pathary"
                                       value="{{ smtpFromDisplayName ?? '' }}">
                                <div class="form-text">{{ t('admin_server.display_name_help') }}</div>
                            </div>

                            <div class="border-top pt-3 mt-3">
                                <button type="button" class="btn btn-primary" onclick="saveEmailSettings()">
                                    <i class="bi bi-save me-1"></i>{{ t('admin_server.save_smtp_settings') }}
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="sendTestEmail()">
                                    <i class="bi bi-send me-1"></i>{{ t('admin_server.send_test_email') }}
                                </button>
                                <button type="button" class="btn btn-outline-info" onclick="runSMTPDiagnostics()">
                                    <i class="bi bi-tools me-1"></i>{{ t('admin_server.run_diagnostics') }}
                                </button>
                                {% if emailAuthMode == 'smtp_oauth' %}
                                    <button type="button" class="btn btn-outline-warning" onclick="switchToPasswordMode()">
                                        <i class="bi bi-arrow-left-circle me-1"></i>{{ t('admin_server.switch_to_password_mode') }}
                                    </button>
                                {% endif %}
                            </div>
                        </form>

                        <!-- SMTP Diagnostics Results -->
                        <div id="smtpDiagnosticsResults" class="mt-4" style="display: none;">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="bi bi-tools me-2"></i>{{ t('admin_server.smtp_diagnostics') }}</h5>
                                </div>
                                <div class="card-body" id="diagnosticsContent">
                                    <!-- Results will be populated here -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- OAuth 2.0 Tab -->
                    <div class="tab-pane fade {{ emailAuthMode == 'smtp_oauth' ? 'show active' : '' }}"
                         id="oauth-panel" role="tabpanel">

                        {% if not encryptionKeyConfigured %}
                            <div class="alert alert-warning" role="alert">
                                <h6 class="alert-heading"><i class="bi bi-exclamation-triangle me-2"></i>{{ t('admin_server.encryption_key_required') }}</h6>
                                <p class="mb-2">{{ t('admin_server.encryption_key_required_desc') }}</p>
                                <button type="button" class="btn btn-sm btn-warning" onclick="generateEncryptionKey()">
                                    <i class="bi bi-key me-1"></i>{{ t('admin_server.generate_encryption_key') }}
                                </button>
                                <p class="small text-muted mt-2 mb-0">
                                    {{ t('admin_server.encryption_key_prod_part1') }} <code>ENCRYPTION_KEY</code> {{ t('admin_server.encryption_key_prod_part2') }}
                                </p>
                            </div>
                        {% endif %}

                        <!-- Gmail Setup Instructions Alert -->
                        <div class="alert alert-info mb-3" role="alert" id="gmailInstructions" style="display: none;">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-info-circle-fill fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="alert-heading mb-2">{{ t('admin_server.gmail_oauth_setup') }}</h6>
                                    <p class="small mb-2">
                                        <strong>{{ t('admin_server.quick_setup_guide') }}</strong> {{ t('admin_server.follow_steps_or_see') }}
                                        <a href="https://docs.pathary.tv/oauth-email-setup/#gmail-setup-requirements" target="_blank" class="alert-link">
                                            <i class="bi bi-book me-1"></i>{{ t('admin_server.gmail_setup_guide_link') }}
                                        </a>
                                        {{ t('admin_server.gmail_setup_guide_suffix') }}
                                    </p>
                                    <button class="btn btn-sm btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#gmailInstructionsCollapse">
                                        <i class="bi bi-chevron-down me-1"></i>{{ t('admin_server.show_quick_setup_steps') }}
                                    </button>

                                    <div class="collapse" id="gmailInstructionsCollapse">
                                        <div class="mt-2">
                                            <h6 class="text-primary">{{ t('admin_server.gmail_step1_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.go_to') }} <a href="https://console.cloud.google.com/" target="_blank">Google Cloud Console</a></li>
                                                <li>{{ t('admin_server.gmail_step1_li2') }}</li>
                                                <li>{{ t('admin_server.gmail_step1_li3') }}</li>
                                            </ol>

                                            <h6 class="text-primary">{{ t('admin_server.gmail_step2_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.gmail_step2_li1') }} <strong>APIs & Services → Library</strong></li>
                                                <li>{{ t('admin_server.gmail_step2_li2') }}</li>
                                                <li>{{ t('admin_server.gmail_step2_li3') }} <strong>Enable</strong></li>
                                            </ol>

                                            <h6 class="text-primary">{{ t('admin_server.gmail_step3_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.go_to') }} <strong>APIs & Services → OAuth consent screen</strong></li>
                                                <li>{{ t('admin_server.gmail_step3_li2') }}</li>
                                                <li>{{ t('admin_server.gmail_step3_li3') }}</li>
                                                <li>{{ t('admin_server.gmail_step3_li4') }}</li>
                                                <li>{{ t('admin_server.click') }} <strong>Save and Continue</strong></li>
                                            </ol>

                                            <h6 class="text-primary">{{ t('admin_server.gmail_step4_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.go_to') }} <strong>APIs & Services → Credentials</strong></li>
                                                <li>{{ t('admin_server.click') }} <strong>Create Credentials → OAuth client ID</strong></li>
                                                <li>{{ t('admin_server.gmail_step4_li3') }}</li>
                                                <li>{{ t('admin_server.gmail_step4_li4') }}</li>
                                                <li>{{ t('admin_server.gmail_step4_li5') }}</li>
                                                <li>{{ t('admin_server.click') }} <strong>Create</strong></li>
                                                <li><strong>{{ t('admin_server.gmail_step4_li7') }}</strong></li>
                                            </ol>

                                            <h6 class="text-primary">5. {{ t('admin_server.get_required_values') }}</h6>
                                            <ul class="small mb-3">
                                                <li><strong>Client ID</strong>: {{ t('admin_server.from_step_4') }}</li>
                                                <li><strong>Client Secret</strong>: {{ t('admin_server.from_step_4') }}</li>
                                                <li><strong>Tenant ID</strong>: {{ t('admin_server.gmail_tenant_not_required') }}</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Azure Setup Instructions Alert -->
                        <div class="alert alert-info mb-3" role="alert" id="azureInstructions">
                            <div class="d-flex">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-info-circle-fill fs-4"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="alert-heading mb-2">{{ t('admin_server.azure_setup') }}</h6>
                                    <p class="small mb-2">
                                        <strong>{{ t('admin_server.quick_setup_guide') }}</strong> {{ t('admin_server.follow_steps_or_see') }}
                                        <a href="https://docs.pathary.tv/oauth-email-setup/#microsoft-365-setup-requirements" target="_blank" class="alert-link">
                                            <i class="bi bi-book me-1"></i>{{ t('admin_server.azure_setup_guide_link') }}
                                        </a>
                                        {{ t('admin_server.azure_setup_guide_suffix') }}
                                    </p>
                                    <button class="btn btn-sm btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#azureInstructionsCollapse">
                                        <i class="bi bi-chevron-down me-1"></i>{{ t('admin_server.show_quick_setup_steps') }}
                                    </button>

                                    <div class="collapse" id="azureInstructionsCollapse">
                                        <div class="mt-2">
                                            <h6 class="text-primary">{{ t('admin_server.azure_step1_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.go_to') }} <a href="https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank">Azure Portal → App registrations</a></li>
                                                <li>{{ t('admin_server.click') }} <strong>New registration</strong></li>
                                                <li>{{ t('admin_server.azure_step1_li3') }}</li>
                                                <li>{{ t('admin_server.azure_step1_li4') }}</li>
                                                <li>{{ t('admin_server.azure_step1_li5') }}</li>
                                                <li>{{ t('admin_server.click') }} <strong>Register</strong></li>
                                            </ol>

                                            <h6 class="text-primary">{{ t('admin_server.azure_step2_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.azure_step2_li1') }} <strong>API permissions</strong></li>
                                                <li>{{ t('admin_server.click') }} <strong>Add a permission</strong></li>
                                                <li>{{ t('admin_server.select') }} <strong>Microsoft Graph</strong></li>
                                                <li>{{ t('admin_server.select') }} <strong>Delegated permissions</strong></li>
                                                <li>{{ t('admin_server.azure_step2_li5') }}
                                                    <ul>
                                                        <li><code>SMTP.Send</code> - {{ t('admin_server.perm_smtp_send') }}</li>
                                                        <li><code>User.Read</code> - {{ t('admin_server.perm_user_read') }}</li>
                                                        <li><code>offline_access</code> - {{ t('admin_server.perm_offline_access') }}</li>
                                                    </ul>
                                                </li>
                                                <li>{{ t('admin_server.click') }} <strong>Add permissions</strong></li>
                                                <li>{{ t('admin_server.click') }} <strong>Grant admin consent for [Your Organization]</strong> {{ t('admin_server.requires_admin') }}</li>
                                                <li>{{ t('admin_server.azure_step2_li9') }}</li>
                                            </ol>

                                            <h6 class="text-primary">{{ t('admin_server.azure_step3_title') }}</h6>
                                            <ol class="small mb-3">
                                                <li>{{ t('admin_server.go_to') }} <strong>Certificates & secrets</strong></li>
                                                <li>{{ t('admin_server.click') }} <strong>New client secret</strong></li>
                                                <li>{{ t('admin_server.azure_step3_li3') }}</li>
                                                <li>{{ t('admin_server.azure_step3_li4') }}</li>
                                                <li>{{ t('admin_server.click') }} <strong>Add</strong></li>
                                                <li><strong>{{ t('admin_server.azure_step3_li6_bold') }}</strong> {{ t('admin_server.azure_step3_li6_suffix') }}</li>
                                            </ol>

                                            <h6 class="text-primary">4. {{ t('admin_server.get_required_values') }}</h6>
                                            <ul class="small mb-3">
                                                <li><strong>Client ID</strong>: {{ t('admin_server.azure_val_client_id') }}</li>
                                                <li><strong>Tenant ID</strong>: {{ t('admin_server.azure_val_tenant_id') }}</li>
                                                <li><strong>Client Secret</strong>: {{ t('admin_server.azure_val_client_secret') }}</li>
                                            </ul>

                                            <h6 class="text-primary">{{ t('admin_server.azure_step5_title') }}</h6>
                                            <p class="small mb-2">{{ t('admin_server.azure_step5_desc') }}</p>
                                            <div class="bg-dark text-light p-2 rounded mb-2" style="font-family: monospace; font-size: 0.85em;">
                                                <div class="text-success"># Connect to Exchange Online PowerShell</div>
                                                <div>Install-Module ExchangeOnlineManagement</div>
                                                <div>Connect-ExchangeOnline</div>
                                                <div class="mt-2 text-success"># Enable SMTP AUTH for your mailbox</div>
                                                <div>Set-CASMailbox -Identity pathary@domain.local -SmtpClientAuthenticationDisabled $false</div>
                                            </div>

                                            <h6 class="text-primary">{{ t('admin_server.azure_step6_title') }}</h6>
                                            <p class="small mb-2">{{ t('admin_server.azure_step6_desc') }}</p>
                                            <div class="bg-dark text-light p-2 rounded" style="font-family: monospace; font-size: 0.85em;">
