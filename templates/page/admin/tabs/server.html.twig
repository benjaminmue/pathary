    async function saveApiSettings() {
        const tmdbApiKey = document.getElementById('tmdbApiKey').value.trim();
        const omdbApiKey = document.getElementById('omdbApiKey').value.trim();

        let savedAny = false;

        // Save TMDB if dirty
        if (tmdbDirty && tmdbApiKey !== '') {
            // Validate format (32 hexadecimal characters)
            if (!/^[a-f0-9]{32}$/i.test(tmdbApiKey)) {
                showToast('Invalid TMDB API key format. Expected 32 hexadecimal characters.', 'danger');
                return;
            }

            try {
                const response = await fetch('{{ applicationUrl }}/api/admin/settings/tmdb', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + localStorage.getItem('authToken'),
                    },
                    body: JSON.stringify({
                        apiKey: tmdbApiKey,
                    }),
                });

                const data = await response.json();

                if (!response.ok) {
                    showToast(data.error || 'Failed to save TMDB API key', 'danger');
                    return;
                }

                // Clear input and update status
                document.getElementById('tmdbApiKey').value = '';
                document.getElementById('tmdbApiKey').type = 'password';
                updateTmdbStatus(true, data.updated_at);
                tmdbDirty = false;
                savedAny = true;
            } catch (error) {
                showToast('Error saving TMDB API key: ' + error.message, 'danger');
                return;
            }
        }

        // Save OMDb if dirty
        if (omdbDirty && omdbApiKey !== '') {
            // Validate format (8 characters)
            if (!/^[a-zA-Z0-9]{8}$/i.test(omdbApiKey)) {
                showToast('Invalid OMDb API key format. Expected 8 alphanumeric characters.', 'danger');
                return;
            }

            try {
                const response = await fetch('{{ applicationUrl }}/api/admin/settings/omdb', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + localStorage.getItem('authToken'),
                    },
                    body: JSON.stringify({
                        apiKey: omdbApiKey,
                    }),
                });

                const data = await response.json();

                if (!response.ok) {
                    showToast(data.error || 'Failed to save OMDb API key', 'danger');
                    return;
                }

                // Clear input and update status
                document.getElementById('omdbApiKey').value = '';
                document.getElementById('omdbApiKey').type = 'password';
                updateOmdbStatus(true, data.updated_at);
                omdbDirty = false;
                savedAny = true;
            } catch (error) {
                showToast('Error saving OMDb API key: ' + error.message, 'danger');
                return;
            }
        }

        if (savedAny) {
            showToast('API settings saved successfully', 'success');
            updateSaveButtonState();
            // Reload health status to update OMDb box visibility
            await loadHealthStatus();
        } else {
            showToast('No changes to save', 'info');
        }
    }

