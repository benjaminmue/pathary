<div class="card admin-card">
    <div class="card-header">
        <i class="bi bi-film me-2"></i>{{ t('admin_movies.title') }}
    </div>
    <div class="card-body">
        <p class="text-muted">
            {{ t('admin_movies.intro') }}
        </p>

        <!-- Movie Search Section -->
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <label for="movieSearch" class="form-label">{{ t('admin_movies.search_movies') }}</label>
                <input type="text"
                       class="form-control"
                       id="movieSearch"
                       placeholder="{{ t('admin_movies.search_placeholder') }}"
                       autocomplete="off">
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="searchMovies()">
                    <i class="bi bi-search me-1"></i>{{ t('admin_movies.search_button') }}
                </button>
            </div>
        </div>

        <!-- Search Results -->
        <div id="movieSearchResults" class="d-none">
            <h6 class="border-bottom pb-2 mb-3">{{ t('admin_movies.search_results') }}</h6>
            <div id="movieResultsList" class="list-group mb-3"></div>
        </div>

        <!-- Selected Movie Details -->
        <div id="movieDetails" class="d-none">
            <h6 class="border-bottom pb-2 mb-3">{{ t('admin_movies.movie_details') }}</h6>

            <div class="row">
                <div class="col-md-3 text-center mb-3">
                    <img id="moviePoster" src="" alt="{{ t('admin_movies.movie_poster_alt') }}" class="img-fluid rounded shadow-sm" style="max-height: 300px;">
                </div>
                <div class="col-md-9">
                    <h4 id="movieTitle" class="mb-2"></h4>
                    <p class="text-muted mb-3">
                        <span id="movieYear"></span> •
                        <span id="movieRuntime"></span> •
                        TMDB ID: <span id="movieTmdbId"></span>
                    </p>

                    <div class="mb-3">
                        <h6>{{ t('admin_movies.synopsis') }}</h6>
                        <p id="movieOverview" class="text-muted small"></p>
                    </div>

                    <div class="mb-3">
                        <h6>{{ t('admin_movies.statistics') }}</h6>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <div class="card bg-body-secondary">
                                    <div class="card-body py-2 px-3">
                                        <div class="small text-muted">{{ t('admin_movies.total_ratings') }}</div>
                                        <div class="h5 mb-0" id="movieRatingCount">-</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-body-secondary">
                                    <div class="card-body py-2 px-3">
                                        <div class="small text-muted">{{ t('admin_movies.watch_dates') }}</div>
                                        <div class="h5 mb-0" id="movieWatchCount">-</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-body-secondary">
                                    <div class="card-body py-2 px-3">
                                        <div class="small text-muted">{{ t('admin_movies.avg_rating') }}</div>
                                        <div class="h5 mb-0" id="movieAvgRating">-</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="btn-group mb-3" role="group">
                        <button class="btn btn-outline-primary" onclick="syncMovieFromTMDB()">
                            <i class="bi bi-arrow-clockwise me-1"></i>{{ t('admin_movies.sync_from_tmdb') }}
                        </button>
                        <button class="btn btn-outline-secondary" onclick="viewMovieRatings()">
                            <i class="bi bi-star me-1"></i>{{ t('admin_movies.view_all_ratings') }}
                        </button>
                        <button class="btn btn-outline-danger" onclick="confirmDeleteMovie()">
                            <i class="bi bi-trash me-1"></i>{{ t('admin_movies.delete_movie') }}
                        </button>
                    </div>
                </div>
            </div>

            <!-- Ratings List -->
            <div id="movieRatingsList" class="d-none mt-4">
                <h6 class="border-bottom pb-2 mb-3">{{ t('admin_movies.user_ratings') }}</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>{{ t('admin_movies.th_user') }}</th>
                                <th>{{ t('admin_movies.th_rating') }}</th>
                                <th>{{ t('admin_movies.th_watched_date') }}</th>
                                <th>{{ t('admin_movies.th_location') }}</th>
                                <th>{{ t('admin_movies.th_actions') }}</th>
                            </tr>
                        </thead>
                        <tbody id="ratingsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Locations Management Section -->
        <div class="mt-5 pt-4 border-top">
            <h6 class="mb-3"><i class="bi bi-pin-map-fill me-2"></i>{{ t('admin_movies.watch_locations') }}</h6>
            <p class="text-muted small mb-3">
                {{ t('admin_movies.watch_locations_intro') }}
            </p>

            <!-- Add New Location Form -->
            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label for="newLocationName" class="form-label">{{ t('admin_movies.location_name') }}</label>
                    <input type="text" class="form-control" id="newLocationName" placeholder="{{ t('admin_movies.location_name_placeholder') }}">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-primary w-100" onclick="createLocation()">
                        <i class="bi bi-plus-circle me-1"></i>{{ t('admin_movies.add_location') }}
                    </button>
                </div>
            </div>

            <!-- Existing Locations List -->
            <div id="locationsList" class="list-group">
                <!-- Populated by loadLocations() -->
            </div>
        </div>

        <!-- Bulk Operations Section -->
        <div class="mt-5 pt-4 border-top">
            <h6 class="mb-3"><i class="bi bi-tools me-2"></i>{{ t('admin_movies.bulk_operations') }}</h6>
            <div class="row g-2">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ t('admin_movies.cleanup_orphaned_posters') }}</h6>
                            <p class="card-text small text-muted">{{ t('admin_movies.cleanup_orphaned_posters_desc') }}</p>
                            <button class="btn btn-sm btn-outline-danger" onclick="cleanupOrphanedPosters()">
                                <i class="bi bi-trash me-1"></i>{{ t('admin_movies.run_cleanup') }}
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-title">{{ t('admin_movies.refresh_all_tmdb') }}</h6>
                            <p class="card-text small text-muted">{{ t('admin_movies.refresh_all_tmdb_desc') }}</p>
                            <button class="btn btn-sm btn-outline-primary" onclick="refreshAllTMDB()">
                                <i class="bi bi-arrow-clockwise me-1"></i>{{ t('admin_movies.queue_job') }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let currentMovieId = null;

    // ========== Location Management Functions ==========

    // Load locations on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadLocations();
    });

    async function loadLocations() {
        try {
            const response = await fetch('{{ applicationUrl }}/old/settings/locations');
            if (!response.ok) {
                throw new Error('Failed to fetch locations');
            }

            const locations = await response.json();
            displayLocations(locations);
        } catch (error) {
            showToast('Error loading locations: ' + error.message, 'danger');
        }
    }

    function displayLocations(locations) {
        const container = document.getElementById('locationsList');
        if (locations.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-3">No locations yet. Add one above to get started.</p>';
            return;
        }

        container.innerHTML = locations.map(location => `
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-pin-map-fill me-2"></i>
                    <strong>${escapeHtml(location.name)}</strong>
                </div>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary btn-edit-location" data-location-id="${location.id}" data-location-name="${escapeHtml(location.name)}">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-outline-danger btn-delete-location" data-location-id="${location.id}" data-location-name="${escapeHtml(location.name)}">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        `).join('');

        // Add event listeners using event delegation
        container.querySelectorAll('.btn-edit-location').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = parseInt(this.dataset.locationId);
                const name = this.dataset.locationName;
                editLocation(id, name);
            });
        });

        container.querySelectorAll('.btn-delete-location').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = parseInt(this.dataset.locationId);
                const name = this.dataset.locationName;
                confirmDeleteLocation(id, name);
            });
        });
    }

    async function createLocation() {
        const name = document.getElementById('newLocationName').value.trim();

        if (!name) {
            showToast('Please enter a location name', 'warning');
            return;
        }

        try {
            const response = await fetch('{{ applicationUrl }}/old/settings/locations', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ name, isCinema: false, _csrf_token: '{{ csrf }}' })
            });

            if (response.ok) {
                showToast('Location created successfully', 'success');
                document.getElementById('newLocationName').value = '';
                await loadLocations();
            } else {
                showToast('Failed to create location', 'danger');
            }
        } catch (error) {
            showToast('Error creating location: ' + error.message, 'danger');
        }
    }

    function editLocation(id, name) {
        // Pre-fill the form with existing values
        document.getElementById('newLocationName').value = name;

        // Create update button to replace add button temporarily
        const addButton = document.querySelector('button[onclick="createLocation()"]');
        const originalHTML = addButton.innerHTML;

        addButton.innerHTML = '<i class="bi bi-check-circle me-1"></i>Update Location';
        addButton.onclick = async function() {
            await updateLocation(id);
            // Restore original button
            addButton.innerHTML = originalHTML;
            addButton.onclick = createLocation;
        };

        // Scroll to form
        document.getElementById('newLocationName').scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('newLocationName').focus();
    }

    async function updateLocation(id) {
        const name = document.getElementById('newLocationName').value.trim();

        if (!name) {
            showToast('Please enter a location name', 'warning');
            return;
        }

        try {
            const response = await fetch(`{{ applicationUrl }}/old/settings/locations/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ name, isCinema: false, _csrf_token: '{{ csrf }}' })
            });

            if (response.ok) {
                showToast('Location updated successfully', 'success');
                document.getElementById('newLocationName').value = '';
                await loadLocations();
            } else {
                showToast('Failed to update location', 'danger');
            }
        } catch (error) {
            showToast('Error updating location: ' + error.message, 'danger');
        }
    }

    function confirmDeleteLocation(id, name) {
        showConfirmModal(
            `Delete location "${name}"? This cannot be undone.`,
            async () => {
                await deleteLocation(id);
            }
        );
    }

    async function deleteLocation(id) {
        try {
            const response = await fetch(`{{ applicationUrl }}/old/settings/locations/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ _csrf_token: '{{ csrf }}' })
            });

            if (response.ok) {
                showToast('Location deleted successfully', 'success');
                await loadLocations();
            } else {
                // Try to get error message from response
                let errorMessage = 'Failed to delete location';
                try {
                    const data = await response.json();
                    if (data.error) {
                        errorMessage = data.error;
                    }
                } catch (e) {
                    // Response wasn't JSON, use default message
                    console.error('Failed to parse error response:', e);
                }

                showToast(errorMessage, response.status === 409 ? 'warning' : 'danger');
            }
        } catch (error) {
            showToast('Error deleting location: ' + error.message, 'danger');
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function escapeJsString(text) {
        // Escape characters that could break out of JavaScript strings
        return text
            .replace(/\\/g, '\\\\')  // Backslash
            .replace(/'/g, "\\'")     // Single quote
            .replace(/"/g, '\\"')     // Double quote
            .replace(/\n/g, '\\n')    // Newline
            .replace(/\r/g, '\\r')    // Carriage return
            .replace(/\t/g, '\\t');   // Tab
    }

    // ========== Movie Management Functions ==========

    async function searchMovies() {
        const query = document.getElementById('movieSearch').value.trim();
        if (!query) {
            showToast('Please enter a search term', 'warning');
            return;
        }

        try {
            // TODO: Implement movie search API endpoint
            showToast('Movie search feature coming soon', 'info');
        } catch (error) {
            showToast('Error searching movies: ' + error.message, 'danger');
        }
    }

    async function syncMovieFromTMDB() {
        if (!currentMovieId) return;

        showConfirmModal('Re-fetch this movie data from TMDB? This will update title, poster, runtime, and other metadata.', async () => {
            try {
                const response = await fetch(`{{ applicationUrl }}/old/movies/${currentMovieId}/refresh-tmdb`, {
                    method: 'GET',
                });

                if (response.ok) {
                    showToast('Movie data synced from TMDB successfully', 'success');
                } else {
                    showToast('Failed to sync movie data', 'danger');
                }
            } catch (error) {
                showToast('Error syncing movie: ' + error.message, 'danger');
            }
        });
    }

    async function viewMovieRatings() {
        if (!currentMovieId) return;

        try {
            // TODO: Implement ratings API endpoint
            document.getElementById('movieRatingsList').classList.remove('d-none');
            showToast('Ratings display feature coming soon', 'info');
        } catch (error) {
            showToast('Error loading ratings: ' + error.message, 'danger');
        }
    }

    async function confirmDeleteMovie() {
        if (!currentMovieId) return;

        const movieTitle = document.getElementById('movieTitle').textContent;

        showConfirmModal(
            `Delete "${movieTitle}" and ALL associated ratings and watch dates? This action cannot be undone.`,
            async () => {
                try {
                    // TODO: Implement movie deletion API endpoint
                    showToast('Movie deletion feature coming soon', 'info');
                } catch (error) {
                    showToast('Error deleting movie: ' + error.message, 'danger');
                }
            }
        );
    }

    async function deleteRating(movieId, userId) {
        showConfirmModal(
            'Delete this rating? This action cannot be undone.',
            async () => {
                try {
                    // TODO: Implement rating deletion API endpoint
                    showToast('Rating deletion feature coming soon', 'info');
                } catch (error) {
                    showToast('Error deleting rating: ' + error.message, 'danger');
                }
            }
        );
    }

    async function cleanupOrphanedPosters() {
        showConfirmModal(
            'Scan and remove poster files for movies that no longer exist in the database?',
            async () => {
                try {
                    showToast('Orphan cleanup feature coming soon', 'info');
                } catch (error) {
                    showToast('Error running cleanup: ' + error.message, 'danger');
                }
            }
        );
    }

    async function refreshAllTMDB() {
        showConfirmModal(
            'Queue a background job to refresh all movie data from TMDB? This may take several minutes.',
            async () => {
                try {
                    showToast('Bulk TMDB refresh feature coming soon', 'info');
                } catch (error) {
                    showToast('Error queuing job: ' + error.message, 'danger');
                }
            }
        );
    }
</script>
