<style>
    /* ===== Scoped styles for the Movies admin tab (uses --pds-* tokens from .pds-root) ===== */
    .pds-movies-stack {
        display: flex;
        flex-direction: column;
        gap: var(--pds-s-lg);
    }

    .pds-search-row {
        display: flex;
        gap: var(--pds-s-md);
        align-items: stretch;
        margin-top: var(--pds-s-md);
    }

    .pds-search-row .pds-input {
        flex: 1;
        min-width: 0;
    }

    /* Add-place row */
    .pds-add-row {
        display: flex;
        gap: var(--pds-s-md);
        align-items: stretch;
        margin-top: var(--pds-s-md);
    }

    .pds-add-row .pds-input {
        flex: 1;
        min-width: 0;
    }

    /* Place list */
    .pds-place-list {
        margin-top: var(--pds-s-md);
    }

    .pds-place-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--pds-s-md);
        padding: 12px 0;
        border-bottom: 1px solid var(--pds-hair);
    }

    .pds-place-row:last-child {
        border-bottom: none;
    }

    .pds-place-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--pds-text);
    }

    .pds-place-actions {
        display: flex;
        align-items: center;
        gap: var(--pds-s-sm);
    }

    .pds-place-count {
        font-family: var(--pds-font-mono);
        font-size: 12px;
        color: var(--pds-dim);
        margin-right: 4px;
    }

    .pds-place-empty {
        color: var(--pds-muted);
        font-size: 13px;
        text-align: center;
        padding: 16px 0;
    }

    /* Small button modifier */
    .pds-btn--sm {
        padding: 6px 12px;
        font-size: 13px;
    }

    /* Danger-on-hover ghost button (neutral until hovered) */
    .pds-btn--danger-hover {
        background: none;
        border-color: var(--pds-border);
        color: var(--pds-muted);
    }

    .pds-btn--danger-hover:hover {
        border-color: var(--pds-danger);
        color: var(--pds-danger);
        background: rgba(192, 57, 43, 0.08);
    }

    /* Two side-by-side cards */
    .pds-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--pds-s-lg);
    }
    .pds-two-col > .pds-admin-card { height: 100%; margin-top: 0; }

    @media (max-width: 768px) {
        .pds-two-col {
            grid-template-columns: 1fr;
        }
        .pds-search-row,
        .pds-add-row {
            flex-direction: column;
        }
    }

    /* Search-results / movie-details sub sections */
    .pds-movies-sub {
        margin-top: var(--pds-s-lg);
        padding-top: var(--pds-s-md);
        border-top: 1px solid var(--pds-hair);
    }

    .pds-movies-sub__title {
        font-size: 13px;
        font-weight: 600;
        color: var(--pds-muted);
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: var(--pds-s-md);
    }

    .pds-stat {
        background: var(--pds-surface-2);
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        padding: 10px 14px;
    }

    .pds-stat__label {
        font-size: 12px;
        color: var(--pds-muted);
    }

    .pds-stat__value {
        font-size: 18px;
        font-weight: 600;
        color: var(--pds-text);
        font-family: var(--pds-font-mono);
    }

    .pds-movie-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--pds-s-sm);
        margin-top: var(--pds-s-md);
    }
</style>

<div class="pds-movies-stack">

    {# ===== Card 1: Filmverwaltung ===== #}
    <div class="pds-admin-card">
        <div class="pds-admin-card__pad">
            <div class="pds-admin-card__title">{{ t('admin_movies.title') }}</div>
            <div class="pds-admin-card__sub">{{ t('admin_movies.intro') }}</div>

            <!-- Movie Search Section -->
            <div class="pds-search-row">
                <input type="text"
                       class="pds-input"
                       id="movieSearch"
                       placeholder="{{ t('admin_movies.search_placeholder') }}"
                       autocomplete="off">
                <button class="pds-btn pds-btn--primary" onclick="searchMovies()">
                    {{ t('admin_movies.search_button') }}
                </button>
            </div>

            <!-- Search Results -->
            <div id="movieSearchResults" class="pds-movies-sub d-none">
                <div class="pds-movies-sub__title">{{ t('admin_movies.search_results') }}</div>
                <div id="movieResultsList" class="list-group mb-3"></div>
            </div>

            <!-- Selected Movie Details -->
            <div id="movieDetails" class="pds-movies-sub d-none">
                <div class="pds-movies-sub__title">{{ t('admin_movies.movie_details') }}</div>

                <div class="row">
                    <div class="col-md-3 text-center mb-3">
                        <img id="moviePoster" src="" alt="{{ t('admin_movies.movie_poster_alt') }}" class="img-fluid rounded shadow-sm" style="max-height: 300px;">
                    </div>
                    <div class="col-md-9">
                        <h4 id="movieTitle" class="mb-2"></h4>
                        <p class="text-muted mb-3">
                            <span id="movieYear"></span> •
                            <span id="movieRuntime"></span> •
                            TMDB ID: <span id="movieTmdbId"></span>
                        </p>

                        <div class="mb-3">
                            <div class="pds-movies-sub__title">{{ t('admin_movies.synopsis') }}</div>
                            <p id="movieOverview" class="text-muted small"></p>
                        </div>

                        <div class="mb-3">
                            <div class="pds-movies-sub__title">{{ t('admin_movies.statistics') }}</div>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <div class="pds-stat">
                                        <div class="pds-stat__label">{{ t('admin_movies.total_ratings') }}</div>
                                        <div class="pds-stat__value" id="movieRatingCount">-</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="pds-stat">
                                        <div class="pds-stat__label">{{ t('admin_movies.watch_dates') }}</div>
                                        <div class="pds-stat__value" id="movieWatchCount">-</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="pds-stat">
                                        <div class="pds-stat__label">{{ t('admin_movies.avg_rating') }}</div>
                                        <div class="pds-stat__value" id="movieAvgRating">-</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="pds-movie-actions">
                            <button class="pds-btn pds-btn--ghost pds-btn--sm" onclick="syncMovieFromTMDB()">
                                {{ t('admin_movies.sync_from_tmdb') }}
                            </button>
                            <button class="pds-btn pds-btn--ghost pds-btn--sm" onclick="viewMovieRatings()">
                                {{ t('admin_movies.view_all_ratings') }}
                            </button>
                            <button class="pds-btn pds-btn--danger pds-btn--sm" onclick="confirmDeleteMovie()">
                                {{ t('admin_movies.delete_movie') }}
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Ratings List -->
                <div id="movieRatingsList" class="d-none mt-4">
                    <div class="pds-movies-sub__title">{{ t('admin_movies.user_ratings') }}</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>{{ t('admin_movies.th_user') }}</th>
                                    <th>{{ t('admin_movies.th_rating') }}</th>
                                    <th>{{ t('admin_movies.th_watched_date') }}</th>
                                    <th>{{ t('admin_movies.th_location') }}</th>
                                    <th>{{ t('admin_movies.th_actions') }}</th>
                                </tr>
                            </thead>
                            <tbody id="ratingsTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ===== Card 2: Sehorte ===== #}
    <div class="pds-admin-card">
        <div class="pds-admin-card__pad">
            <div class="pds-admin-card__title">{{ t('admin_movies.watch_locations') }}</div>
            <div class="pds-admin-card__sub">{{ t('admin_movies.watch_locations_intro') }}</div>

            <!-- Add New Location Form -->
            <div class="pds-add-row">
                <input type="text" class="pds-input" id="newLocationName" placeholder="{{ t('admin_movies.location_name_placeholder') }}">
                <button class="pds-btn pds-btn--ghost" onclick="createLocation()">
                    {{ t('admin_movies.add_location') }}
                </button>
            </div>

            <!-- Existing Locations List -->
            <div id="locationsList" class="pds-place-list">
                <!-- Populated by loadLocations() -->
            </div>
        </div>
    </div>

    {# ===== Cards 3 + 4: Bulk operations, side by side ===== #}
    <div class="pds-two-col">
        <div class="pds-admin-card">
            <div class="pds-admin-card__pad">
                <div class="pds-admin-card__title">{{ t('admin_movies.cleanup_orphaned_posters') }}</div>
                <div class="pds-admin-card__sub">{{ t('admin_movies.cleanup_orphaned_posters_desc') }}</div>
                <div class="pds-movie-actions">
                    <button class="pds-btn pds-btn--danger" onclick="cleanupOrphanedPosters()">
                        {{ t('admin_movies.run_cleanup') }}
                    </button>
                </div>
            </div>
        </div>
        <div class="pds-admin-card">
            <div class="pds-admin-card__pad">
                <div class="pds-admin-card__title">{{ t('admin_movies.refresh_all_tmdb') }}</div>
                <div class="pds-admin-card__sub">{{ t('admin_movies.refresh_all_tmdb_desc') }}</div>
                <div class="pds-movie-actions">
                    <button class="pds-btn pds-btn--ghost" onclick="refreshAllTMDB()">
                        {{ t('admin_movies.queue_job') }}
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    let currentMovieId = null;

    // Localized strings for JS-generated markup
    const MOVIES_I18N = {
        rename: '{{ t('admin.movies.rename')|e('js') }}',
        delete: '{{ t('admin.movies.delete')|e('js') }}',
        noLocations: '{{ t('admin.movies.no_locations')|e('js') }}',
    };

    // ========== Location Management Functions ==========

    // Load locations on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadLocations();
    });

    async function loadLocations() {
        try {
            const response = await fetch('{{ applicationUrl }}/old/settings/locations');
            if (!response.ok) {
                throw new Error('Failed to fetch locations');
            }

            const locations = await response.json();
            displayLocations(locations);
        } catch (error) {
            showToast('Error loading locations: ' + error.message, 'danger');
        }
    }

    function displayLocations(locations) {
        const container = document.getElementById('locationsList');
        if (locations.length === 0) {
            container.innerHTML = `<p class="pds-place-empty">${escapeHtml(MOVIES_I18N.noLocations)}</p>`;
            return;
        }

        container.innerHTML = locations.map(location => {
            const rawCount = (location.usageCount ?? location.usage_count);
            const countHtml = (typeof rawCount === 'number')
                ? `<span class="pds-place-count">${rawCount} Sichtungen</span>`
                : '';
            return `
            <div class="pds-place-row">
                <div class="pds-place-name">${escapeHtml(location.name)}</div>
                <div class="pds-place-actions">
                    ${countHtml}
                    <button class="pds-btn pds-btn--ghost pds-btn--sm btn-edit-location" data-location-id="${location.id}" data-location-name="${escapeHtml(location.name)}">
                        ${escapeHtml(MOVIES_I18N.rename)}
                    </button>
                    <button class="pds-btn pds-btn--danger-hover pds-btn--sm btn-delete-location" data-location-id="${location.id}" data-location-name="${escapeHtml(location.name)}">
                        ${escapeHtml(MOVIES_I18N.delete)}
                    </button>
                </div>
            </div>
        `;
        }).join('');

        // Add event listeners using event delegation
        container.querySelectorAll('.btn-edit-location').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = parseInt(this.dataset.locationId);
                const name = this.dataset.locationName;
                editLocation(id, name);
            });
        });

        container.querySelectorAll('.btn-delete-location').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = parseInt(this.dataset.locationId);
                const name = this.dataset.locationName;
                confirmDeleteLocation(id, name);
            });
        });
    }

    async function createLocation() {
        const name = document.getElementById('newLocationName').value.trim();

        if (!name) {
            showToast('Please enter a location name', 'warning');
            return;
        }

        try {
            const response = await fetch('{{ applicationUrl }}/old/settings/locations', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ name, isCinema: false, _csrf_token: '{{ csrf }}' })
            });

            if (response.ok) {
                showToast('Location created successfully', 'success');
                document.getElementById('newLocationName').value = '';
                await loadLocations();
            } else {
                showToast('Failed to create location', 'danger');
            }
        } catch (error) {
            showToast('Error creating location: ' + error.message, 'danger');
        }
    }

    function editLocation(id, name) {
        // Pre-fill the form with existing values
        document.getElementById('newLocationName').value = name;

        // Create update button to replace add button temporarily
        const addButton = document.querySelector('button[onclick="createLocation()"]');
        const originalHTML = addButton.innerHTML;

        addButton.innerHTML = MOVIES_I18N.rename;
        addButton.onclick = async function() {
            await updateLocation(id);
            // Restore original button
            addButton.innerHTML = originalHTML;
            addButton.onclick = createLocation;
        };

        // Scroll to form
        document.getElementById('newLocationName').scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('newLocationName').focus();
    }

    async function updateLocation(id) {
        const name = document.getElementById('newLocationName').value.trim();

        if (!name) {
            showToast('Please enter a location name', 'warning');
            return;
        }

        try {
            const response = await fetch(`{{ applicationUrl }}/old/settings/locations/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ name, isCinema: false, _csrf_token: '{{ csrf }}' })
            });

            if (response.ok) {
                showToast('Location updated successfully', 'success');
                document.getElementById('newLocationName').value = '';
                await loadLocations();
            } else {
                showToast('Failed to update location', 'danger');
            }
        } catch (error) {
            showToast('Error updating location: ' + error.message, 'danger');
        }
    }

    function confirmDeleteLocation(id, name) {
        showConfirmModal(
            `Delete location "${name}"? This cannot be undone.`,
            async () => {
                await deleteLocation(id);
            }
        );
    }

    async function deleteLocation(id) {
        try {
            const response = await fetch(`{{ applicationUrl }}/old/settings/locations/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ _csrf_token: '{{ csrf }}' })
            });

            if (response.ok) {
                showToast('Location deleted successfully', 'success');
                await loadLocations();
            } else {
                // Try to get error message from response
                let errorMessage = 'Failed to delete location';
                try {
                    const data = await response.json();
                    if (data.error) {
                        errorMessage = data.error;
                    }
                } catch (e) {
                    // Response wasn't JSON, use default message
                    console.error('Failed to parse error response:', e);
                }

                showToast(errorMessage, response.status === 409 ? 'warning' : 'danger');
            }
        } catch (error) {
            showToast('Error deleting location: ' + error.message, 'danger');
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function escapeJsString(text) {
        // Escape characters that could break out of JavaScript strings
        return text
            .replace(/\\/g, '\\\\')  // Backslash
            .replace(/'/g, "\\'")     // Single quote
            .replace(/"/g, '\\"')     // Double quote
            .replace(/\n/g, '\\n')    // Newline
            .replace(/\r/g, '\\r')    // Carriage return
            .replace(/\t/g, '\\t');   // Tab
    }

    // ========== Movie Management Functions ==========

    async function searchMovies() {
        const query = document.getElementById('movieSearch').value.trim();
        if (!query) {
            showToast('Please enter a search term', 'warning');
            return;
        }

        try {
            // TODO: Implement movie search API endpoint
            showToast('Movie search feature coming soon', 'info');
        } catch (error) {
            showToast('Error searching movies: ' + error.message, 'danger');
        }
    }

    async function syncMovieFromTMDB() {
        if (!currentMovieId) return;

        showConfirmModal('Re-fetch this movie data from TMDB? This will update title, poster, runtime, and other metadata.', async () => {
            try {
                const response = await fetch(`{{ applicationUrl }}/old/movies/${currentMovieId}/refresh-tmdb`, {
                    method: 'GET',
                });

                if (response.ok) {
                    showToast('Movie data synced from TMDB successfully', 'success');
                } else {
                    showToast('Failed to sync movie data', 'danger');
                }
            } catch (error) {
                showToast('Error syncing movie: ' + error.message, 'danger');
            }
        });
    }

    async function viewMovieRatings() {
        if (!currentMovieId) return;

        try {
            // TODO: Implement ratings API endpoint
            document.getElementById('movieRatingsList').classList.remove('d-none');
            showToast('Ratings display feature coming soon', 'info');
        } catch (error) {
            showToast('Error loading ratings: ' + error.message, 'danger');
        }
    }

    async function confirmDeleteMovie() {
        if (!currentMovieId) return;

        const movieTitle = document.getElementById('movieTitle').textContent;

        showConfirmModal(
            `Delete "${movieTitle}" and ALL associated ratings and watch dates? This action cannot be undone.`,
            async () => {
                try {
                    // TODO: Implement movie deletion API endpoint
                    showToast('Movie deletion feature coming soon', 'info');
                } catch (error) {
                    showToast('Error deleting movie: ' + error.message, 'danger');
                }
            }
        );
    }

    async function deleteRating(movieId, userId) {
        showConfirmModal(
            'Delete this rating? This action cannot be undone.',
            async () => {
                try {
                    // TODO: Implement rating deletion API endpoint
                    showToast('Rating deletion feature coming soon', 'info');
                } catch (error) {
                    showToast('Error deleting rating: ' + error.message, 'danger');
                }
            }
        );
    }

    async function cleanupOrphanedPosters() {
        showConfirmModal(
            'Scan and remove poster files for movies that no longer exist in the database?',
            async () => {
                try {
                    showToast('Orphan cleanup feature coming soon', 'info');
                } catch (error) {
                    showToast('Error running cleanup: ' + error.message, 'danger');
                }
            }
        );
    }

    async function refreshAllTMDB() {
        showConfirmModal(
            'Queue a background job to refresh all movie data from TMDB? This may take several minutes.',
            async () => {
                try {
                    showToast('Bulk TMDB refresh feature coming soon', 'info');
                } catch (error) {
                    showToast('Error queuing job: ' + error.message, 'danger');
                }
            }
        );
    }
</script>
