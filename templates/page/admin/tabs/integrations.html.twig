<style>
    /* ===== Integrations tab (scoped) ===== */
    .pint-intro {
        font-size: 13px;
        color: var(--pds-muted);
        line-height: 1.6;
        margin: 0 0 20px;
    }

    .pint-intro a {
        color: var(--pds-gold);
        text-decoration: none;
        font-weight: 600;
    }

    .pint-intro a:hover {
        text-decoration: underline;
    }

    .pint-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @media (max-width: 768px) {
        .pint-grid {
            grid-template-columns: 1fr;
        }
    }

    .pint-card {
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .pint-head {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pint-tile {
        flex-shrink: 0;
        width: 44px;
        height: 44px;
        border-radius: var(--pds-r-sm);
        background: var(--pds-surface-2);
        border: 1px solid var(--pds-hair);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--pds-font-mono);
        font-size: 16px;
        font-weight: 700;
        color: var(--pds-gold);
    }

    .pint-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

    .pint-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--pds-text);
        line-height: 1.2;
    }

    .pint-pill {
        align-self: flex-start;
        font-family: var(--pds-font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 999px;
        line-height: 1.4;
    }

    .pint-pill--available {
        color: var(--pds-muted);
        border: 1px solid var(--pds-border);
        background: transparent;
    }

    .pint-pill--limited {
        color: #15171B;
        background: var(--pds-gold);
        border: 1px solid var(--pds-gold);
    }

    .pint-desc {
        font-size: 13px;
        color: var(--pds-muted);
        line-height: 1.5;
        margin: 0;
        flex: 1;
    }

    .pint-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .pint-doc {
        font-size: 13px;
        color: var(--pds-dim);
        text-decoration: none;
        white-space: nowrap;
    }

    .pint-doc:hover {
        color: var(--pds-gold);
    }

    .pint-help {
        margin-top: 24px;
        padding: 16px 20px;
        border: 1px solid var(--pds-border);
        border-radius: var(--pds-r-sm);
        background: var(--pds-surface-2);
    }

    .pint-help__title {
        font-size: 13px;
        font-weight: 700;
        color: var(--pds-text);
        margin: 0 0 4px;
    }

    .pint-help__text {
        font-size: 13px;
        color: var(--pds-muted);
        line-height: 1.5;
        margin: 0;
    }

    .pint-help__text a {
        color: var(--pds-gold);
        text-decoration: none;
        font-weight: 600;
    }

    .pint-help__text a:hover {
        text-decoration: underline;
    }
</style>

{% set integrations = [
    { name: 'Plex',       initials: 'PL', desc: 'admin_integrations.plex_desc',       path: 'plex',       docs: 'https://docs.pathary.tv/features/plex/',                                status: 'available' },
    { name: 'Jellyfin',   initials: 'JF', desc: 'admin_integrations.jellyfin_desc',   path: 'jellyfin',   docs: 'https://docs.pathary.tv/features/jellyfin/',                            status: 'available' },
    { name: 'Trakt.tv',   initials: 'TR', desc: 'admin_integrations.trakt_desc',      path: 'trakt',      docs: 'https://docs.pathary.tv/features/trakt/',                               status: 'available' },
    { name: 'Letterboxd', initials: 'LB', desc: 'admin_integrations.letterboxd_desc', path: 'letterboxd', docs: 'https://docs.pathary.tv/features/letterboxd/',                          status: 'available' },
    { name: 'Mastodon',   initials: 'MA', desc: 'admin_integrations.mastodon_desc',   path: 'mastodon',   docs: 'https://docs.pathary.tv/',                                              status: 'available' },
    { name: 'Kodi',       initials: 'KO', desc: 'admin_integrations.kodi_desc',       path: 'kodi',       docs: 'https://docs.pathary.tv/features/kodi/',                                status: 'available' },
    { name: 'Netflix',    initials: 'NF', desc: 'admin_integrations.netflix_desc',    path: 'netflix',    docs: 'https://github.com/benjaminmue/pathary/wiki/Integrations-Netflix',      status: 'limited' },
    { name: 'Radarr',     initials: 'RA', desc: 'admin_integrations.radarr_desc',     path: 'radarr',     docs: 'https://github.com/benjaminmue/pathary/wiki/Integrations-Radarr',       status: 'available' },
] %}

<div class="pds-admin-card">
    <div class="pds-admin-card__pad">
        <p class="pint-intro">
            {{ t('admin_integrations.intro_lead') }}
            <a href="https://github.com/benjaminmue/pathary/wiki" target="_blank" rel="noopener">{{ t('admin_integrations.wiki') }}</a>.
        </p>

        <div class="pint-grid">
            {% for integration in integrations %}
                <div class="pds-admin-card pint-card">
                    <div class="pint-head">
                        <div class="pint-tile">{{ integration.initials }}</div>
                        <div class="pint-meta">
                            <span class="pint-name">{{ integration.name }}</span>
                            {% if integration.status == 'limited' %}
                                <span class="pint-pill pint-pill--limited">{{ t('admin_integrations.status_limited') }}</span>
                            {% else %}
                                <span class="pint-pill pint-pill--available">{{ t('admin_integrations.status_available') }}</span>
                            {% endif %}
                        </div>
                    </div>

                    <p class="pint-desc">{{ t(integration.desc) }}</p>

                    <div class="pint-actions">
                        <a href="{{ applicationUrl }}/old/settings/integrations/{{ integration.path }}" class="pds-btn pds-btn--ghost">
                            {{ t('admin_integrations.configure') }}
                        </a>
                        <a href="{{ integration.docs }}" target="_blank" rel="noopener" class="pint-doc">
                            {{ t('admin_integrations.docs') }} &rarr;
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="pint-help">
            <p class="pint-help__title">{{ t('admin_integrations.need_help') }}</p>
            <p class="pint-help__text">
                {{ t('admin_integrations.help_text_part1') }}
                <a href="https://github.com/benjaminmue/pathary/wiki" target="_blank" rel="noopener">Pathary Wiki</a>.
                {{ t('admin_integrations.help_text_part2') }}
                <a href="https://github.com/benjaminmue/pathary/issues" target="_blank" rel="noopener">GitHub Issues</a>.
            </p>
        </div>
    </div>
</div>
