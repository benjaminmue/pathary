{% extends 'layouts/app_base.twig' %}

{% block title %}{{ t('admin.panel_title') }}{% endblock %}

{% block stylesheets %}
    <style>
        /* ===== Admin design system tokens (--pds-*), scoped to .pds-root =====
           Default block = dark (app default). Light overrides below via [data-bs-theme].
           Values shared verbatim with profile/all_movies/movie_detail/search/faq. */
        .pds-root {
            --pds-gold: #FBBC09;
            --pds-bg: #15171B;
            --pds-surface: #1C1F24;
            --pds-surface-2: #22262C;
            --pds-border: #2A2E35;
            --pds-hair: rgba(255, 255, 255, .06);
            --pds-text: #F2F3F5;
            --pds-muted: #A9B0BA;
            --pds-dim: #7A828C;
            --pds-nav: #101216;
            --pds-danger: #C0392B;
            --pds-success: #4CAF6E;
            --pds-r: 14px;
            --pds-r-sm: 8px;
            --pds-s-xs: 4px;
            --pds-s-sm: 8px;
            --pds-s-md: 16px;
            --pds-s-lg: 24px;
            --pds-s-xl: 40px;
            --pds-font: "Geist", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            --pds-font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        }

        [data-bs-theme="light"] .pds-root {
            --pds-bg: #FFFFFF;
            --pds-surface: #FBFBFC;
            --pds-surface-2: #F5F6F8;
            --pds-border: #E3E6EA;
            --pds-hair: #EEF0F3;
            --pds-text: #15171B;
            --pds-muted: #5B636E;
            --pds-dim: #8A9099;
            --pds-danger: #C0392B;
            --pds-success: #198754;
        }

        .pds-root {
            color: var(--pds-text);
            font-family: var(--pds-font);
        }

        .pds-admin {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 32px 24px 56px;
            box-sizing: border-box;
        }

        .pds-admin-head {
            margin-bottom: 18px;
        }

        .pds-admin-head h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .pds-admin-head p {
            font-size: 14px;
            color: var(--pds-muted);
            margin: 4px 0 0;
        }

        /* Tab bar */
        .pds-admin-tabs {
            display: flex;
            gap: var(--pds-s-lg);
            border-bottom: 1px solid var(--pds-border);
            margin-bottom: 22px;
            overflow-x: auto;
        }

        .pds-admin-tab {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: var(--pds-font);
            font-size: 14px;
            font-weight: 500;
            color: var(--pds-muted);
            text-decoration: none;
            white-space: nowrap;
            padding: 10px 2px 12px;
            margin-bottom: -1px;
            border-bottom: 2px solid transparent;
            transition: color .15s ease, border-color .15s ease;
        }

        .pds-admin-tab:hover {
            color: var(--pds-text);
        }

        .pds-admin-tab.active {
            font-weight: 600;
            color: var(--pds-text);
            border-bottom-color: var(--pds-gold);
        }

        /* Shared admin building blocks used by the tab templates */
        .pds-admin-card {
            background: var(--pds-surface);
            border: 1px solid var(--pds-border);
            border-radius: var(--pds-r);
            overflow: hidden;
        }

        .pds-admin-card + .pds-admin-card {
            margin-top: var(--pds-s-md);
        }

        .pds-admin-card__pad {
            padding: 15px 20px;
        }

        .pds-admin-card__title {
            font-size: 15px;
            font-weight: 600;
        }

        .pds-admin-card__sub {
            font-size: 13px;
            color: var(--pds-muted);
            margin-top: 2px;
        }

        .pds-input {
            font-family: var(--pds-font);
            font-size: 14px;
            color: var(--pds-text);
            background: var(--pds-bg);
            border: 1px solid var(--pds-border);
            border-radius: var(--pds-r-sm);
            padding: 10px 14px;
            outline: none;
            transition: border-color .15s ease;
        }

        .pds-input:focus {
            border-color: var(--pds-gold);
        }

        .pds-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-family: var(--pds-font);
            font-size: 14px;
            font-weight: 600;
            border-radius: var(--pds-r-sm);
            padding: 9px 18px;
            cursor: pointer;
            border: 1px solid transparent;
            transition: filter .15s ease, border-color .15s ease, color .15s ease, background .15s ease;
        }

        .pds-btn--primary {
            background: var(--pds-gold);
            border-color: var(--pds-gold);
            color: #12140F;
        }

        .pds-btn--primary:hover {
            filter: brightness(1.06);
        }

        .pds-btn--ghost {
            background: none;
            border-color: var(--pds-border);
            color: var(--pds-muted);
        }

        .pds-btn--ghost:hover {
            border-color: var(--pds-gold);
            color: var(--pds-gold);
        }

        .pds-btn--danger {
            background: none;
            border-color: var(--pds-danger);
            color: var(--pds-danger);
        }

        .pds-btn--danger:hover {
            background: rgba(192, 57, 43, 0.08);
        }

        @media (max-width: 768px) {
            .pds-admin {
                padding: 28px 16px 56px;
            }
        }

        .pds-btn--danger-solid { background: var(--pds-danger); border-color: var(--pds-danger); color: #fff; }
        .pds-btn--danger-solid:hover { filter: brightness(1.08); }

        .pds-confirm .modal-content { background: var(--pds-surface); border: 1px solid var(--pds-border); border-radius: var(--pds-r); color: var(--pds-text); }
        .pds-confirm .modal-header { border-bottom: 1px solid var(--pds-hair); padding: 18px 22px; }
        .pds-confirm .modal-title { font-size: 15px; font-weight: 600; color: var(--pds-text); }
        .pds-confirm .modal-body { padding: 20px 22px; color: var(--pds-muted); font-size: 14px; line-height: 1.5; }
        .pds-confirm .modal-footer { border-top: 1px solid var(--pds-hair); padding: 14px 22px; gap: var(--pds-s-sm); }
        .pds-confirm .btn-close { filter: invert(0.6); opacity: 0.7; }
        :root[data-theme="light"] .pds-confirm .btn-close { filter: none; }
    </style>
{% endblock %}

{% block body %}
    <div class="pds-root" style="background: var(--pds-bg); min-height: 100%;">
        <main class="pds-admin">
            <div class="pds-admin-head">
                <h1>{{ t('admin.title_short') }}</h1>
                <p>{{ t('admin.panel_subtitle') }}</p>
            </div>

            <div class="pds-admin-tabs" role="tablist">
                {% for tab in tabs %}
                    <a class="pds-admin-tab {% if activeTab == tab.id %}active{% endif %}"
                       href="{{ applicationUrl }}{{ tab.route }}"
                       aria-current="{% if activeTab == tab.id %}page{% endif %}">
                        <span>{{ t(tab.label) }}</span>
                    </a>
                {% endfor %}
            </div>

            <div class="tab-content">
                {% if activeTab == 'movies' %}
                    {% include 'page/admin/tabs/movies.html.twig' %}
                {% elseif activeTab == 'users' %}
                    {% include 'page/admin/tabs/users.html.twig' %}
                {% elseif activeTab == 'server' %}
                    {% include 'page/admin/tabs/server.html.twig' %}
                {% elseif activeTab == 'integrations' %}
                    {% include 'page/admin/tabs/integrations.html.twig' %}
                {% elseif activeTab == 'events' %}
                    {% include 'page/admin/tabs/events.html.twig' %}
                {% endif %}
            </div>
        </main>
    </div>

    <!-- Confirmation Modal Template -->
    <div class="modal fade pds-root pds-confirm" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">{{ t('admin.confirm_action') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ t('admin.close') }}"></button>
                </div>
                <div class="modal-body" id="confirmModalBody">
                    {{ t('admin.confirm_default_message') }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="pds-btn pds-btn--ghost" data-bs-dismiss="modal">{{ t('admin.cancel') }}</button>
                    <button type="button" class="pds-btn pds-btn--danger-solid" id="confirmModalAction">{{ t('admin.confirm') }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        // Confirmation modal helper
        function showConfirmModal(message, onConfirm) {
            const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            document.getElementById('confirmModalBody').textContent = message;

            const confirmBtn = document.getElementById('confirmModalAction');
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);

            newConfirmBtn.addEventListener('click', function() {
                modal.hide();
                onConfirm();
            });

            modal.show();
        }

        // CSRF token helper
        function getCsrfToken() {
            const csrfMeta = document.querySelector('meta[name="csrf-token"]');
            return csrfMeta ? csrfMeta.getAttribute('content') : '';
        }

        // Success/error toast notifications
        function showToast(message, type = 'success') {
            const toastContainer = document.getElementById('toastContainer') || createToastContainer();
            const toastId = 'toast-' + Date.now();

            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-white bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;

            toastContainer.insertAdjacentHTML('beforeend', toastHtml);
            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement, { delay: 3000 });
            toast.show();

            toastElement.addEventListener('hidden.bs.toast', () => toastElement.remove());
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
            return container;
        }
    </script>
{% endblock %}
