{% extends 'base.html.twig' %}

{% set showFooter = false %}

{% block title %}
    {{ t('wizard.page_title') }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ applicationUrl }}/css/login.css">
    <style>
        /* Override login.css body centering to allow scrolling */
        body {
            justify-content: flex-start !important;
            padding: 2rem 0 !important;
            overflow-y: auto !important;
        }
        body > .flex-grow-1 {
            align-items: flex-start !important;
            padding-top: 2rem;
        }
        .step-indicator {
            display: flex;
            justify-content: center;
            margin-bottom: 2rem;
            padding: 0;
            list-style: none;
        }
        .step-indicator li {
            flex: 1;
            text-align: center;
            position: relative;
            font-size: 0.875rem;
        }
        .step-indicator li:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 15px;
            left: 50%;
            width: 100%;
            height: 2px;
            background: var(--bs-secondary);
            z-index: -1;
        }
        .step-indicator li.active:not(:last-child)::after,
        .step-indicator li.completed:not(:last-child)::after {
            background: var(--bs-primary);
        }
        .step-circle {
            width: 30px;
            height: 30px;
            line-height: 30px;
            border-radius: 50%;
            background: var(--bs-secondary);
            color: white;
            display: inline-block;
            margin-bottom: 0.5rem;
        }
        .step-indicator li.active .step-circle {
            background: var(--bs-primary);
        }
        .step-indicator li.completed .step-circle {
            background: var(--bs-success);
        }
        .wizard-step {
            display: none;
        }
        .wizard-step.active {
            display: block;
        }
        .password-requirements {
            font-size: 0.875rem;
            margin-top: 0.5rem;
        }
        .password-requirements li {
            color: var(--bs-secondary);
        }
        .password-requirements li.valid {
            color: var(--bs-success);
        }
        .recovery-codes-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
            margin: 1rem 0;
        }
        .recovery-code {
            font-family: monospace;
            font-size: 1.1rem;
            padding: 0.5rem;
            background: #ffc107;
            color: #000000;
            border: 1px solid #e0a800;
            border-radius: 4px;
            text-align: center;
            font-weight: 500;
        }
        .qr-code-container {
            text-align: center;
            margin: 1.5rem 0;
        }
        #qrcode {
            display: inline-block;
            padding: 1rem;
            background: white;
            border-radius: 8px;
        }
        /* Fix logo positioning */
        .login-logo-wrapper {
            margin-bottom: 2rem;
        }
        /* Secret copy button */
        .secret-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-top: 0.5rem;
        }
        .secret-code-box {
            background: rgba(255, 255, 255, 0.1);
            padding: 0.75rem 1rem;
            border-radius: 6px;
            border: 1px solid var(--bs-border-color);
            max-width: 100%;
            word-break: break-all;
        }
        .copy-secret-btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }
        /* Popcorn Background Animation (Snowflake-style) */
        .popcorn-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            overflow: hidden;
            z-index: 0;
        }

        /* Each popcorn particle */
        .popcorn {
            position: absolute;
            top: -50px;
            user-select: none;
            pointer-events: none;
            animation: fall linear infinite, sway ease-in-out infinite;
            will-change: transform;
        }

        @keyframes fall {
            0% {
                transform: translateY(-100px);
            }
            100% {
                transform: translateY(calc(100vh + 100px));
            }
        }

        @keyframes sway {
            0%, 100% {
                margin-left: 0;
            }
            25% {
                margin-left: 25px;
            }
            75% {
                margin-left: -25px;
            }
        }

        /* Respect reduced motion preference */
        @media (prefers-reduced-motion: reduce) {
            .popcorn {
                animation: none !important;
                display: none;
            }

            .popcorn-bg::before {
                content: '🍿';
                position: absolute;
                top: 20%;
                left: 15%;
                font-size: 24px;
                opacity: 0.08;
                filter: blur(2px);
            }

            .popcorn-bg::after {
                content: '🍿';
                position: absolute;
                bottom: 25%;
                right: 20%;
                font-size: 28px;
                opacity: 0.06;
                filter: blur(3px);
            }
        }
    </style>
{% endblock %}

{% block scripts %}
    <script src="{{ applicationUrl }}/js/init-wizard-bg.js"></script>
    <script src="{{ applicationUrl }}/js/qrcode.min.js"></script>
    <script src="{{ applicationUrl }}/js/init-wizard.js"></script>
{% endblock %}

{% block body %}
    <div class="login-container">
        <!-- Centered Logo -->
        <div class="login-logo-wrapper">
            <div class="login-logo-circle">
                <div class="login-logo-container">
                    <img src="{{ applicationUrl }}/images/pathary-logo.svg"
                         alt="{{ applicationName ?? 'Pathary' }} logo"
                         class="login-logo">
                </div>
            </div>
        </div>

        <!-- Setup Card -->
        <div class="login-card">
            <h1 class="text-center mb-4">{{ t('wizard.welcome') }} {{ applicationName ?? 'Pathary' }}</h1>

            <!-- Step Indicator -->
            <ul class="step-indicator">
                <li id="step-indicator-1" class="active">
                    <span class="step-circle">1</span>
                    <div>{{ t('wizard.step_account') }}</div>
                </li>
                <li id="step-indicator-2">
                    <span class="step-circle">2</span>
                    <div>{{ t('wizard.step_2fa') }}</div>
                </li>
                <li id="step-indicator-3">
                    <span class="step-circle">3</span>
                    <div>{{ t('wizard.step_recovery') }}</div>
                </li>
                <li id="step-indicator-4">
                    <span class="step-circle">4</span>
                    <div>{{ t('wizard.step_complete') }}</div>
                </li>
            </ul>

            <div id="wizardErrors" class="alert alert-danger d-none" role="alert"></div>
            <div id="wizardSuccess" class="alert alert-success d-none" role="alert"></div>

            <!-- Step 1: Create Admin Account -->
            <div id="step-1" class="wizard-step active">
                <p class="text-center text-muted mb-4">
                    {{ t('wizard.create_admin_intro') }} {{ applicationName ?? 'Pathary' }} {{ t('wizard.create_admin_intro_after') }}
                </p>

                <div class="form-floating mb-3">
                    <input type="email"
                           class="form-control"
                           id="email"
                           placeholder="name@example.com"
                           autocomplete="email"
                           required>
                    <label for="email">{{ t('wizard.email_label') }}</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text"
                           class="form-control"
                           id="name"
                           placeholder="{{ t('wizard.name_placeholder') }}"
                           autocomplete="name"
                           required>
                    <label for="name">{{ t('wizard.name_label') }}</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="password"
                           class="form-control"
                           id="password"
                           placeholder="{{ t('wizard.password') }}"
                           autocomplete="new-password"
                           oninput="validatePassword(); checkPasswordMatch();"
                           required>
                    <label for="password">{{ t('wizard.password') }}</label>
                </div>

                <div class="password-requirements">
                    <ul class="list-unstyled">
                        <li id="req-length"><i class="bi bi-circle"></i> {{ t('wizard.req_length') }}</li>
                        <li id="req-uppercase"><i class="bi bi-circle"></i> {{ t('wizard.req_uppercase') }}</li>
                        <li id="req-lowercase"><i class="bi bi-circle"></i> {{ t('wizard.req_lowercase') }}</li>
                        <li id="req-number"><i class="bi bi-circle"></i> {{ t('wizard.req_number') }}</li>
                        <li id="req-special"><i class="bi bi-circle"></i> {{ t('wizard.req_special') }}</li>
                    </ul>
                </div>

                <div class="form-floating mb-3">
                    <input type="password"
                           class="form-control"
                           id="passwordConfirmation"
                           placeholder="{{ t('wizard.confirm_password') }}"
                           autocomplete="new-password"
                           oninput="checkPasswordMatch()"
                           required>
                    <label for="passwordConfirmation">{{ t('wizard.confirm_password') }}</label>
                </div>

                <button class="w-100 btn btn-lg btn-primary" type="button" onclick="createAccount()">
                    {{ t('wizard.continue') }}
                </button>
            </div>

            <!-- Step 2: Setup Two-Factor Authentication -->
            <div id="step-2" class="wizard-step">
                <p class="text-center text-muted mb-4">
                    {{ t('wizard.scan_qr') }}
                </p>

                <div class="qr-code-container">
                    <div id="qrcode"></div>
                    <p class="text-muted small mt-3">{{ t('wizard.enter_secret_manual') }}</p>
                    <div class="secret-container">
                        <div class="secret-code-box">
                            <p class="font-monospace text-break mb-0" id="totpSecret"></p>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary copy-secret-btn" onclick="copySecret()">
                            <i class="bi bi-clipboard"></i> {{ t('wizard.copy') }}
                        </button>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input type="text"
                           class="form-control form-control-lg"
                           id="totpCode"
                           placeholder="000000"
                           maxlength="6"
                           autocomplete="one-time-code"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                           required>
                    <label for="totpCode">{{ t('wizard.enter_code') }}</label>
                </div>

                <button class="w-100 btn btn-lg btn-primary" type="button" onclick="verifyTotp()">
                    {{ t('wizard.verify_continue') }}
                </button>
            </div>

            <!-- Step 3: Recovery Codes -->
            <div id="step-3" class="wizard-step">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>{{ t('wizard.important') }}</strong> {{ t('wizard.save_codes_hint') }}
                </div>

                <p class="text-center mb-3">{{ t('wizard.recovery_codes_intro') }}</p>

                <div class="recovery-codes-grid" id="recoveryCodesGrid"></div>

                <div class="d-flex justify-content-center mb-3">
                    <button class="btn btn-outline-primary" type="button" onclick="copyRecoveryCodes()">
                        <i class="bi bi-clipboard"></i> {{ t('wizard.copy_all_codes') }}
                    </button>
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox"
                           class="form-check-input"
                           id="acknowledgeBackup"
                           required>
                    <label class="form-check-label" for="acknowledgeBackup">
                        {{ t('wizard.acknowledge_backup') }}
                    </label>
                </div>

                <button class="w-100 btn btn-lg btn-primary" type="button" onclick="completeSetup()" id="completeSetupBtn" disabled>
                    {{ t('wizard.complete_setup') }}
                </button>
            </div>

            <!-- Step 4: Success -->
            <div id="step-4" class="wizard-step">
                <div class="text-center">
                    <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                    <h2 class="mt-3">{{ t('wizard.setup_complete') }}</h2>
                    <p class="text-muted mb-4">
                        {{ t('wizard.instance_ready_before') }} {{ applicationName ?? 'Pathary' }} {{ t('wizard.instance_ready_after') }}
                    </p>
                    <p class="mb-4">
                        {{ t('wizard.login_hint') }}
                    </p>
                    <a href="/login" class="btn btn-lg btn-primary">
                        {{ t('wizard.go_to_login') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
